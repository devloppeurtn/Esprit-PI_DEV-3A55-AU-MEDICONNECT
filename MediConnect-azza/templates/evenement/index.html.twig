{% extends 'base.html.twig' %}

{% block title %}Événements - MediConnect{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-2">Événements à venir</h1>
            <p class="text-muted">Découvrez les prochains événements et inscrivez-vous</p>
        </div>
        <div>
            {% if is_granted('ROLE_ORGANISATEUR') %}
                <a href="{{ path('app_evenement_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Créer un événement
                </a>
            {% endif %}
        </div>
    </div>

    <div id="alerts"></div>

    <div id="items-list">
        {% for item in items %}
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-3">{{ item.title }}</h5>
                            
                            {% if item.eventDate %}
                                <div class="mb-3">
                                    <span class="badge bg-info" style="font-size: 0.95rem;">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        {{ item.eventDate|date('d-m-Y') }}
                                    </span>
                                </div>
                            {% endif %}

                            {% if item.content %}
                                <p class="card-text text-muted">{{ (item.content|length > 150) ? item.content|slice(0, 150) ~ '...' : item.content }}</p>
                            {% endif %}

                            <small class="text-muted">
                                <i class="bi bi-clock"></i> Créé le {{ item.createdAt|date('d/m/Y à H:i') }}
                            </small>
                        </div>

                        <div class="col-md-4 d-flex flex-column justify-content-center">
                            <a href="{{ path('app_evenement_show', {id: item.id}) }}" class="btn btn-success btn-lg mb-2">
                                <i class="bi bi-check-circle me-1"></i> Participer
                            </a>
                            
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="{{ path('app_evenement_show', {id: item.id}) }}" class="btn btn-outline-primary">
                                    <i class="bi bi-eye"></i> Détails
                                </a>
                                {% if is_granted('ROLE_ORGANISATEUR') %}
                                    <a href="{{ path('app_evenement_edit', {id: item.id}) }}" class="btn btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                    <form method="POST" action="{{ path('app_evenement_delete', {id: item.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Aucun événement pour le moment.</strong>
                {% if is_granted('ROLE_ORGANISATEUR') %}
                    <a href="{{ path('app_evenement_new') }}" class="alert-link">Créez un nouvel événement</a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>

<!-- Modal for participation -->
<div class="modal fade" id="participateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-clipboard-check me-2"></i>Inscrivez-vous à l'événement
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="participateForm" method="post" action="">
                <div class="modal-body">
                    <p class="text-muted mb-4">Veuillez remplir vos informations ci-dessous :</p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Prénom</label>
                        <input type="text" id="firstName" name="firstName" class="form-control form-control-lg" placeholder="Ex: Jean" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nom</label>
                        <input type="text" id="lastName" name="lastName" class="form-control form-control-lg" placeholder="Ex: Dupont" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" id="email" name="email" class="form-control form-control-lg" placeholder="Ex: jean.dupont@email.com" required>
                    </div>
                    
                    <input type="hidden" id="csrf_token" name="_token" value="">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-check me-1"></i>Confirmer l'inscription
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{% block scripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const participateModal = document.getElementById('participateModal');
            const participateForm = document.getElementById('participateForm');
            
            if (!participateModal || !participateForm) return;

            // When modal is shown, set up the form action and clear fields
            participateModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const eventId = button.getAttribute('data-event-id');

                // Set form action to the participation endpoint
                participateForm.action = "{{ path('app_evenement_participer', {id: '__ID__'}) }}".replace('__ID__', eventId);
                
                // Set CSRF token
                const csrfTokenElement = document.getElementById('csrf_token');
                if (csrfTokenElement && button.hasAttribute('data-csrf')) {
                    csrfTokenElement.value = button.getAttribute('data-csrf');
                }
                
                // Clear form fields
                document.getElementById('firstName').value = '';
                document.getElementById('lastName').value = '';
                document.getElementById('email').value = '';
            });

            // Handle form submission
            participateForm.addEventListener('submit', function (e) {
                e.preventDefault();
                
                const firstName = document.getElementById('firstName').value.trim();
                const lastName = document.getElementById('lastName').value.trim();
                const email = document.getElementById('email').value.trim();

                if (!firstName || !lastName || !email) {
                    alert('Veuillez remplir tous les champs.');
                    return;
                }

                // Submit the form
                participateForm.submit();
            });
        });
    </script>
{% endblock %}

{% endblock %}
