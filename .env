###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Brevo SMTP - Utilisez .env.local pour vos clés (non versionné)
# Format: smtp://LOGIN:CLE_SMTP@smtp-relay.brevo.com:587
MAILER_DSN=smtp://your-login:your-smtp-key@smtp-relay.brevo.com:587

# Adresse d'expédition : expéditeur vérifié dans Brevo
MAILER_FROM="MediConnect <your-email@example.com>"
###< symfony/mailer ###

###> ngrok ###
# URL publique pour les liens dans les emails (mot de passe oublié, etc.)
# Utilisée pour que le lien de reset fonctionne sur ton téléphone
APP_URL=http://localhost:8000
###< ngrok ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# URL du hub Mercure (pour publier) - avec Docker: http://127.0.0.1:1337/.well-known/mercure
MERCURE_URL=http://127.0.0.1:1337/.well-known/mercure
# URL publique du hub (pour le navigateur) - même domaine ou URL accessible
MERCURE_PUBLIC_URL=http://127.0.0.1:1337/.well-known/mercure
# Secret pour signer les JWT (doit correspondre au hub)
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> stripe (paiement) ###
# Clé secrète Stripe (test: sk_test_..., production: sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Clé publique Stripe (utilisable côté front au besoin)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Secret du webhook Stripe (whsec_...) pour valider les paiements
# À remplacer par la vraie valeur fournie par Stripe pour ton endpoint webhook
# STRIPE_WEBHOOK_SECRET=whsec_xxx
###< stripe ###

###> ocr.space ###
# Cle API OCR.Space (https://ocr.space/ocrapi)
