{% extends 'base.html.twig' %}

{% block title %}Mes commandes - MediConnect{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes Commandes</h1>
        <a href="{{ path('app_catalogue') }}" class="btn btn-primary">
            <i class="bi bi-shop"></i> Continuer mes achats
        </a>
    </div>

    {% if commandes | length > 0 %}
        <div class="row">
            {% for commande in commandes %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Commande #{{ commande.id }}</h6>
                            <span class="badge bg-{{ commande.statut.getColor() }}">
                                {{ commande.statut.getLabel() }}
                            </span>
                        </div>
                        <div class="card-body">
                            <p class="mb-2">
                                <strong>Date:</strong>
                                {{ commande.dateCommande | date('d/m/Y à H:i') }}
                            </p>
                            <p class="mb-2">
                                <strong>Articles:</strong>
                                {{ commande.lignesCommande | length }}
                            </p>
                            <p class="mb-0">
                                <strong>Montant:</strong>
                                <span class="h5 text-primary">{{ commande.montantTotal | number_format(2, ',', ' ') }} TND</span>
                            </p>
                        </div>
                        <div class="card-footer bg-white">
                            <div class="d-grid gap-2">
                                <a href="{{ path('app_order_detail', {id: commande.id}) }}" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> Voir détails
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info text-center" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            Vous n'avez aucune commande
        </div>
        <div class="text-center">
            <a href="{{ path('app_catalogue') }}" class="btn btn-primary btn-lg">
                <i class="bi bi-shop"></i> Découvrir nos produits
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
