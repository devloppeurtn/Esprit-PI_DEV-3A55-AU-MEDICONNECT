{% extends 'admin/base_admin.html.twig' %}

{% block title %}Paramètres - MediConnect{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/profile.css') }}" rel="stylesheet">
    <style>
        .settings-layout { max-width: 900px; }
        .settings-section { padding: 1.5rem 0; }
        .settings-section h5 { color: #112344; font-weight: 600; margin-bottom: 0.5rem; }
        .settings-section > p { color: #64748b; margin-bottom: 1.5rem; }
        .settings-form .form-label { font-weight: 500; color: #374151; }
        .settings-form .form-control, .settings-form .form-select { border-radius: 10px; }
        .settings-nav-sidebar { background: #f8fafc; border-radius: 12px; padding: 1rem; }
        .settings-nav-sidebar .nav-link {
            border-radius: 8px;
            padding: 0.6rem 1rem;
            color: #475569;
            font-weight: 500;
            margin-bottom: 0.25rem;
        }
        .settings-nav-sidebar .nav-link:hover { background: #e2e8f0; color: #112344; }
        .settings-nav-sidebar .nav-link.active { background: #175cdd; color: #fff; }
        .btn-save-settings { background: linear-gradient(135deg, #175cdd, #1a6beb); border: none; border-radius: 10px; padding: 0.6rem 1.5rem; font-weight: 600; }
        .btn-save-settings:hover { background: linear-gradient(135deg, #1247b8, #175cdd); color: #fff; }
        .profile-completion-card { background: linear-gradient(135deg, rgba(23,92,221,0.08), rgba(23,92,221,0.04)); border: 1px solid rgba(23,92,221,0.2); border-radius: 12px; padding: 1.25rem; margin-bottom: 2rem; }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-10 col-xl-9 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1" style="color: #112344; font-weight: 700;"><i class="bi bi-gear-fill me-2"></i>Paramètres du compte</h2>
                    <p class="text-muted mb-0">Complétez et gérez les informations de votre profil</p>
                </div>
                <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-person me-1"></i>Voir mon profil
                </a>
            </div>

            <div class="profile-completion-card">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-person-vcard text-primary fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <h6 class="mb-1" style="color: #112344;">Compléter votre profil</h6>
                        <p class="mb-0 small text-muted">Remplissez les champs ci-dessous pour compléter vos informations personnelles. Ces données seront visibles sur votre profil.</p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    {{ form_start(form, {'attr': {'class': 'settings-form'}}) }}

                    <div class="settings-section">
                        <h5><i class="bi bi-person-fill me-2"></i>Informations générales</h5>
                        <p class="text-muted small">Vos informations de base utilisées sur la plateforme</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_row(form.nomComplet) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.email) }}
                            </div>
                        </div>
                    </div>

                    {% if user.role.value == 'PATIENT' %}
                    <hr class="my-4">
                    <div class="settings-section">
                        <h5><i class="bi bi-person-vcard me-2"></i>Informations patient</h5>
                        <p class="text-muted small">Vos coordonnées et informations médicales</p>
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                            <div class="col-md-6">{{ form_row(form.dateNaissance) }}</div>
                            <div class="col-12">{{ form_row(form.adresse) }}</div>
                        </div>
                    </div>
                    {% elseif user.role.value == 'MEDECIN' %}
                    <hr class="my-4">
                    <div class="settings-section">
                        <h5><i class="bi bi-heart-pulse me-2"></i>Informations professionnelles</h5>
                        <p class="text-muted small">Vos informations en tant que médecin</p>
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.specialite) }}</div>
                            <div class="col-md-6">{{ form_row(form.numeroLicence) }}</div>
                            <div class="col-12">{{ form_row(form.adresseCabinet) }}</div>
                        </div>
                    </div>
                    {% elseif user.role.value == 'SECRETAIRE' %}
                    <hr class="my-4">
                    <div class="settings-section">
                        <h5><i class="bi bi-person-badge me-2"></i>Informations secrétaire</h5>
                        <p class="text-muted small">Vos coordonnées</p>
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                        </div>
                    </div>
                    {% elseif user.role.value == 'PARTICIPATION' %}
                    <hr class="my-4">
                    <div class="settings-section">
                        <h5><i class="bi bi-people me-2"></i>Informations participation</h5>
                        <p class="text-muted small">Votre rôle dans l'événement</p>
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.roleDansEvenement) }}</div>
                            <div class="col-md-6">{{ form_row(form.presenceConfirmee) }}</div>
                        </div>
                    </div>
                    {% endif %}

                    <hr class="my-4">
                    <div class="settings-section">
                        <h5><i class="bi bi-lock-fill me-2"></i>Sécurité</h5>
                        <p class="text-muted small">Modifiez votre mot de passe si nécessaire. Laissez vide pour le conserver.</p>
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.plainPassword) }}</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3">
                        <button type="submit" class="btn btn-primary btn-save-settings">
                            <i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
                        </button>
                        <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
