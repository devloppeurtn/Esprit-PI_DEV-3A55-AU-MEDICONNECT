{% extends 'admin/base_admin.html.twig' %}

{% block title %}Mes consultations - MediConnect{% endblock %}

{% block admin_content %}
<div class="medecin-consultations">
    <h1 class="h3 mb-4"><i class="bi bi-clipboard2-pulse-fill me-2"></i>Mes consultations</h1>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            {% if consultations|length > 0 %}
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Patient</th><th>Date</th><th>Diagnostic</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    {% for c in consultations %}
                    <tr>
                        <td>{{ c.dossierMedical.patient.nomComplet }}</td>
                        <td>{{ c.date|date('d/m/Y H:i') }}</td>
                        <td>{% set d = c.diagnostic|default('?') %}{{ d|length > 40 ? d|slice(0, 40) ~ '...' : d }}</td>
                        <td>
                            <a href="{{ path('app_medecin_consultation_voir', {id: c.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p class="text-center text-muted py-5 mb-0">Aucune consultation. Créez une consultation depuis un rendez-vous confirmé.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

