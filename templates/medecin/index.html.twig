{% extends 'admin/base_admin.html.twig' %}

{% block title %}Mon espace médecin - MediConnect{% endblock %}

{% block admin_content %}
<div class="medecin-espace">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1">Mon espace médecin</h1>
            <p class="text-muted mb-0">Bienvenue Dr {{ medecin.nomComplet }}</p>
        </div>
    </div>

    <div class="row g-4">
        {# Notifications Section #}
        {% set notifications = app.user ? notification_service.getNotifications(app.user, 5) : [] %}
        {% if notifications|length > 0 %}
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-bell me-2"></i>Notifications récentes
                    </h5>
                    <a href="{{ path('app_notifications_index') }}" class="btn btn-sm btn-outline-primary">
                        Voir tout
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        {% for notification in notifications %}
                            <a href="{{ notification.lien ?: path('app_notifications_index') }}" class="list-group-item list-group-item-action {{ notification.lu ? '' : 'bg-light' }}">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-1">
                                            {% if notification.type == 'CATEGORIE_APPROUVEE' %}
                                                <i class="bi bi-check-circle text-success me-2"></i>
                                            {% elseif notification.type == 'CATEGORIE_REJETEE' %}
                                                <i class="bi bi-x-circle text-danger me-2"></i>
                                            {% else %}
                                                <i class="bi bi-bell text-primary me-2"></i>
                                            {% endif %}
                                            <strong>{{ notification.titre }}</strong>
                                            {% if not notification.lu %}
                                                <span class="badge bg-primary ms-2">Nouveau</span>
                                            {% endif %}
                                        </div>
                                        <p class="mb-1 text-muted small">{{ notification.message }}</p>
                                        <small class="text-muted">
                                            <i class="bi bi-clock"></i>
                                            {{ notification.dateCreation|date('d/m/Y à H:i') }}
                                        </small>
                                    </div>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_medecin_agenda') }}" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                        <i class="bi bi-calendar-range-fill fs-4"></i>
                    </div>
                    <h5 class="mb-0">Mon Agenda</h5>
                    <p class="text-muted small mb-0 mt-1">Planning hebdomadaire</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_medecin_secretaires') }}" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                        <i class="bi bi-person-badge-fill fs-4"></i>
                    </div>
                    <h5 class="mb-0">Mes secrétaires</h5>
                    <p class="text-muted small mb-0 mt-1">Gérer mon équipe</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_medecin_rendez_vous') }}" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                        <i class="bi bi-calendar-event-fill fs-4"></i>
                    </div>
                    <h5 class="mb-0">Mes rendez-vous</h5>
                    <p class="text-muted small mb-0 mt-1">Planning des consultations</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_medecin_consultations') }}" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                        <i class="bi bi-clipboard2-pulse-fill fs-4"></i>
                    </div>
                    <h5 class="mb-0">Mes consultations</h5>
                    <p class="text-muted small mb-0 mt-1">Ordonnances, rapports</p>
                </div>
            </a>
        </div>
    </div>
</div>
{% endblock %}
