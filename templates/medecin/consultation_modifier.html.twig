{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la consultation - MediConnect{% endblock %}

{% block body %}
<div class="medecin-consultation-modifier">
    <h1 class="h3 mb-4">Modifier la consultation</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            {{ form_row(form.date) }}
            {{ form_row(form.diagnostic) }}
            {{ form_row(form.resume) }}
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_medecin_consultation_voir', {id: consultation.id}) }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
