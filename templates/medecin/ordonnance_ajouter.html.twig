{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter une ordonnance - MediConnect{% endblock %}

{% block admin_content %}
<div class="medecin-ordonnance-ajouter">
    <h1 class="h3 mb-4">Ajouter une ordonnance</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            {{ form_row(form.medicament) }}
            {{ form_row(form.methodeUtilisation) }}
            {{ form_row(form.instructions) }}
            <button type="submit" class="btn btn-primary">Ajouter</button>
        </div>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}

