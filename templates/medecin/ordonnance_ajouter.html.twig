{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter une ordonnance - MediConnect{% endblock %}

{% block admin_content %}
<div class="medecin-ordonnance-ajouter">
    <h1 class="h3 mb-4">Ajouter une ordonnance</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            {{ form_row(form.medicament, {'attr': {'class': 'form-control medicament-autocomplete', 'autocomplete': 'off'}}) }}
            {{ form_row(form.methodeUtilisation) }}
            {{ form_row(form.instructions) }}
            <button type="submit" class="btn btn-primary">Ajouter</button>
        </div>
    </div>
    {{ form_end(form) }}
</div>

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const input = document.querySelector('.medicament-autocomplete');
    if (!input) return;

    // Création du conteneur de suggestions
    const container = document.createElement('div');
    container.className = 'list-group position-absolute w-100 shadow-sm custom-autocomplete-list';
    container.style.zIndex = '1000';
    container.style.display = 'none';
    
    // On s'assure que le parent est en position relative pour le positionnement absolu de la liste
    const parent = input.closest('.mb-3') || input.parentNode;
    parent.style.position = 'relative';
    parent.appendChild(container);

    let timeout = null;

    input.addEventListener('input', function() {
        clearTimeout(timeout);
        const query = this.value.trim();

        if (query.length < 2) {
            container.style.display = 'none';
            return;
        }

        timeout = setTimeout(() => {
            fetch('{{ path('app_medecin_api_medicaments') }}?query=' + encodeURIComponent(query))
                .then(response => response.json())
                .then(data => {
                    container.innerHTML = '';
                    if (Array.isArray(data) && data.length > 0) {
                        data.forEach(item => {
                            const btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'list-group-item list-group-item-action py-2';
                            // L'API open-medicaments retourne 'denomination'
                            btn.textContent = item.denomination;
                            btn.addEventListener('click', function() {
                                input.value = item.denomination;
                                container.style.display = 'none';
                            });
                            container.appendChild(btn);
                        });
                        container.style.display = 'block';
                    } else {
                        container.style.display = 'none';
                    }
                })
                .catch(err => {
                    console.error('Erreur autocomplete:', err);
                    container.style.display = 'none';
                });
        }, 300);
    });

    // Fermer les suggestions si on clique ailleurs
    document.addEventListener('click', function(e) {
        if (!input.contains(e.target) && !container.contains(e.target)) {
            container.style.display = 'none';
        }
    });

    // Empêcher la soumission du formulaire par erreur si on appuie sur Entrée dans la liste
    input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && container.style.display === 'block') {
            // Optionnel: sélectionner le premier élément
            const firstChild = container.querySelector('.list-group-item');
            if (firstChild) {
                firstChild.click();
                e.preventDefault();
            }
        }
    });
});
</script>

<style>
.custom-autocomplete-list {
    max-height: 250px;
    overflow-y: auto;
    top: 100%;
    left: 0;
}
.custom-autocomplete-list .list-group-item {
    cursor: pointer;
    font-size: 0.9rem;
}
.custom-autocomplete-list .list-group-item:hover {
    background-color: #f8f9fa;
}
</style>
{% endblock %}
{% endblock %}

