{% extends 'admin/base_admin.html.twig' %}

{% block title %}Mes secrétaires - MediConnect{% endblock %}

{% block admin_content %}
<div class="medecin-secretaires">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1">Mes secrétaires</h1>
            <p class="text-muted mb-0">Gérez les secrétaires de votre cabinet</p>
        </div>
    </div>

    {# Formulaire d'ajout #}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="card-title mb-3"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Ajouter un secrétaire</h5>
            {{ form_start(form, {'attr': {'class': 'row g-3', 'novalidate': 'novalidate'}}) }}
                <div class="col-md-8">
                    {{ form_row(form.email, {
                        'label': false,
                        'attr': {'class': 'form-control', 'placeholder': 'Email du secrétaire'}
                    }) }}
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-lg me-2"></i>Ajouter
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    {# Invitations en attente #}
    {% if invitationsEnAttente|length > 0 %}
    <div class="card border-0 shadow-sm mb-4 border-warning">
        <div class="card-header bg-warning bg-opacity-10 border-0 py-3">
            <h5 class="mb-0"><i class="bi bi-hourglass-split me-2 text-warning"></i>Invitations en attente ({{ invitationsEnAttente|length }})</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Secrétaire</th>
                            <th>Email</th>
                            <th>Date d'envoi</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for inv in invitationsEnAttente %}
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <a href="{{ path('app_user_profile_view', {id: inv.secretaire.id}) }}" class="text-decoration-none text-dark d-flex align-items-center">
                                        {% if inv.secretaire.photo %}
                                            <img src="{{ asset(inv.secretaire.photo) }}" 
                                                 alt="{{ inv.secretaire.nomComplet }}" 
                                                 class="rounded-circle me-3" 
                                                 style="width: 40px; height: 40px; object-fit: cover; border: 2px solid #ffc107; cursor: pointer; transition: transform 0.2s;"
                                                 onmouseover="this.style.transform='scale(1.1)'"
                                                 onmouseout="this.style.transform='scale(1)'"
                                                 title="Voir le profil">
                                        {% else %}
                                            <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; cursor: pointer; transition: transform 0.2s;" 
                                                 onmouseover="this.style.transform='scale(1.1)'"
                                                 onmouseout="this.style.transform='scale(1)'"
                                                 title="Voir le profil">
                                                <i class="bi bi-hourglass-split"></i>
                                            </div>
                                        {% endif %}
                                        <span class="fw-medium">{{ inv.secretaire.nomComplet }}</span>
                                    </a>
                                </div>
                            </td>
                            <td>{{ inv.secretaire.email }}</td>
                            <td>{{ inv.dateCreation|date('d/m/Y H:i') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}

    {# Liste des secrétaires #}
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 py-3">
            <h5 class="mb-0"><i class="bi bi-person-badge-fill me-2"></i>Secrétaires de votre équipe ({{ secretaires|length }})</h5>
        </div>
        <div class="card-body p-0">
            {% if secretaires|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Statut</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for secretaire in secretaires %}
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <a href="{{ path('app_user_profile_view', {id: secretaire.id}) }}" class="text-decoration-none text-dark d-flex align-items-center">
                                        {% if secretaire.photo %}
                                            <img src="{{ asset(secretaire.photo) }}" 
                                                 alt="{{ secretaire.nomComplet }}" 
                                                 class="rounded-circle me-3" 
                                                 style="width: 40px; height: 40px; object-fit: cover; border: 2px solid #0d6efd; cursor: pointer; transition: transform 0.2s;"
                                                 onmouseover="this.style.transform='scale(1.1)'"
                                                 onmouseout="this.style.transform='scale(1)'"
                                                 title="Voir le profil">
                                        {% else %}
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; cursor: pointer; transition: transform 0.2s;"
                                                 onmouseover="this.style.transform='scale(1.1)'"
                                                 onmouseout="this.style.transform='scale(1)'"
                                                 title="Voir le profil">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                        {% endif %}
                                        <span class="fw-medium">{{ secretaire.nomComplet }}</span>
                                    </a>
                                </div>
                            </td>
                            <td>{{ secretaire.email }}</td>
                            <td>{{ secretaire.telephone ?? '?' }}</td>
                            <td>
                                {% if secretaire.statut.value == 'ACTIF' %}
                                    <span class="badge bg-success">Actif</span>
                                {% elseif secretaire.statut.value == 'SUSPENDU' %}
                                    <span class="badge bg-warning text-dark">Suspendu</span>
                                {% else %}
                                    <span class="badge bg-danger">Banni</span>
                                {% endif %}
                            </td>
                            <td class="text-end pe-4">
                                <form method="post" action="{{ path('app_medecin_secretaire_retirer', {id: secretaire.id}) }}" class="d-inline" onsubmit="return confirm('Retirer ce secr�taire de votre �quipe ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('retirer_secretaire_' ~ secretaire.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Retirer de l'équipe">
                                        <i class="bi bi-person-dash"></i> Retirer
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-badge display-4 d-block mb-3 opacity-50"></i>
                <p class="mb-0">Aucun secrétaire dans votre équipe.</p>
                <p class="small">Utilisez le formulaire ci-dessus pour en ajouter un par email.</p>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

