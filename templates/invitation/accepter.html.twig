{% extends 'base.html.twig' %}

{% block title %}Accepter l'invitation - MediConnect{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="h4 mb-4"><i class="bi bi-person-badge-fill text-primary me-2"></i>Accepter l'invitation</h2>
                    
                    <p class="text-muted mb-4">
                        <strong>{{ invitation.medecin.nomComplet }}</strong>{% if invitation.medecin.specialite %} ({{ invitation.medecin.specialite }}){% endif %}
                        vous invite à rejoindre son équipe en tant que secrétaire sur MediConnect.
                    </p>

                    {% if doitDefinirMotDePasse %}
                        <p class="mb-4">Pour finaliser votre inscription, veuillez définir votre mot de passe :</p>
                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                            {{ form_row(form.password) }}
                            <div class="d-flex gap-2 mt-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-2"></i>Accepter et créer mon compte
                                </button>
                                <a href="{{ path('app_invitation_refuser', {token: invitation.token}) }}" class="btn btn-outline-secondary">
                                    Refuser
                                </a>
                            </div>
                        {{ form_end(form) }}
                    {% else %}
                        <form method="post" class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>Accepter l'invitation
                            </button>
                            <a href="{{ path('app_invitation_refuser', {token: invitation.token}) }}" class="btn btn-outline-secondary">
                                Refuser
                            </a>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
