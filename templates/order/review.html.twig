{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">Recapitulatif livraison</div>
                <div class="card-body">
                    <p><strong>Adresse :</strong> {{ commande.adresseLivraison }}</p>
                    <p><strong>Telephone :</strong> {{ commande.telephone }}</p>
                    <p><strong>Pays :</strong> {{ commande.pays }}</p>
                    <p><strong>Ville :</strong> {{ commande.deliveryCity ?: '-' }}</p>
                    <p><strong>Trafic estime :</strong> {{ commande.deliveryTrafficLevel }}</p>
                    <p><strong>Estimation :</strong> {{ commande.estimatedDeliveryDays ?: '-' }} jours</p>
                    <p class="mb-0">
                        <strong>ETA committe :</strong>
                        {{ commande.deliveryEtaAt ? commande.deliveryEtaAt|date('d/m/Y H:i') : '-' }}
                    </p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">Details du panier</div>
                <div class="card-body">
                    <ul class="list-group mb-3">
                        {% for ligne in commande.lignesCommande %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>{{ ligne.produit.nom }}</strong>
                                    <div class="small text-muted">x{{ ligne.quantite }}</div>
                                </div>
                                <div>{{ (ligne.prixUnitaire * ligne.quantite) | number_format(2, ',', ' ') }} TND</div>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="h5">Total: {{ commande.montantTotal | number_format(2, ',', ' ') }} TND</p>
                </div>
            </div>

            <form method="post">
                <div class="card">
                    <div class="card-header">Choisir la methode de paiement</div>
                    <div class="card-body">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="payment_method" id="pm_card" value="card" checked>
                            <label class="form-check-label" for="pm_card">Carte bancaire (Stripe)</label>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="radio" name="payment_method" id="pm_cod" value="cod">
                            <label class="form-check-label" for="pm_cod">Paiement a la livraison (Especes)</label>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a href="{{ path('app_checkout') }}" class="btn btn-link">Modifier l'adresse</a>
                        <button type="submit" class="btn btn-primary">Valider et poursuivre</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
