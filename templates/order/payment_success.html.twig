{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-success">
                <h4 class="alert-heading">Paiement reçu</h4>
                <p>Merci ! Votre paiement pour la commande #{{ commande.id }} a été reçu.</p>
                <hr>
                <a href="{{ path('app_orders_list') }}" class="btn btn-primary">Voir mes commandes</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
