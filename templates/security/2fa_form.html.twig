{% extends 'base_auth_standalone.html.twig' %}

{% block title %}Vérification en 2 étapes - MediConnect{% endblock %}

{% block body %}
<section class="vh-100 auth-section" style="background-color: #ffffff;">
  <div class="container py-5 h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col col-xl-6">
        <div class="card auth-card" style="border-radius: 1rem;">
          <div class="card-body p-4 p-lg-5 text-black">
            <div class="d-flex align-items-center mb-3 pb-1">
              <img src="{{ asset('assets/img/logomed.png') }}" alt="Logo MediConnect" class="auth-form-logo me-3">
              <span class="h1 fw-bold mb-0" style="color: #112344;">MediConnect</span>
            </div>

            <h5 class="fw-normal mb-3 pb-2" style="letter-spacing: 1px; color: #112344;">Validation en 2 étapes</h5>
            <p class="text-muted small mb-4">Entrez le code généré par Google Authenticator.</p>

            {% if authenticationError %}
              <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            {% endif %}

            <form action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" method="post">
              <div class="mb-3">
                <label class="form-label" for="_auth_code">Code de vérification</label>
                <input
                  id="_auth_code"
                  type="text"
                  name="{{ authCodeParameterName }}"
                  class="form-control form-control-lg"
                  autocomplete="one-time-code"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  autofocus
                  required
                />
              </div>

              {% if displayTrustedOption %}
                <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" id="_trusted" name="{{ trustedParameterName }}">
                  <label class="form-check-label" for="_trusted">Se souvenir de cet appareil</label>
                </div>
              {% endif %}

              {% if isCsrfProtectionEnabled %}
                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
              {% endif %}

              <div class="pt-1 mb-3">
                <button class="btn btn-primary btn-lg w-100" type="submit" style="background-color: #175cdd;">Vérifier</button>
              </div>
            </form>

            <div class="d-flex justify-content-between">
              <a class="small text-muted" href="{{ logoutPath }}">Annuler</a>
              {% if availableTwoFactorProviders|length > 1 %}
                <div>
                  <span class="small text-muted">Méthodes :</span>
                  {% for provider in availableTwoFactorProviders %}
                    <a class="small text-muted" href="{{ path('2fa_login', {'preferProvider': provider}) }}">{{ provider }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
