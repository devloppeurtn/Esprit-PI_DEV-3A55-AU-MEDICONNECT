{% extends 'base.html.twig' %}

{% block title %}Panier - MediConnect{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">Votre Panier</h1>

    {% if hasStockIssue %}
        <div class="alert alert-warning">
            Certains produits depassent le stock disponible. Ajustez les quantites avant de continuer au paiement.
        </div>
    {% endif %}

    {% if cart | length > 0 %}
        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div id="cartItems">
                            {% for productId, item in cart %}
                                <div class="card mb-3 cart-item" data-product-id="{{ productId }}">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-3">
                                                {% if item.image %}
                                                    {% set imgPath = (item.image is not empty and (item.image starts with('http') or item.image starts with('/') or item.image starts with('assets') or item.image starts with('uploads'))) ? item.image : ('assets/img/' ~ item.image) %}
                                                    <img src="{{ asset(imgPath) }}" class="img-fluid rounded" alt="{{ item.nom }}">
                                                {% else %}
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 150px;">
                                                        <i class="bi bi-image text-muted"></i>
                                                    </div>
                                                {% endif %}
                                            </div>
                                            <div class="col-md-5">
                                                <h5>{{ item.nom }}</h5>
                                                <p class="text-muted mb-2">Prix unitaire: <strong>{{ item.prix | number_format(2, ',', ' ') }} TND</strong></p>
                                                <p class="mb-0" id="lineTotal{{ productId }}">
                                                    Sous-total: <strong>{{ (item.prix * item.quantity) | number_format(2, ',', ' ') }} TND</strong>
                                                </p>
                                                <small class="d-block mt-1 {{ (item.stock|default(0)) > 0 ? 'text-muted' : 'text-danger' }}">
                                                    Stock disponible: {{ item.stock|default(0) }}
                                                    {% if stockIssues[productId] is defined %}
                                                        - {{ stockIssues[productId] }}
                                                    {% endif %}
                                                </small>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="input-group mb-2">
                                                    <button class="btn btn-outline-secondary decrease-qty" data-product-id="{{ productId }}">−</button>
                                                    <input type="number" class="form-control text-center quantity-input" 
                                                           data-product-id="{{ productId }}" 
                                                           value="{{ item.quantity }}" min="1" max="{{ item.stock|default(item.quantity) }}" data-max-stock="{{ item.stock|default(item.quantity) }}" {{ (item.stock|default(0)) <= 0 ? 'disabled' : '' }}>
                                                    <button class="btn btn-outline-secondary increase-qty" data-product-id="{{ productId }}" {{ (item.stock|default(0)) <= item.quantity ? 'disabled' : '' }}>+</button>
                                                </div>
                                                <div class="d-grid gap-2">
                                                    <button class="btn btn-danger btn-sm remove-from-cart" data-product-id="{{ productId }}">
                                                        <i class="bi bi-trash"></i> Retirer
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="{{ path('app_catalogue') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Continuer mes achats
                    </a>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card sticky-top shadow-sm" style="top: 80px;">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Résumé de la commande</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="promoCode" class="form-label">Code promo</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="promoCode" placeholder="Ex: Medi1234" value="{{ cartTotals.promo.code ?? '' }}">
                                <button class="btn btn-outline-primary" id="applyPromoBtn">Appliquer</button>
                            </div>
                            <div id="promoFeedback" class="form-text text-success"></div>
                        </div>

                        <div class="mb-3 pb-3 border-bottom">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Sous-total:</span>
                                <span id="subtotal">{{ cartTotals.subtotal | number_format(2, ',', ' ') }} TND</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2" id="discountRow" {% if (cartTotals.discount ?? 0) <= 0 %}style="display:none"{% endif %}>
                                <span>Remise:</span>
                                <span id="discount" class="text-success">- {{ cartTotals.discount | number_format(2, ',', ' ') }} TND</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Livraison:</span>
                                <span class="text-success">Gratuite</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <h5 class="d-flex justify-content-between">
                                <span>Total:</span>
                                <span id="total">{{ cartTotals.total | number_format(2, ',', ' ') }} TND</span>
                            </h5>
                        </div>
                        
                        {% if app.user %}
                            {% if hasStockIssue %}
                                <button type="button" class="btn btn-secondary w-100 btn-lg mb-2" disabled>
                                    <i class="bi bi-x-circle"></i> Stock insuffisant
                                </button>
                            {% else %}
                                <a href="{{ path('app_checkout') }}" class="btn btn-primary w-100 btn-lg mb-2">
                                    <i class="bi bi-credit-card"></i> Procéder au paiement
                                </a>
                            {% endif %}
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn btn-primary w-100 btn-lg mb-2">
                                Se connecter pour commander
                            </a>
                        {% endif %}
                        
                        <button id="clearCartBtn" class="btn btn-outline-danger w-100">
                            <i class="bi bi-trash"></i> Vider le panier
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info text-center" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            Votre panier est vide
        </div>
        <div class="text-center">
            <a href="{{ path('app_catalogue') }}" class="btn btn-primary btn-lg">
                <i class="bi bi-shop"></i> Continuer mes achats
            </a>
        </div>
    {% endif %}
</div>

<script>
    function getMaxStock(input) {
        return parseInt(input.dataset.maxStock || input.max || '99999', 10);
    }

    function syncIncreaseButton(productId) {
        const input = document.querySelector(`[data-product-id="${productId}"].quantity-input`);
        const increaseBtn = document.querySelector(`.increase-qty[data-product-id="${productId}"]`);
        if (!input || !increaseBtn) return;
        const maxStock = getMaxStock(input);
        const current = parseInt(input.value || '0', 10);
        increaseBtn.disabled = current >= maxStock || maxStock <= 0;
    }

    // Quantity buttons
    document.querySelectorAll('.decrease-qty').forEach(btn => {
        btn.addEventListener('click', () => {
            const productId = btn.dataset.productId;
            const input = document.querySelector(`[data-product-id="${productId}"].quantity-input`);
            if (!input) return;
            const current = parseInt(input.value || '1', 10);
            if (current > 1) {
                input.value = current - 1;
                updateCartItem(productId, parseInt(input.value, 10));
            }
        });
    });

    document.querySelectorAll('.increase-qty').forEach(btn => {
        btn.addEventListener('click', () => {
            const productId = btn.dataset.productId;
            const input = document.querySelector(`[data-product-id="${productId}"].quantity-input`);
            if (!input) return;
            const maxStock = getMaxStock(input);
            const current = parseInt(input.value || '1', 10);

            if (current >= maxStock) {
                showNotification(`Stock maximum atteint (${maxStock})`, 'error');
                syncIncreaseButton(productId);
                return;
            }

            input.value = current + 1;
            updateCartItem(productId, parseInt(input.value, 10));
        });
    });

    // Manual quantity input
    document.querySelectorAll('.quantity-input').forEach(input => {
        input.addEventListener('change', () => {
            const productId = input.dataset.productId;
            const maxStock = getMaxStock(input);
            let quantity = parseInt(input.value || '1', 10);

            if (quantity < 1) quantity = 1;
            if (quantity > maxStock) {
                quantity = maxStock;
                showNotification(`Stock maximum atteint (${maxStock})`, 'error');
            }

            input.value = quantity;
            updateCartItem(productId, quantity);
        });
    });

    // Remove from cart
    document.querySelectorAll('.remove-from-cart').forEach(btn => {
        btn.addEventListener('click', () => {
            const productId = btn.dataset.productId;
            removeFromCart(productId);
        });
    });

    // Clear cart
    document.getElementById('clearCartBtn')?.addEventListener('click', () => {
        if (confirm('Etes-vous sur de vouloir vider votre panier ?')) {
            clearCart();
        }
    });

    function updateCartItem(productId, quantity) {
        const formData = new FormData();
        formData.append('quantity', quantity);

        fetch(`{{ path('app_cart_update', {id: 0}) }}`.replace('0', productId), {
            method: 'POST',
            body: formData,
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(response => response.json().then(data => ({ ok: response.ok, data })))
        .then(({ ok, data }) => {
            const input = document.querySelector(`[data-product-id="${productId}"].quantity-input`);
            if (!ok) {
                if (input && data.maxStock !== undefined) {
                    const max = parseInt(data.maxStock, 10);
                    input.value = max > 0 ? max : 1;
                }
                if (data.removed) {
                    location.reload();
                    return;
                }
                showNotification(data.error || 'Stock insuffisant pour ce produit', 'error');
                syncIncreaseButton(productId);
                return;
            }

            if (data.success) {
                const lineTotal = (parseFloat(data.itemTotal)).toLocaleString('fr-FR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                const lineEl = document.getElementById(`lineTotal${productId}`);
                if (lineEl) lineEl.innerHTML = `Sous-total: <strong>${lineTotal} TND</strong>`;
                updateTotals(data);
                syncIncreaseButton(productId);
            } else {
                showNotification(data.error || 'Stock insuffisant pour ce produit', 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification(error.message || 'Erreur lors de la requete', 'error');
        });
    }
function removeFromCart(productId) {
        const formData = new FormData();

        fetch(`{{ path('app_cart_remove', {id: 0}) }}`.replace('0', productId), {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Remove item from DOM
                const itemNode = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                itemNode?.remove();
                
                updateTotals(data);
                
                // If cart is empty, reload page
                const cartItems = document.getElementById('cartItems');
                if (cartItems.children.length === 0) {
                    location.reload();
                }
            }
        });
    }

    document.querySelectorAll('.quantity-input').forEach(input => {
        syncIncreaseButton(input.dataset.productId);
    });

    function clearCart() {
        fetch(`{{ path('app_cart_clear') }}`, {
            method: 'POST'
        })
        .then(response => response.json())
        .then(data => {
            updateTotals(data);
            location.reload();
        });
    }

    function updateTotals(data) {
        if (!data) return;
        const subtotal = parseFloat(data.subtotal ?? data.cartTotal ?? 0);
        const total = parseFloat(data.cartTotal ?? 0);
        const discount = parseFloat(data.discount ?? 0);

        const subtotalEl = document.getElementById('subtotal');
        const totalEl = document.getElementById('total');
        const discountEl = document.getElementById('discount');
        const discountRow = document.getElementById('discountRow');

        if (subtotalEl) subtotalEl.textContent = subtotal.toLocaleString('fr-FR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' TND';
        if (totalEl) totalEl.textContent = total.toLocaleString('fr-FR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' TND';

        if (discountEl && discountRow) {
            if (discount > 0.0001) {
                discountEl.textContent = '- ' + discount.toLocaleString('fr-FR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' TND';
                discountRow.style.display = '';
            } else {
                discountRow.style.display = 'none';
            }
        }

        if (data.promo && data.promo.code && document.getElementById('promoCode')) {
            document.getElementById('promoCode').value = data.promo.code;
            const fb = document.getElementById('promoFeedback');
            if (fb) fb.textContent = 'Code appliqué: ' + data.promo.code;
        }
    }

    document.getElementById('applyPromoBtn')?.addEventListener('click', () => {
        const codeInput = document.getElementById('promoCode');
        const code = codeInput?.value || '';
        const feedback = document.getElementById('promoFeedback');
        if (feedback) feedback.textContent = '';

        const formData = new FormData();
        formData.append('code', code);

        fetch(`{{ path('app_cart_promo') }}`, {
            method: 'POST',
            body: formData,
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(response => response.json().then(data => ({ ok: response.ok, data })))
        .then(({ ok, data }) => {
            if (!ok) throw new Error(data.error || 'Code promo invalide');
            updateTotals(data);
            if (feedback) {
                feedback.classList.remove('text-danger');
                feedback.classList.add('text-success');
                feedback.textContent = data.message || 'Code appliqué';
            }
        })
        .catch(err => {
            if (feedback) {
                feedback.classList.remove('text-success');
                feedback.classList.add('text-danger');
                feedback.textContent = err.message;
            }
        });
    });

    function showNotification(message, type) {
        const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
        const html = `<div class="alert ${alertClass} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3" role="alert" style="z-index:9999;">
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>`;
        const wrap = document.createElement('div');
        wrap.innerHTML = html;
        const el = wrap.firstElementChild;
        document.body.appendChild(el);
        setTimeout(() => { el?.remove(); }, 3000);
    }
</script>
{% endblock %}


