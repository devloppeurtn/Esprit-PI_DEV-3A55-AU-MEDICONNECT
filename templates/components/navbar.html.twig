<!-- Header avec Navbar -->
<header id="header" class="header fixed-top">
    <div class="topbar d-flex align-items-center dark-background">
        <div class="container d-flex justify-content-center justify-content-md-between">
            <div class="contact-info d-flex align-items-center">
                <i class="bi bi-envelope d-flex align-items-center"><a href="mailto:contact@mediconnect.fr">contact@mediconnect.fr</a></i>
                <i class="bi bi-phone d-flex align-items-center ms-4"><span>+216 52 251 112 </span></i>
            </div>
            <div class="social-links d-none d-md-flex align-items-center">
                <a href="#!" class="twitter"><i class="bi bi-twitter-x"></i></a>
                <a href="#!" class="facebook"><i class="bi bi-facebook"></i></a>
                <a href="#!" class="instagram"><i class="bi bi-instagram"></i></a>
                <a href="#!" class="linkedin"><i class="bi bi-linkedin"></i></a>
            </div>
        </div>
    </div>

    <div class="branding d-flex align-items-cente">
        <div class="container position-relative d-flex align-items-center justify-content-between">
            <a href="{{ path('app_home') }}" class="logo d-flex align-items-center">
                <img src="{{ asset('assets/img/logomed.png') }}" alt="Logo MediConnect">
                <h1 class="sitename">MediConnect</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a href="{{ path('app_home') }}" {% if app.request.get('_route') == 'app_home' %}class="active"{% endif %}>Accueil</a></li>
                    <li><a href="#!">À propos</a></li>
                    <li><a href="#!">Services</a></li>
                    <li><a href="#!">Contact</a></li>
                           {% if app.user %}
                               <li class="dropdown">
                                   <a href="#"><span>{{ app.user.nomComplet }}</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                                   <ul>
                                       <li><a href="{{ path('app_profile') }}">Mon Profil</a></li>
                                       <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                                   </ul>
                               </li>
                           {% else %}
                        <li><a href="{{ path('app_login') }}" {% if app.request.get('_route') == 'app_login' %}class="active"{% endif %}>Connexion</a></li>
                        <li><a href="{{ path('app_signup') }}" class="btn-nav-signup {% if app.request.get('_route') == 'app_signup' %}active{% endif %}">S'inscrire</a></li>
                    {% endif %}
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>
        </div>
    </div>
</header>
