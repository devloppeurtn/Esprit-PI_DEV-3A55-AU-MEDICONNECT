{#
    Navbar MediConnect - Utilisée sur toutes les pages (home, auth, admin)
    Variables optionnelles:
    - is_admin_context: true pour les interfaces admin (affiche le toggle sidebar)
#}
{% set is_admin = is_admin_context|default(false) %}

<header id="header" class="header fixed-top {{ is_admin or is_organisateur_context|default(false) ? 'navbar-admin-context' : '' }}">
    <div class="branding d-flex align-items-center {{ is_admin or is_organisateur_context|default(false) ? 'branding-admin' : '' }}">
        <div class="container position-relative d-flex align-items-center justify-content-between">
            {% if is_admin or is_organisateur_context|default(false) %}
                <button class="navbar-sidebar-toggle" type="button" data-admin-sidebar-toggle aria-label="Menu">
                    <i class="bi bi-list"></i>
                </button>
            {% endif %}

            <a href="{{ is_admin ? (is_granted('ROLE_ADMIN') ? path('app_admin_dashboard') : (is_granted('ROLE_SECRETAIRE') ? path('app_secretaire_index') : (is_granted('ROLE_MEDECIN') ? path('app_medecin_index') : (is_granted('ROLE_PATIENT') ? path('app_patient_index') : path('app_profile'))))) : (is_organisateur_context|default(false) ? path('app_evenement_index') : path('app_home')) }}" class="logo d-flex align-items-center">
                <img src="{{ asset('assets/img/logomed.png') }}" alt="Logo MediConnect" {{ is_admin ? 'height="32"' : '' }}>
                <h1 class="sitename">MediConnect</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    {% if not app.user %}
                    <li><a href="{{ path('app_home') }}" {% if app.request.get('_route') == 'app_home' %}class="active"{% endif %}>Accueil</a></li>
                    <li><a href="#!">À propos</a></li>
                    <li><a href="#!">Services</a></li>
                    <li><a href="#!">Contact</a></li>
                    <li><a href="{{ path('app_evenement_index') }}" {% if app.request.get('_route') starts with 'app_evenement_' %}class="active"{% endif %}><i class="bi bi-calendar-event me-1"></i>Événements</a></li>
                    {% endif %}
                    <li><a href="{{ path('app_catalogue') }}" {% if app.request.get('_route') starts with 'app_catalogue' or app.request.get('_route') starts with 'app_product' %}class="active"{% endif %}><i class="bi bi-shop me-1"></i>Catalogue</a></li>
                    <li><a href="{{ path('app_cart') }}" {% if app.request.get('_route') == 'app_cart' %}class="active"{% endif %}><i class="bi bi-cart me-1"></i>Panier</a></li>
                    {% if app.user %}
                    <li><a href="{{ path('app_evenement_index') }}" {% if app.request.get('_route') starts with 'app_evenement_' %}class="active"{% endif %}><i class="bi bi-calendar-event me-1"></i>Événements</a></li>
                    {% endif %}
                    {% if app.user %}
                        {# Savoir Médical (répondre aux quiz) : réservé aux patients #}
                        {% if is_granted('ROLE_PATIENT') %}
                        <li><a href="{{ path('app_savoir_medical_index') }}" {% if app.request.get('_route') starts with 'app_savoir_medical_' %}class="active"{% endif %}><i class="bi bi-book me-1"></i>Savoir Médical</a></li>
                        {% endif %}
                        {# Admin : lien vers tableau de bord #}
                        {% if is_granted('ROLE_ADMIN') %}
                        <li><a href="{{ path('app_admin_dashboard') }}" {% if app.request.get('_route') starts with 'app_admin_' %}class="active"{% endif %}><i class="bi bi-speedometer2 me-1"></i>Administration</a></li>
                        {% endif %}
                        {# Médecin : lien espace médecin (/medecin) #}
                        {% if is_granted('ROLE_MEDECIN') %}
                        <li><a href="{{ path('app_medecin_index') }}" {% if app.request.get('_route') starts with 'app_medecin_' %}class="active"{% endif %}><i class="bi bi-heart-pulse me-1"></i>Espace Médecin</a></li>
                        {% endif %}
                        {# Menu utilisateur style Bootstrap (Profile, Paramètres, Déconnexion) #}
                        <li class="nav-user-dropdown">
                            <div class="dropdown">
                                <button class="btn btn-user-dropdown d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar-profile me-2">
                                        {% if app.user.photo %}
                                            <img src="{{ asset(app.user.photo) }}" alt="{{ app.user.nomComplet }}" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,0.3);">
                                        {% else %}
                                            <i class="bi bi-person-circle"></i>
                                        {% endif %}
                                    </span>
                                    <span class="user-name-text d-none d-md-inline">{{ app.user.nomComplet }}</span>
                                    <i class="bi bi-chevron-down ms-1 dropdown-chevron"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi bi-person me-2"></i>Profil</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_settings') }}"><i class="bi bi-gear me-2"></i>Paramètres</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                                </ul>
                            </div>
                        </li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}" {% if app.request.get('_route') == 'app_login' %}class="active"{% endif %}>Connexion</a></li>
                        <li><a href="{{ path('app_signup') }}" class="btn-nav-signup {% if app.request.get('_route') == 'app_signup' %}active{% endif %}">S'inscrire</a></li>
                    {% endif %}
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>
        </div>
    </div>
</header>
