<aside class="admin-sidebar" id="admin-sidebar">
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <div class="sidebar-logo-wrap">
                <img src="{{ asset('assets/img/logomed.png') }}" alt="MediConnect" class="sidebar-logo">
            </div>
            <span class="sidebar-title">MediConnect</span>
        </div>
        <div class="sidebar-actions">
            <button type="button" class="sidebar-toggle-btn" id="sidebar-toggle-btn" aria-label="Reduire le menu" title="Reduire le menu">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>
    </div>

    <div class="sidebar-search">
        <div class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" class="form-control search-input" id="sidebar-search" placeholder="Rechercher..." aria-label="Rechercher dans le menu">
        </div>
    </div>

    <div class="sidebar-content">
        <nav class="sidebar-nav">
            <div class="sidebar-section">
                <span class="sidebar-section-title">Espace Medecin</span>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_medecin_index' ? 'active' : '' }}" href="{{ path('app_medecin_index') }}" title="Tableau de bord medecin">
                            <span class="nav-icon-wrap"><i class="bi bi-house-door"></i></span>
                            <span class="nav-text">Tableau de bord</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'app_savoir_medical' ? 'active' : '' }}" href="{{ path('app_savoir_medical_index') }}" title="Savoir Médical">
                            <span class="nav-icon-wrap"><i class="bi bi-book"></i></span>
                            <span class="nav-text">Savoir Médical</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'app_medecin_agenda' ? 'active' : '' }}" href="{{ path('app_medecin_agenda') }}" title="Mon Agenda">
                            <span class="nav-icon-wrap"><i class="bi bi-calendar-range"></i></span>
                            <span class="nav-text">Mon Agenda</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'app_medecin_secretaire' or app.request.get('_route') == 'app_medecin_secretaires' ? 'active' : '' }}" href="{{ path('app_medecin_secretaires') }}" title="Secretaires">
                            <span class="nav-icon-wrap"><i class="bi bi-person-badge"></i></span>
                            <span class="nav-text">Mes secretaires</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'app_medecin_rendez_vous' or app.request.get('_route') starts with 'app_medecin_rdv_' ? 'active' : '' }}" href="{{ path('app_medecin_rendez_vous') }}" title="Rendez-vous">
                            <span class="nav-icon-wrap"><i class="bi bi-calendar-event"></i></span>
                            <span class="nav-text">Rendez-vous</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'app_medecin_consultation' or app.request.get('_route') starts with 'app_medecin_consultations' or app.request.get('_route') starts with 'app_medecin_ordonnance' or app.request.get('_route') starts with 'app_medecin_rapport' ? 'active' : '' }}" href="{{ path('app_medecin_consultations') }}" title="Consultations">
                            <span class="nav-icon-wrap"><i class="bi bi-clipboard2-pulse"></i></span>
                            <span class="nav-text">Consultations</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-section">
                <span class="sidebar-section-title">Outils</span>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'app_notifications' ? 'active' : '' }}" href="{{ path('app_notifications_index') }}" title="Mes notifications">
                            <span class="nav-icon-wrap">
                                <i class="bi bi-bell"></i>
                                {% set unreadCount = app.user ? notification_service.compterNotificationsNonLues(app.user) : 0 %}
                                {% if unreadCount > 0 %}
                                    <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle" style="font-size: 0.65rem;">
                                        {{ unreadCount > 9 ? '9+' : unreadCount }}
                                    </span>
                                {% endif %}
                            </span>
                            <span class="nav-text">Notifications</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_drug_checker_index' ? 'active' : '' }}" href="{{ path('app_drug_checker_index') }}" title="Vérificateur d'interactions médicamenteuses">
                            <span class="nav-icon-wrap"><i class="bi bi-capsule"></i></span>
                            <span class="nav-text">Vérif. Médicaments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_translation_index' ? 'active' : '' }}" href="{{ path('app_translation_index') }}" title="Traduction de contenu médical">
                            <span class="nav-icon-wrap"><i class="bi bi-translate"></i></span>
                            <span class="nav-text">Traduction</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-section">
                <span class="sidebar-section-title">Compte</span>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_profile' ? 'active' : '' }}" href="{{ path('app_profile') }}" title="Profil">
                            <span class="nav-icon-wrap"><i class="bi bi-person-circle"></i></span>
                            <span class="nav-text">Profil</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_settings' ? 'active' : '' }}" href="{{ path('app_settings') }}" title="Parametres">
                            <span class="nav-icon-wrap"><i class="bi bi-gear"></i></span>
                            <span class="nav-text">Parametres</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <div class="sidebar-footer">
        <div class="sidebar-version">Medecin</div>
        <div class="sidebar-collapsed-hint" title="Cliquez pour agrandir">
            <i class="bi bi-layout-sidebar-inset"></i>
        </div>
    </div>
</aside>

<button type="button" class="sidebar-open-btn" id="sidebar-open-btn" aria-label="Ouvrir le menu" title="Ouvrir le menu">
    <i class="bi bi-list"></i>
</button>

<div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>
