{% extends 'base.html.twig' %}
{% block title %}{{ produit.nom }} - MediConnect{% endblock %}
{% block body %}
<style>
.review-stars-display i { color: #f7b500; margin-right: 2px; }
.review-stars-input { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 6px; }
.review-stars-input input { display: none; }
.review-stars-input label { font-size: 1.6rem; color: #cfd4da; cursor: pointer; transition: color 0.2s ease; }
.review-stars-input label:hover, .review-stars-input label:hover ~ label, .review-stars-input input:checked ~ label { color: #f7b500; }
</style>
<div class="container py-5">
    <div class="row">
        <div class="col-lg-6">
            {% if produit.image %}
                {% set imgPath = (produit.image starts with('http') or produit.image starts with('/') or produit.image starts with('assets') or produit.image starts with('uploads')) ? produit.image : ('assets/img/' ~ produit.image) %}
                <img src="{{ asset(imgPath) }}" class="img-fluid rounded w-100" style="height: 400px; object-fit: cover;" alt="{{ produit.nom }}">
            {% else %}
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 400px;"><i class="bi bi-image text-muted" style="font-size: 5rem;"></i></div>
            {% endif %}
        </div>
        <div class="col-lg-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_catalogue') }}">Catalogue</a></li>
                    {% if produit.categorie %}<li class="breadcrumb-item"><a href="{{ path('app_catalogue_categorie', {id: produit.categorie.id}) }}">{{ produit.categorie.nom }}</a></li>{% endif %}
                    <li class="breadcrumb-item active">{{ produit.nom }}</li>
                </ol>
            </nav>
            <h1 class="mb-3">{{ produit.nom }}</h1>
            <div class="mb-3">
                <div class="review-stars-display d-inline-flex align-items-center">
                    {% set roundedAverage = moyenneNote is defined and moyenneNote is not null ? moyenneNote|round(0, 'common') : 0 %}
                    {% for i in 1..5 %}<i class="bi {{ i <= roundedAverage ? 'bi-star-fill' : 'bi-star' }}"></i>{% endfor %}
                    <span class="ms-2 fw-semibold">
                        {% if moyenneNote is defined and moyenneNote is not null %}{{ moyenneNote|number_format(1, ',', ' ') }}/5{% else %}Pas encore de note{% endif %}
                    </span>
                    <span class="ms-2 text-muted">({{ avis|length }} avis)</span>
                </div>
            </div>
            {% if produit.videoUrl %}
                <div class="mb-3">
                    <div class="card border-0">
                        <div class="card-body p-0">
                            <h3 class="h6 mb-2"><i class="bi bi-play-circle me-1"></i>Vidéo de présentation</h3>
                            {% set v = produit.videoUrl %}
                            {% if v ends with('.mp4') or v ends with('.webm') or v ends with('.ogg') %}
                                {% set videoPath = (v starts with('http') or v starts with('/')) ? v : asset(v) %}
                                <video controls class="w-100 rounded" style="max-height: 220px;">
                                    <source src="{{ videoPath }}">
                                    Votre navigateur ne supporte pas la lecture vidéo.
                                </video>
                            {% else %}
                                <div class="ratio ratio-16x9" style="max-width: 100%; max-height: 220px;">
                                    <iframe src="{{ v }}" title="Vidéo produit" allowfullscreen loading="lazy"></iframe>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
            {% if produit.categorie %}<span class="badge bg-info mb-3">{{ produit.categorie.nom }}</span>{% endif %}
            {% if produit.description %}<p class="text-muted">{{ produit.description|raw }}</p>{% endif %}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title mb-3">{{ produit.prix|number_format(2, ',', ' ') }} TND</h2>
                    <p class="mb-2"><strong>Stock disponible:</strong> <span class="{{ produit.stock > 0 ? 'text-success' : 'text-danger' }}">{{ produit.stock }} unité(s)</span>
                        {% if produit.stock > 0 and produit.stock <= 5 %}<span class="badge bg-warning text-dark ms-2">Dépêche-toi, bientôt en rupture</span>{% endif %}
                    </p>
                    {% if produit.stock > 0 %}
                    <form id="addToCartForm">
                        <div class="mb-3">
                            <label for="quantity" class="form-label">Quantité:</label>
                            <div class="input-group" style="max-width: 150px;">
                                <button class="btn btn-outline-secondary" type="button" id="decreaseQty">−</button>
                                <input type="number" class="form-control text-center" id="quantity" name="quantity" value="1" min="1" max="{{ produit.stock }}">
                                <button class="btn btn-outline-secondary" type="button" id="increaseQty">+</button>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-lg btn-primary w-100 mb-2"><i class="bi bi-cart-plus"></i> Ajouter au panier</button>
                    </form>
                    {% else %}
                    <button class="btn btn-lg btn-secondary w-100" disabled>Stock épuisé</button>
                    {% endif %}
                    <a href="{{ path('app_catalogue') }}" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-left"></i> Retour au catalogue</a>
                </div>
            </div>
            <a href="{{ path('app_cart') }}" class="btn btn-outline-info w-100"><i class="bi bi-cart3"></i> Voir le panier <span class="badge bg-danger" id="cartBadge">{{ cartCount }}</span></a>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-lg-8">
            {% for type, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}<div class="alert alert-{{ type == 'error' ? 'danger' : type }} mb-3">{{ message }}</div>{% endfor %}
            {% endfor %}
            {% set monAvis = null %}
            {% if app.user %}
                {% for item in avis %}
                    {% if item.utilisateur and item.utilisateur.id == app.user.id %}{% set monAvis = item %}{% endif %}
                {% endfor %}
            {% endif %}
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-3">{{ monAvis ? 'Modifier mon avis' : 'Ajouter un avis' }}</h3>
                    {% if app.user %}
                    <form method="post" action="{{ path('app_product_review_add', {id: produit.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('product_review_' ~ produit.id) }}">
                        <div class="mb-3">
                            <label class="form-label d-block">Note</label>
                            <div class="review-stars-input">
                                {% for i in 5..1 %}
                                <input type="radio" id="note_{{ i }}" name="note" value="{{ i }}" {{ (monAvis and monAvis.note == i) or (not monAvis and i == 5) ? 'checked' : '' }}>
                                <label for="note_{{ i }}" title="{{ i }}/5">★</label>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="commentaire" class="form-label">Commentaire</label>
                            <textarea id="commentaire" name="commentaire" rows="4" class="form-control" maxlength="1000" placeholder="Partagez votre expérience avec ce produit...">{{ monAvis ? monAvis.commentaire : '' }}</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">{{ monAvis ? 'Mettre à jour' : 'Publier' }}</button>
                    </form>
                    {% else %}
                    <p class="mb-0">Connectez-vous pour laisser un commentaire et une note. <a href="{{ path('app_login') }}">Se connecter</a></p>
                    {% endif %}
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h3 class="h5 mb-3">Commentaires ({{ avis|length }})</h3>
                    {% if avis is empty %}
                    <p class="text-muted mb-0">Aucun commentaire pour le moment.</p>
                    {% else %}
                    {% for item in avis %}
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>{{ item.utilisateur ? item.utilisateur.nomComplet : 'Utilisateur' }}</strong>
                                <div class="review-stars-display mt-1">{% for i in 1..5 %}<i class="bi {{ i <= item.note ? 'bi-star-fill' : 'bi-star' }}"></i>{% endfor %}</div>
                                <small class="text-muted">{{ item.dateCreation ? item.dateCreation|date('d/m/Y H:i') : '' }}</small>
                            </div>
                            {% if app.user and (item.utilisateur and item.utilisateur.id == app.user.id or is_granted('ROLE_ADMIN')) %}
                            <form method="post" action="{{ path('app_product_review_delete', {id: produit.id, avisId: item.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ item.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                            {% endif %}
                        </div>
                        {% if item.commentaire %}<p class="mb-0 mt-2">{{ item.commentaire|nl2br }}</p>{% endif %}
                    </div>
                    {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<script>
(function(){
    var quantityInput = document.getElementById('quantity');
    var decreaseBtn = document.getElementById('decreaseQty');
    var increaseBtn = document.getElementById('increaseQty');
    var form = document.getElementById('addToCartForm');
    var maxStock = {{ produit.stock }};
    if (!quantityInput || !form) return;
    if (decreaseBtn) decreaseBtn.addEventListener('click', function(){ var v = parseInt(quantityInput.value,10); if(v>1) quantityInput.value = v-1; });
    if (increaseBtn) increaseBtn.addEventListener('click', function(){ var v = parseInt(quantityInput.value,10); if(v<maxStock) quantityInput.value = v+1; });
    function showNotification(msg, type){
        var cls = type==='success' ? 'alert-success' : 'alert-danger';
        var el = document.createElement('div');
        el.className = 'alert ' + cls + ' alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3';
        el.style.zIndex = '9999';
        el.innerHTML = msg + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
        document.body.appendChild(el);
        setTimeout(function(){ el.remove(); }, 3000);
    }
    form.addEventListener('submit', function(e){
        e.preventDefault();
        var qty = parseInt(quantityInput.value,10) || 1;
        var fd = new FormData(); fd.append('quantity', qty);
        fetch('{{ path('app_cart_add', {id: produit.id}) }}', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r){ return r.json(); })
            .then(function(d){
                if (d.success) {
                    var badge = document.getElementById('cartBadge');
                    if (badge) badge.textContent = d.cartCount;
                    showNotification(d.message || 'Produit ajouté au panier', 'success');
                    quantityInput.value = 1;

                    // Proposer d'aller au panier ou de continuer les achats
                    setTimeout(function () {
                        if (window.confirm('Produit ajouté au panier.\n\nVoulez-vous aller au panier ?\nCliquez sur \"OK\" pour voir le panier, ou \"Annuler\" pour continuer vos achats.')) {
                            window.location.href = '{{ path('app_cart') }}';
                        }
                    }, 300);
                } else {
                    showNotification(d.error || 'Erreur', 'error');
                }
            })
            .catch(function(){ showNotification('Erreur lors de la requête', 'error'); });
    });
})();
</script>
{% endblock %}
