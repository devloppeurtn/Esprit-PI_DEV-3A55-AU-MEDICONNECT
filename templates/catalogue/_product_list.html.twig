<div class="row g-4">
    {% if produits|length > 0 %}
        {% for produit in produits %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    {% if produit.image %}
                        {% set imgPath = (produit.image starts with('http') or produit.image starts with('/') or produit.image starts with('assets') or produit.image starts with('uploads')) ? produit.image : ('assets/img/' ~ produit.image) %}
                        <img src="{{ asset(imgPath) }}" class="card-img-top" alt="{{ produit.nom }}" style="height: 200px; object-fit: cover;">
                    {% else %}
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;"><i class="bi bi-image text-muted" style="font-size: 3rem;"></i></div>
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ produit.nom }}</h5>
                        <p class="card-text text-muted small">{{ produit.description|slice(0, 80) }}{% if produit.description|length > 80 %}...{% endif %}</p>
                        {% if produit.categorie %}<span class="badge bg-info mb-2">{{ produit.categorie.nom }}</span>{% endif %}
                        <div class="mt-3">
                            <p class="h5 mb-2">{{ produit.prix|number_format(2, ',', ' ') }} TND</p>
                            <p class="text-muted small"><i class="bi bi-box"></i> Stock: <strong class="{{ produit.stock > 0 ? 'text-success' : 'text-danger' }}">{{ produit.stock }}</strong></p>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top">
                        <div class="d-grid gap-2">
                            {% if produit.stock > 0 %}
                                <button class="btn btn-primary btn-sm add-to-cart" data-product-id="{{ produit.id }}" data-product-name="{{ produit.nom }}"><i class="bi bi-cart-plus"></i> Ajouter au panier</button>
                                <a href="{{ path('app_product_detail', {id: produit.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i> Voir détails</a>
                            {% else %}
                                <button class="btn btn-secondary btn-sm" disabled>Stock épuisé</button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="col-12"><div class="alert alert-info text-center"><i class="bi bi-info-circle me-2"></i>Aucun produit trouvé</div></div>
    {% endif %}
</div>
<div class="modal fade" id="cartModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Produit ajouté au panier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="productAddedMsg"></p>
                <p class="text-muted">Que voulez-vous faire ?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Continuer</button>
                <a href="{{ path('app_cart') }}" class="btn btn-primary">Aller au panier</a>
            </div>
        </div>
    </div>
</div>
<script>
document.querySelectorAll('.add-to-cart').forEach(function(btn){
    btn.addEventListener('click', function(){
        var id = this.dataset.productId;
        var name = this.dataset.productName;
        var formData = new FormData();
        formData.append('quantity', 1);
        fetch('{{ path('app_cart_add', {id: 0}) }}'.replace('0', id), { method: 'POST', body: formData, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r){ return r.json(); })
            .then(function(data){
                if (data.success) {
                    var badge = document.getElementById('cartBadge');
                    if (badge) badge.textContent = data.cartCount;
                    var msg = document.getElementById('productAddedMsg');
                    if (msg) msg.textContent = name + ' a été ajouté au panier !';
                    var modal = document.getElementById('cartModal');
                    if (modal && typeof bootstrap !== 'undefined') new bootstrap.Modal(modal).show();
                }
            });
    });
});
</script>
