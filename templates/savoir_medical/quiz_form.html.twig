{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter une Question - {{ cours.titre }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow">
                <div class="card-body p-4 p-lg-5">
                    <h2 class="mb-4">Ajouter une Question de Quiz</h2>
                    <p class="text-muted mb-4">Pour le cours : <strong>{{ cours.titre }}</strong></p>
                    
                    <form method="post">
                        <div class="mb-4">
                            <label for="enonce" class="form-label fw-bold">Question <span class="text-danger">*</span></label>
                            <div class="translation-widget" data-widget-id="question-form">
                                <div class="d-flex justify-content-end mb-2">
                                    <select class="form-select form-select-sm" style="width: auto;" id="translation-language-select-form">
                                        <option value="" disabled selected>Traduire / Translate /Traducir</option>
                                    </select>
                                    <button class="btn btn-sm btn-primary ms-2" id="translate-btn-form">
                                        <i class="bi bi-translate me-1"></i>Traduire
                                    </button>
                                </div>
                                
                                <div class="alert alert-info" id="translation-alert-form" style="display: none;">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <span id="translation-message-form"></span>
                                </div>
                                
                                <div class="mt-2" id="translated-content-form" style="display: none;">
                                    <hr>
                                    <h6 class="fw-bold">
                                        <i class="bi bi-translate me-1"></i>Traduction:
                                    </h6>
                                    <div id="translation-result-form"></div>
                                </div>
                            </div>
                            <textarea class="form-control form-control-lg" id="enonce" name="enonce" rows="3" required 
                                      placeholder="Posez votre question ici...">{{ question ? question.enonce : '' }}</textarea>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold">Options de réponse <span class="text-danger">*</span></label>
                            <div class="mb-2">
                                <input type="text" class="form-control" name="option1" placeholder="Option A" required>
                            </div>
                            <div class="mb-2">
                                <input type="text" class="form-control" name="option2" placeholder="Option B" required>
                            </div>
                            <div class="mb-2">
                                <input type="text" class="form-control" name="option3" placeholder="Option C" required>
                            </div>
                            <div class="mb-2">
                                <input type="text" class="form-control" name="option4" placeholder="Option D" required>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label for="reponseCorrecte" class="form-label fw-bold">Réponse correcte <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="reponseCorrecte" name="reponseCorrecte" required 
                                   placeholder="Entrez exactement la réponse correcte (doit correspondre à une des options)">
                            <small class="text-muted">Copiez-collez exactement l'option correcte ci-dessus</small>
                        </div>
                        
                        <div class="mb-4">
                            <label for="explication" class="form-label fw-bold">Explication (optionnel)</label>
                            <textarea class="form-control" id="explication" name="explication" rows="3" 
                                      placeholder="Expliquez pourquoi cette r�ponse est correcte...">{{ question ? question.explication : '' }}</textarea>
                        </div>
                        
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Note :</strong> Cette question sera automatiquement validée et disponible pour les patients.
                        </div>
                        
                        <div class="d-flex gap-2 justify-content-end">
                            <a href="{{ path('app_quiz_gerer', {coursId: cours.id}) }}" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-2"></i>Annuler
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Ajouter la question
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

<script>
// Translation widget functionality for quiz_form
document.addEventListener('DOMContentLoaded', function() {
    const widgetId = 'question-form';
    const languageSelect = document.getElementById('translation-language-select-form');
    const translateBtn = document.getElementById('translate-btn-form');
    const translatedContent = document.getElementById('translated-content-form');
    const translationResult = document.getElementById('translation-result-form');
    const translationAlert = document.getElementById('translation-alert-form');
    const translationMessage = document.getElementById('translation-message-form');
    const originalContent = document.getElementById('enonce');

    if (!languageSelect || !originalContent) return;

    // Load supported languages
    fetch('{{ path("app_translation_languages") }}')
        .then(r => r.json())
        .then(data => {
            languageSelect.innerHTML = '<option value="" disabled selected>Traduire / Translate /Traducir</option>';
            Object.entries(data.languages).forEach(([code, name]) => {
                const option = document.createElement('option');
                option.value = code;
                option.textContent = name;
                languageSelect.appendChild(option);
            });
        })
        .catch(err => console.error('Failed to load languages:', err));

    translateBtn.addEventListener('click', async function() {
        const targetLanguage = languageSelect.value;
        if (!targetLanguage) {
            translationMessage.textContent = 'Veuillez sélectionner une langue cible';
            translationAlert.className = 'alert alert-warning';
            translationAlert.style.display = 'block';
            return;
        }

        const textToTranslate = originalContent.value;

        if (!textToTranslate.trim()) {
            translationMessage.textContent = 'Le contenu est vide';
            translationAlert.className = 'alert alert-warning';
            translationAlert.style.display = 'block';
            return;
        }

        translateBtn.disabled = true;
        translateBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Traduction en cours...';

        try {
            const response = await fetch('{{ path("app_translation_translate") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    text: textToTranslate,
                    targetLanguage: targetLanguage,
                    sourceLanguage: 'auto'
                })
            });

            const result = await response.json();

            if (response.ok && result.translated) {
                translationResult.innerHTML = result.translated;
                translatedContent.style.display = 'block';
                translationMessage.textContent = 'Traduction réussie!';
                translationAlert.className = 'alert alert-success';
                translationAlert.style.display = 'block';
            } else {
                translationMessage.textContent = 'Échec de la traduction: ' + (result.error || 'Erreur inconnue');
                translationAlert.className = 'alert alert-danger';
                translationAlert.style.display = 'block';
            }
        } catch (error) {
            translationMessage.textContent = 'Erreur de connexion: ' + error.message;
            translationAlert.className = 'alert alert-danger';
            translationAlert.style.display = 'block';
        } finally {
            translateBtn.disabled = false;
            translateBtn.innerHTML = '<i class="bi bi-translate me-1"></i>Traduire';
        }

        setTimeout(() => {
            translationAlert.style.display = 'none';
        }, 5000);
    });
});
</script>
