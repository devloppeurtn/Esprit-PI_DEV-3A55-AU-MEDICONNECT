{% extends 'base.html.twig' %}

{% block title %}{{ categorie.nom }} - MediConnect{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <style>
        .category-header {
            background: linear-gradient(135deg, #175cdd 0%, #1a4db5 100%);
            color: white;
            padding: 3rem 0;
            margin-bottom: 2rem;
        }
        
        .cours-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: all 0.3s;
            height: 100%;
        }
        
        .cours-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
        
        .progression-summary {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            position: sticky;
            top: 120px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="category-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <a href="{{ path('app_savoir_medical_index') }}" class="btn btn-light btn-sm mb-3">
                    <i class="bi bi-arrow-left me-1"></i>Retour
                </a>
                <h1 class="display-4 mb-2">{{ categorie.nom }}</h1>
                <p class="lead mb-0">{{ categorie.description }}</p>
            </div>
            {% if is_granted('ROLE_MEDECIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_savoir_medical_modifier_categorie', {id: categorie.id}) }}" class="btn btn-outline-light">
                        <i class="bi bi-pencil me-2"></i>Modifier la catégorie
                    </a>
                    <form method="post" action="{{ path('app_savoir_medical_supprimer_categorie', {id: categorie.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ? Tous les cours associés seront également supprimés. Cette action est irréversible.')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-2"></i>Supprimer
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row">
        <div class="col-lg-8">
            <h3 class="mb-4">Cours disponibles</h3>
            
            {% if cours is empty %}
                <div class="text-center py-5">
                    <i class="bi bi-book" style="font-size: 4rem; color: #e9ecef;"></i>
                    <h5 class="mt-3 text-muted">Aucun cours disponible</h5>
                    <p class="text-muted">Les cours seront bientôt ajoutés</p>
                </div>
            {% else %}
                <div class="row g-4">
                    {% for coursItem in cours %}
                        <div class="col-md-6">
                            <div class="card cours-card">
                                <div class="card-body">
                                    <h5 class="card-title fw-bold">{{ coursItem.titre }}</h5>
                                    <p class="card-text text-muted small">
                                        {{ coursItem.contenu|length > 150 ? coursItem.contenu|slice(0, 150) ~ '...' : coursItem.contenu }}
                                    </p>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <div>
                                            <small class="text-muted">
                                                <i class="bi bi-question-circle me-1"></i>
                                                {{ coursItem.questions|length }} questions
                                            </small>
                                            <br>
                                            <small class="text-muted">
                                                <i class="bi bi-trophy me-1"></i>
                                                {{ coursItem.scorePourBadge }} pts pour badge
                                            </small>
                                        </div>
                                        <a href="{{ path('app_savoir_medical_cours', {id: coursItem.id}) }}" class="btn btn-primary btn-sm">
                                            Commencer
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        
        <div class="col-lg-4">
            <div class="progression-summary">
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-graph-up text-primary me-2"></i>
                    Ma progression
                </h5>
                
                {% if progression %}
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Score maximum</span>
                            <strong class="text-primary">{{ progression.scoreMax }}</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Nombre de tentatives</span>
                            <strong>{{ progression.nbTentatives }}</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Statut</span>
                            {% if progression.estComplete %}
                                <span class="badge bg-success">Complété</span>
                            {% elseif progression.scoreMax > 0 %}
                                <span class="badge bg-warning">En cours</span>
                            {% else %}
                                <span class="badge bg-secondary">Non commencé</span>
                            {% endif %}
                        </div>
                    </div>
                    
                    {% if progression.badgeNom %}
                        <div class="alert alert-warning mb-3">
                            <h6 class="alert-heading">
                                <i class="bi bi-trophy-fill me-2"></i>Badge obtenu !
                            </h6>
                            <p class="mb-0"><strong>{{ progression.badgeNom }}</strong></p>
                            {% if progression.dateObtention %}
                                <small class="text-muted">Le {{ progression.dateObtention|date('d/m/Y') }}</small>
                            {% endif %}
                        </div>
                    {% endif %}
                {% else %}
                    <div class="text-center py-4">
                        <i class="bi bi-clipboard-data" style="font-size: 3rem; color: #e9ecef;"></i>
                        <p class="text-muted mt-3">Vous n'avez pas encore commencé cette catégorie</p>
                    </div>
                {% endif %}
                
                <div class="d-grid gap-2 mt-4">
                    <a href="{{ path('app_progression_utilisateur') }}" class="btn btn-outline-primary">
                        <i class="bi bi-bar-chart me-2"></i>Voir toute ma progression
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
