{% extends 'base.html.twig' %}

{% block title %}Catégories en attente d'approbation{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-clock-history"></i> Catégories en attente d'approbation</h1>
        <a href="{{ path('app_savoir_medical_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if categories is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Aucune catégorie en attente d'approbation.
        </div>
    {% else %}
        {# Summary Statistics #}
        {% set categoriesWithoutName = categories|filter(c => c.nom is empty or c.nom|trim == '') %}
        {% set categoriesAlreadyApproved = categories|filter(c => c.statut.value == 'APPROUVE') %}
        {% set categoriesCanBeApproved = categories|filter(c => (c.nom is not empty and c.nom|trim != '') and c.statut.value != 'APPROUVE') %}
        
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="alert alert-light border">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <div class="p-3">
                                <h3 class="mb-0">{{ categories|length }}</h3>
                                <small class="text-muted">Total catégories</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border-start">
                                <h3 class="mb-0 text-success">{{ categoriesCanBeApproved|length }}</h3>
                                <small class="text-muted"><i class="bi bi-check-circle"></i> Prêtes à approuver</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border-start">
                                <h3 class="mb-0 text-danger">{{ categoriesWithoutName|length }}</h3>
                                <small class="text-muted"><i class="bi bi-exclamation-triangle"></i> Sans nom</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border-start">
                                <h3 class="mb-0 text-info">{{ categoriesAlreadyApproved|length }}</h3>
                                <small class="text-muted"><i class="bi bi-check-circle-fill"></i> Déjà approuvées</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row mb-4">
            <div class="col-md-6 mx-auto">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" 
                           class="form-control" 
                           id="searchCategories" 
                           placeholder="Rechercher une catégorie par nom ou médecin..."
                           autocomplete="off">
                    <button class="btn btn-outline-secondary" type="button" id="clearSearch">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div id="searchResults" class="mt-2 text-muted small text-center"></div>
            </div>
        </div>
        
        <div class="row" id="categoriesContainer">
            {% for categorie in categories %}
                <div class="col-md-6 mb-4 category-item" 
                     data-category-name="{{ categorie.nom|lower }}" 
                     data-category-type="{{ categorie.type|lower }}"
                     data-creator-name="{{ categorie.creePar ? categorie.creePar.nomComplet|lower : '' }}">
                    <div class="card h-100 shadow-sm {{ categorie.nom is empty or categorie.nom|trim == '' ? 'border-danger' : '' }} {{ categorie.statut.value == 'APPROUVE' ? 'border-success' : '' }}">
                        <div class="card-header {{ categorie.nom is empty or categorie.nom|trim == '' ? 'bg-danger text-white' : (categorie.statut.value == 'APPROUVE' ? 'bg-success text-white' : 'bg-warning text-dark') }}">
                            <h5 class="mb-0">
                                <i class="bi bi-folder"></i> 
                                {% if categorie.nom is empty or categorie.nom|trim == '' %}
                                    <span class="text-decoration-line-through">(Sans nom)</span>
                                    <i class="bi bi-exclamation-triangle-fill ms-2" title="Cette catégorie n'a pas de nom"></i>
                                {% else %}
                                    {{ categorie.nom }}
                                {% endif %}
                                <span class="badge {{ categorie.statut.badgeClass }} float-end">
                                    {{ categorie.statut.label }}
                                </span>
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if categorie.nom is empty or categorie.nom|trim == '' %}
                                <div class="alert alert-danger mb-3">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>Attention:</strong> Cette catégorie ne peut pas être approuvée car elle n'a pas de nom. 
                                    Veuillez demander au médecin de modifier la catégorie pour ajouter un nom.
                                </div>
                            {% endif %}
                            
                            {% if categorie.statut.value == 'APPROUVE' %}
                                <div class="alert alert-success mb-3">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <strong>Déjà approuvée:</strong> Cette catégorie a été approuvée le 
                                    <strong>{{ categorie.dateApprobation|date('d/m/Y à H:i') }}</strong>
                                    {% if categorie.approuvePar %}
                                        par <strong>{{ categorie.approuvePar.nomComplet }}</strong>
                                    {% endif %}.
                                </div>
                            {% endif %}
                            
                            <p class="card-text">{{ categorie.description }}</p>
                            
                            <div class="mb-3">
                                <strong>Type:</strong> 
                                <span class="badge bg-info">{{ categorie.type }}</span>
                            </div>

                            {% if categorie.creePar %}
                                <div class="mb-3">
                                    <strong>Créé par:</strong> 
                                    <span class="text-muted">
                                        <i class="bi bi-person"></i> {{ categorie.creePar.nomComplet }}
                                    </span>
                                </div>
                            {% endif %}

                            {% if categorie.coursEducatifs|length > 0 %}
                                <div class="mb-3">
                                    <strong>Nombre de cours:</strong> 
                                    <span class="badge bg-primary">{{ categorie.coursEducatifs|length }}</span>
                                    <button class="btn btn-sm btn-outline-primary ms-2" type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#preview-{{ categorie.id }}" 
                                            aria-expanded="false">
                                        <i class="bi bi-eye"></i> Prévisualiser le contenu
                                    </button>
                                </div>
                                
                                {# Collapsible preview section #}
                                <div class="collapse" id="preview-{{ categorie.id }}">
                                    <div class="card card-body bg-light mb-3">
                                        <h6 class="text-primary"><i class="bi bi-book-half"></i> Contenu des cours</h6>
                                        {% for cours in categorie.coursEducatifs %}
                                            <div class="mb-4 pb-3 border-bottom">
                                                <h6 class="fw-bold">
                                                    <i class="bi bi-book"></i> {{ cours.titre }}
                                                </h6>
                                                
                                                <div class="mb-3">
                                                    <strong>Contenu du cours:</strong>
                                                    <div class="p-3 bg-white rounded border mt-2" style="max-height: 300px; overflow-y: auto;">
                                                        {{ cours.contenu|nl2br }}
                                                    </div>
                                                </div>
                                                
                                                {% set questions = cours.questions %}
                                                {% if questions|length > 0 %}
                                                    <div class="mt-3">
                                                        <strong>Questions du quiz ({{ questions|length }}):</strong>
                                                        <div class="accordion accordion-flush mt-2" id="quiz-{{ cours.id }}">
                                                            {% for question in questions %}
                                                                <div class="accordion-item">
                                                                    <h2 class="accordion-header">
                                                                        <button class="accordion-button collapsed" type="button" 
                                                                                data-bs-toggle="collapse" 
                                                                                data-bs-target="#question-{{ question.id }}" 
                                                                                aria-expanded="false">
                                                                            <span class="badge {{ question.statut.value == 'VALIDE_MEDECIN' ? 'bg-success' : 'bg-warning' }} me-2">
                                                                                {{ question.statut.label }}
                                                                            </span>
                                                                            Question {{ loop.index }}: {{ question.enonce|slice(0, 80) }}{{ question.enonce|length > 80 ? '...' : '' }}
                                                                        </button>
                                                                    </h2>
                                                                    <div id="question-{{ question.id }}" class="accordion-collapse collapse" data-bs-parent="#quiz-{{ cours.id }}">
                                                                        <div class="accordion-body bg-white">
                                                                            <p class="fw-bold">{{ question.enonce }}</p>
                                                                            
                                                                            <div class="mb-3">
                                                                                <strong>Options de réponse:</strong>
                                                                                <ul class="list-group mt-2">
                                                                                    {% for option in question.optionsReponsesArray %}
                                                                                        <li class="list-group-item {{ option == question.reponseCorrecte ? 'list-group-item-success' : '' }}">
                                                                                            {{ option }}
                                                                                            {% if option == question.reponseCorrecte %}
                                                                                                <span class="badge bg-success float-end">
                                                                                                    <i class="bi bi-check-circle"></i> Réponse correcte
                                                                                                </span>
                                                                                            {% endif %}
                                                                                        </li>
                                                                                    {% endfor %}
                                                                                </ul>
                                                                            </div>
                                                                            
                                                                            {% if question.explication %}
                                                                                <div class="alert alert-info mb-0">
                                                                                    <strong><i class="bi bi-info-circle"></i> Explication:</strong><br>
                                                                                    {{ question.explication }}
                                                                                </div>
                                                                            {% endif %}
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            {% endfor %}
                                                        </div>
                                                    </div>
                                                {% else %}
                                                    <div class="alert alert-warning mt-2 mb-0">
                                                        <i class="bi bi-exclamation-triangle"></i> Aucune question de quiz pour ce cours
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle"></i> Cette catégorie ne contient aucun cours
                                </div>
                            {% endif %}
                        </div>
                        <div class="card-footer bg-light">
                            {# Validation Summary Box #}
                            {% set hasNoName = categorie.nom is empty or categorie.nom|trim == '' %}
                            {% set isAlreadyApproved = categorie.statut.value == 'APPROUVE' %}
                            {% set canBeApproved = not hasNoName and not isAlreadyApproved %}
                            
                            {% if not canBeApproved %}
                                <div class="alert alert-{{ hasNoName ? 'danger' : 'info' }} mb-3 py-2">
                                    <small>
                                        <i class="bi bi-{{ hasNoName ? 'x-circle' : 'info-circle' }}-fill me-1"></i>
                                        <strong>Impossible d'approuver:</strong>
                                        {% if hasNoName %}
                                            Le nom de la catégorie est vide
                                        {% elseif isAlreadyApproved %}
                                            Catégorie déjà approuvée le {{ categorie.dateApprobation|date('d/m/Y') }}
                                        {% endif %}
                                    </small>
                                </div>
                            {% endif %}
                            
                            <div class="d-flex justify-content-between gap-2">
                                <form method="post" action="{{ path('app_admin_approuver_categorie', {id: categorie.id}) }}" class="flex-fill">
                                    <button type="submit" 
                                            class="btn btn-success w-100 position-relative" 
                                            {% if not canBeApproved %}
                                                disabled 
                                                data-bs-toggle="tooltip" 
                                                data-bs-placement="top"
                                                title="{% if hasNoName %}❌ Nom manquant - Cette catégorie n'a pas de nom{% elseif isAlreadyApproved %}✓ Déjà approuvée le {{ categorie.dateApprobation|date('d/m/Y') }}{% endif %}"
                                            {% endif %}
                                            {% if canBeApproved %}
                                                onclick="return confirm('Approuver cette catégorie ?\n\nElle sera visible par tous les patients.')"
                                            {% endif %}>
                                        <i class="bi bi-{{ isAlreadyApproved ? 'check-circle' : 'check-circle' }}"></i> 
                                        {% if isAlreadyApproved %}
                                            Déjà approuvée
                                        {% elseif hasNoName %}
                                            Nom manquant
                                        {% else %}
                                            Approuver
                                        {% endif %}
                                    </button>
                                </form>
                                
                                <form method="post" action="{{ path('app_admin_rejeter_categorie', {id: categorie.id}) }}" class="flex-fill">
                                    <button type="submit" 
                                            class="btn btn-danger w-100" 
                                            {% if categorie.statut.value == 'APPROUVE' %}disabled title="Impossible de rejeter une catégorie déjà approuvée"{% endif %}
                                            onclick="return confirm('Rejeter cette catégorie ?\n\nLe médecin sera notifié du rejet.')">
                                        <i class="bi bi-x-circle"></i> Rejeter
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}


{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Bootstrap tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
    
    const searchInput = document.getElementById('searchCategories');
    const clearButton = document.getElementById('clearSearch');
    const searchResults = document.getElementById('searchResults');
    const categoryItems = document.querySelectorAll('.category-item');
    
    if (!searchInput) return;
    
    function performSearch() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;
        
        categoryItems.forEach(item => {
            const categoryName = item.getAttribute('data-category-name');
            const categoryType = item.getAttribute('data-category-type');
            const creatorName = item.getAttribute('data-creator-name');
            
            if (searchTerm === '' || 
                categoryName.includes(searchTerm) || 
                categoryType.includes(searchTerm) ||
                creatorName.includes(searchTerm)) {
                item.style.display = '';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });
        
        // Update results text
        if (searchTerm === '') {
            searchResults.textContent = '';
        } else {
            searchResults.textContent = `${visibleCount} catégorie${visibleCount > 1 ? 's' : ''} trouvée${visibleCount > 1 ? 's' : ''}`;
        }
    }
    
    // Search on input
    searchInput.addEventListener('input', performSearch);
    
    // Clear search
    clearButton.addEventListener('click', function() {
        searchInput.value = '';
        performSearch();
        searchInput.focus();
    });
    
    // Search on Enter key
    searchInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            performSearch();
        }
    });
});
</script>
{% endblock %}
