{% extends 'admin/base_admin.html.twig' %}

{% block title %}Aperçu Patient - {{ cours.titre }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="alert alert-info mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-info-circle me-2"></i>
                <strong>Mode Aperçu Médecin</strong> - Ceci est exactement ce que les patients verront
            </div>
            <a href="{{ path('app_quiz_gerer', {coursId: cours.id}) }}" class="btn btn-sm btn-primary">
                <i class="bi bi-arrow-left me-2"></i>Retour à la gestion
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg mb-4">
                <div class="card-body p-4">
                    <h2 class="mb-3">{{ cours.titre }}</h2>
                    <p class="text-muted mb-4">{{ cours.categorieSante.nom }}</p>
                    
                    <div class="alert alert-success">
                        <div class="row text-center">
                            <div class="col-md-6">
                                <div class="h4 mb-0">{{ questionsValidees|length }}</div>
                                <small>Questions disponibles</small>
                            </div>
                            <div class="col-md-6">
                                <div class="h4 mb-0">{{ cours.scorePourBadge }}</div>
                                <small>Points pour badge</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if questionsValidees is empty %}
                <div class="card border-0 shadow">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-inbox" style="font-size: 4rem; color: #e9ecef;"></i>
                        <h4 class="mt-4 text-muted">Aucune question publiée</h4>
                        <p class="text-muted mb-4">
                            Les patients ne verront pas ce quiz tant qu'aucune question n'est validée.
                        </p>
                        <a href="{{ path('app_quiz_gerer', {coursId: cours.id}) }}" class="btn btn-primary">
                            <i class="bi bi-magic me-2"></i>Générer et valider des questions
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="card border-0 shadow mb-4">
                    <div class="card-body p-4">
                        <h5 class="mb-4">
                            <i class="bi bi-list-check me-2"></i>
                            Questions que les patients verront
                        </h5>
                        
                        {% for question in questionsValidees %}
                            <div class="card mb-3 bg-light border-0">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h6 class="fw-bold mb-0">Question {{ loop.index }}</h6>
                                        <span class="badge bg-success">
                                            <i class="bi bi-eye me-1"></i>Visible
                                        </span>
                                    </div>
                                    <p class="mb-3" id="translation-content-question-{{ question.id }}">{{ question.enonce }}</p>
                                    
                                    <div class="translation-widget" data-widget-id="question-{{ question.id }}-preview">
                                        <div class="d-flex justify-content-end mb-2">
                                            <select class="form-select form-select-sm" style="width: auto;" id="translation-language-select-{{ question.id }}-preview">
                                                <option value="" disabled selected>Traduire / Translate /Traducir</option>
                                            </select>
                                            <button class="btn btn-sm btn-primary ms-2" id="translate-btn-{{ question.id }}-preview">
                                                <i class="bi bi-translate me-1"></i>Traduire
                                            </button>
                                        </div>
                                        
                                        <div class="alert alert-info" id="translation-alert-{{ question.id }}-preview" style="display: none;">
                                            <i class="bi bi-info-circle me-2"></i>
                                            <span id="translation-message-{{ question.id }}-preview"></span>
                                        </div>
                                        
                                        <div class="mt-2" id="translated-content-{{ question.id }}-preview" style="display: none;">
                                            <hr>
                                            <h6 class="fw-bold">
                                                <i class="bi bi-translate me-1"></i>Traduction:
                                            </h6>
                                            <div id="translation-result-{{ question.id }}-preview"></div>
                                        </div>
                                    </div>
                                    
                                    <div class="list-group">
                                        {% for option in question.optionsReponsesArray %}
                                            <div class="list-group-item list-group-item-action">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="question{{ question.id }}" disabled>
                                                    <label class="form-check-label">
                                                        {{ option }}
                                                    </label>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    
                                    {% if question.explication %}
                                        <div class="alert alert-info mt-3 mb-0">
                                            <small>
                                                <strong><i class="bi bi-lightbulb me-1"></i>Explication:</strong> 
                                                {{ question.explication }}
                                            </small>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                        
                        <div class="alert alert-success mt-4">
                            <i class="bi bi-check-circle me-2"></i>
                            <strong>Statut:</strong> Ce quiz est prêt et visible pour les patients avec {{ questionsValidees|length }} question(s) validée(s).
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
// Translation widget functionality for quiz_preview
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.translation-widget').forEach(function(widget) {
        const widgetId = widget.dataset.widgetId;
        const languageSelect = document.getElementById('translation-language-select-' + widgetId);
        const translateBtn = document.getElementById('translate-btn-' + widgetId);
        const translatedContent = document.getElementById('translated-content-' + widgetId);
        const translationResult = document.getElementById('translation-result-' + widgetId);
        const translationAlert = document.getElementById('translation-alert-' + widgetId);
        const translationMessage = document.getElementById('translation-message-' + widgetId);
        const originalContent = document.getElementById('translation-content-' + widgetId.replace('-preview', ''));

        if (!languageSelect || !originalContent) return;

        // Load supported languages
        fetch('{{ path("app_translation_languages") }}')
            .then(r => r.json())
            .then(data => {
                languageSelect.innerHTML = '<option value="" disabled selected>Traduire / Translate /Traducir</option>';
                Object.entries(data.languages).forEach(([code, name]) => {
                    const option = document.createElement('option');
                    option.value = code;
                    option.textContent = name;
                    languageSelect.appendChild(option);
                });
            })
            .catch(err => console.error('Failed to load languages:', err));

        translateBtn.addEventListener('click', async function() {
            const targetLanguage = languageSelect.value;
            if (!targetLanguage) {
                translationMessage.textContent = 'Veuillez sélectionner une langue cible';
                translationAlert.className = 'alert alert-warning';
                translationAlert.style.display = 'block';
                return;
            }

            const textToTranslate = originalContent.innerText || originalContent.textContent;

            if (!textToTranslate.trim()) {
                translationMessage.textContent = 'Le contenu est vide';
                translationAlert.className = 'alert alert-warning';
                translationAlert.style.display = 'block';
                return;
            }

            translateBtn.disabled = true;
            translateBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Traduction en cours...';

            try {
                const response = await fetch('{{ path("app_translation_translate") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        text: textToTranslate,
                        targetLanguage: targetLanguage,
                        sourceLanguage: 'auto'
                    })
                });

                const result = await response.json();

                if (response.ok && result.translated) {
                    translationResult.innerHTML = result.translated;
                    translatedContent.style.display = 'block';
                    translationMessage.textContent = 'Traduction réussie!';
                    translationAlert.className = 'alert alert-success';
                    translationAlert.style.display = 'block';
                } else {
                    translationMessage.textContent = 'Échec de la traduction: ' + (result.error || 'Erreur inconnue');
                    translationAlert.className = 'alert alert-danger';
                    translationAlert.style.display = 'block';
                }
            } catch (error) {
                translationMessage.textContent = 'Erreur de connexion: ' + error.message;
                translationAlert.className = 'alert alert-danger';
                translationAlert.style.display = 'block';
            } finally {
                translateBtn.disabled = false;
                translateBtn.innerHTML = '<i class="bi bi-translate me-1"></i>Traduire';
            }

            setTimeout(() => {
                translationAlert.style.display = 'none';
            }, 5000);
        });
    });
});
</script>
{% endblock %}
