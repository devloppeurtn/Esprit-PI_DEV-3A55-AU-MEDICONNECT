{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouveau' }} cours - MediConnect{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <style>
        .form-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            color: #333;
            padding: 2.5rem 0;
            margin-bottom: 2rem;
            border-bottom: 3px solid #175cdd;
        }
        
        .form-header h1 {
            color: #175cdd;
            font-weight: 700;
        }
        
        .form-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .form-card:hover {
            box-shadow: 0 12px 35px rgba(0,0,0,0.12);
        }
        
        .form-card .card-body {
            padding: 2.5rem;
        }
        
        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .form-label i {
            color: #175cdd;
            font-size: 1.1rem;
        }
        
        .form-control, .form-control-lg {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 0.875rem 1.25rem;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }
        
        .form-control:focus, .form-control-lg:focus {
            border-color: #175cdd;
            box-shadow: 0 0 0 0.2rem rgba(23, 92, 221, 0.15);
            outline: none;
        }
        
        textarea.form-control {
            min-height: 300px;
            resize: vertical;
            font-family: inherit;
            line-height: 1.6;
        }
        
        .form-text {
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: #6c757d;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .form-text i {
            color: #175cdd;
        }
        
        .info-box {
            background: linear-gradient(135deg, #e7f1ff 0%, #d4e7ff 100%);
            border-left: 4px solid #175cdd;
            border-radius: 10px;
            padding: 1.25rem;
            margin-bottom: 2rem;
        }
        
        .info-box i {
            color: #175cdd;
            font-size: 1.5rem;
        }
        
        .btn-group-actions {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            padding-top: 1.5rem;
            border-top: 2px solid #f0f0f0;
            margin-top: 2rem;
        }
        
        .btn-lg {
            padding: 0.875rem 2rem;
            font-weight: 600;
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        
        .btn-primary {
            background: #175cdd;
            border: none;
            box-shadow: 0 4px 15px rgba(23, 92, 221, 0.3);
        }
        
        .btn-primary:hover {
            background: #1a4db5;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(23, 92, 221, 0.4);
        }
        
        .btn-outline-secondary {
            border: 2px solid #6c757d;
            color: #6c757d;
        }
        
        .btn-outline-secondary:hover {
            background: #6c757d;
            color: white;
            transform: translateY(-2px);
        }
        
        .input-group-icon {
            position: relative;
        }
        
        .input-group-icon i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            z-index: 10;
        }
        
        .input-group-icon .form-control {
            padding-left: 2.75rem;
        }
        
        .character-count {
            text-align: right;
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 0.25rem;
        }
        
        .required-indicator {
            color: #dc3545;
            font-weight: 700;
        }
        
        .invalid-feedback {
            display: block;
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.5rem;
            font-weight: 500;
        }
        
        .is-invalid {
            border-color: #dc3545 !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
        
        .form-error-summary {
            background: #f8d7da;
            border: 2px solid #dc3545;
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 2rem;
            animation: shake 0.5s;
        }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
        
        .form-error-summary h6 {
            color: #842029;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }
        
        .form-error-summary ul {
            margin-bottom: 0;
            padding-left: 1.5rem;
            color: #842029;
        }
    </style>
{% endblock %}

{% block body %}
<div class="form-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <a href="{{ path('app_savoir_medical_categorie', {id: categorie.id}) }}" class="btn btn-outline-secondary btn-sm mb-3">
                    <i class="bi bi-arrow-left me-1"></i>Retour à {{ categorie.nom }}
                </a>
                <h1 class="display-5 mb-2">
                    <i class="bi bi-{{ isEdit ? 'pencil-square' : 'plus-circle' }} me-2"></i>
                    {{ isEdit ? 'Modifier le cours' : 'Nouveau cours' }}
                </h1>
                <p class="lead mb-0 text-muted">
                    <i class="bi bi-folder me-1"></i>{{ categorie.nom }}
                </p>
            </div>
            <div class="d-none d-md-block">
                <div class="text-end">
                    <div class="badge bg-primary fs-6 px-3 py-2">
                        <i class="bi bi-book me-1"></i>{{ isEdit ? 'Modification' : 'Cr�ation' }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card form-card">
                <div class="card-body">
                    {# Flash Messages - Only show if no validation errors #}
                    {% if app.flashes('success')|length > 0 and app.flashes('error')|length == 0 %}
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                    {% endif %}

                    {% if app.flashes('error')|length > 0 %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Veuillez corriger les erreurs suivantes:</strong>
                            <ul class="mb-0 mt-2">
                                {% for message in app.flashes('error') %}
                                    <li>{{ message }}</li>
                                {% endfor %}
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}
                    
                    {# Error Summary Box (JavaScript validation) #}
                    <div id="formErrorSummary" class="form-error-summary" style="display: none;">
                        <h6><i class="bi bi-exclamation-triangle-fill me-2"></i>Veuillez corriger les erreurs suivantes:</h6>
                        <ul id="errorList"></ul>
                    </div>
                    
                    <form method="post" id="coursForm" novalidate>
                        <div class="mb-4">
                            <label for="titre" class="form-label">
                                <i class="bi bi-type"></i>
                                Titre du cours <span class="required-indicator">*</span>
                            </label>
                            <div class="input-group-icon">
                                <i class="bi bi-bookmark"></i>
                                <input type="text" class="form-control form-control-lg" id="titre" name="titre" 
                                       value="{{ cours.titre ?? '' }}" required 
                                       placeholder="Ex: Introduction à la cardiologie"
                                       maxlength="255">
                            </div>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i>
                                Donnez un titre clair et descriptif à votre cours (max 255 caractères)
                            </div>
                            <div class="character-count">
                                <span id="titre-count">0</span>/255 caractères
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label for="contenu" class="form-label">
                                <i class="bi bi-file-text"></i>
                                Contenu du cours <span class="required-indicator">*</span>
                            </label>
                            <div class="translation-widget" data-widget-id="course-content-form">
                                <div class="d-flex justify-content-end mb-2">
                                    <select class="form-select form-select-sm" style="width: auto;" id="translation-language-select-course-form">
                                        <option value="" disabled selected>Traduire / Translate /Traducir</option>
                                    </select>
                                    <button class="btn btn-sm btn-primary ms-2" id="translate-btn-course-form">
                                        <i class="bi bi-translate me-1"></i>Traduire
                                    </button>
                                </div>
                                
                                <div class="alert alert-info" id="translation-alert-course-form" style="display: none;">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <span id="translation-message-course-form"></span>
                                </div>
                                
                                <div class="mt-2" id="translated-content-course-form" style="display: none;">
                                    <hr>
                                    <h6 class="fw-bold">
                                        <i class="bi bi-translate me-1"></i>Traduction:
                                    </h6>
                                    <div id="translation-result-course-form"></div>
                                </div>
                            </div>
                            <textarea class="form-control" id="contenu" name="contenu" rows="15" required 
                                      placeholder="Rédigez le contenu détaillé de votre cours...

Vous pouvez structurer votre cours avec :
• Des sections claires
• Des explications détaillées
• Des exemples pratiques
? Des points importants � retenir">{{ cours.contenu ?? '' }}</textarea>
                            <div class="form-text">
                                <i class="bi bi-lightbulb"></i>
                                Expliquez les concepts de manière claire et pédagogique. Utilisez des paragraphes pour structurer votre contenu.
                            </div>
                            <div class="character-count">
                                <span id="contenu-count">0</span> caractères
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label for="scorePourBadge" class="form-label">
                                <i class="bi bi-trophy"></i>
                                Score requis pour le badge
                            </label>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="input-group-icon">
                                        <i class="bi bi-star"></i>
                                        <input type="number" class="form-control" id="scorePourBadge" name="scorePourBadge" 
                                               value="{{ cours.scorePourBadge ?? 100 }}" min="0" step="10"
                                               placeholder="100">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="alert alert-light mb-0">
                                        <small>
                                            <i class="bi bi-info-circle text-primary me-1"></i>
                                            Score minimum que l'utilisateur doit atteindre pour obtenir un badge. Recommandé : 70-100 points.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="info-box">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-info-circle-fill me-3 mt-1"></i>
                                <div>
                                    <h6 class="fw-bold mb-2">Prochaines étapes après la création</h6>
                                    <ul class="mb-0 small">
                                        <li>Vous pourrez ajouter des questions de quiz pour tester les connaissances des utilisateurs</li>
                                        <li>Les questions peuvent être générées automatiquement avec l'IA ou ajoutées manuellement</li>
                                        <li>Une fois validées, les questions seront disponibles pour les patients</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <div class="btn-group-actions">
                            <a href="{{ path('app_savoir_medical_categorie', {id: categorie.id}) }}" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-2"></i>Annuler
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-{{ isEdit ? 'check-circle' : 'plus-circle' }} me-2"></i>
                                {{ isEdit ? 'Enregistrer les modifications' : 'Cr�er le cours' }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const titreInput = document.getElementById('titre');
    const contenuInput = document.getElementById('contenu');
    const titreCount = document.getElementById('titre-count');
    const contenuCount = document.getElementById('contenu-count');
    const form = document.getElementById('coursForm');
    const errorSummary = document.getElementById('formErrorSummary');
    const errorList = document.getElementById('errorList');
    
    function updateCount(input, countElement) {
        countElement.textContent = input.value.length;
    }
    
    function showError(input, message) {
        input.classList.add('is-invalid');
        
        // Remove existing error message
        const existingError = input.parentElement.querySelector('.invalid-feedback');
        if (existingError) {
            existingError.remove();
        }
        
        // Add new error message
        const errorDiv = document.createElement('div');
        errorDiv.className = 'invalid-feedback';
        errorDiv.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i>' + message;
        input.parentElement.appendChild(errorDiv);
    }
    
    function clearError(input) {
        input.classList.remove('is-invalid');
        const errorDiv = input.parentElement.querySelector('.invalid-feedback');
        if (errorDiv) {
            errorDiv.remove();
        }
    }
    
    function validateField(input) {
        const value = input.value.trim();
        
        if (input === titreInput) {
            if (!value) {
                showError(input, 'Le titre du cours est obligatoire');
                return false;
            } else if (value.length < 5) {
                showError(input, 'Le titre doit contenir au moins 5 caractères');
                return false;
            } else {
                clearError(input);
                return true;
            }
        } else if (input === contenuInput) {
            if (!value) {
                showError(input, 'Le contenu du cours est obligatoire');
                return false;
            } else if (value.length < 50) {
                showError(input, 'Le contenu doit contenir au moins 50 caractères');
                return false;
            } else {
                clearError(input);
                return true;
            }
        }
        
        return true;
    }
    
    // Character count updates
    if (titreInput && titreCount) {
        updateCount(titreInput, titreCount);
        titreInput.addEventListener('input', function() {
            updateCount(titreInput, titreCount);
            if (titreInput.classList.contains('is-invalid')) {
                validateField(titreInput);
            }
        });
        
        titreInput.addEventListener('blur', function() {
            validateField(titreInput);
        });
    }
    
    if (contenuInput && contenuCount) {
        updateCount(contenuInput, contenuCount);
        contenuInput.addEventListener('input', function() {
            updateCount(contenuInput, contenuCount);
            if (contenuInput.classList.contains('is-invalid')) {
                validateField(contenuInput);
            }
        });
        
        contenuInput.addEventListener('blur', function() {
            validateField(contenuInput);
        });
    }
    
    // Form validation on submit
    if (form) {
        form.addEventListener('submit', function(e) {
            // Clear previous errors
            errorSummary.style.display = 'none';
            errorList.innerHTML = '';
            clearError(titreInput);
            clearError(contenuInput);
            
            const errors = [];
            let isValid = true;
            
            // Validate titre
            const titre = titreInput.value.trim();
            if (!titre) {
                errors.push('Le titre du cours est obligatoire');
                showError(titreInput, 'Le titre du cours est obligatoire');
                isValid = false;
            } else if (titre.length < 5) {
                errors.push('Le titre doit contenir au moins 5 caractères');
                showError(titreInput, 'Le titre doit contenir au moins 5 caractères');
                isValid = false;
            }
            
            // Validate contenu
            const contenu = contenuInput.value.trim();
            if (!contenu) {
                errors.push('Le contenu du cours est obligatoire');
                showError(contenuInput, 'Le contenu du cours est obligatoire');
                isValid = false;
            } else if (contenu.length < 50) {
                errors.push('Le contenu doit contenir au moins 50 caractères (actuellement: ' + contenu.length + ')');
                showError(contenuInput, 'Le contenu doit contenir au moins 50 caractères');
                isValid = false;
            }
            
            // Show error summary if validation failed
            if (!isValid) {
                e.preventDefault();
                
                errors.forEach(error => {
                    const li = document.createElement('li');
                    li.textContent = error;
                    errorList.appendChild(li);
                });
                
                errorSummary.style.display = 'block';
                errorSummary.scrollIntoView({ behavior: 'smooth', block: 'center' });
                
                // Focus on first invalid field
                if (titreInput.classList.contains('is-invalid')) {
                    titreInput.focus();
                } else if (contenuInput.classList.contains('is-invalid')) {
                    contenuInput.focus();
                }
                
                return false;
            }
        });
    }
});
</script>

<script>
// Translation widget functionality for form_cours
document.addEventListener('DOMContentLoaded', function() {
    const widgetId = 'course-content-form';
    const languageSelect = document.getElementById('translation-language-select-course-form');
    const translateBtn = document.getElementById('translate-btn-course-form');
    const translatedContent = document.getElementById('translated-content-course-form');
    const translationResult = document.getElementById('translation-result-course-form');
    const translationAlert = document.getElementById('translation-alert-course-form');
    const translationMessage = document.getElementById('translation-message-course-form');
    const originalContent = document.getElementById('contenu');

    if (!languageSelect || !originalContent) return;

    // Load supported languages
    fetch('{{ path("app_translation_languages") }}')
        .then(r => r.json())
        .then(data => {
            languageSelect.innerHTML = '<option value="" disabled selected>Traduire / Translate /Traducir</option>';
            Object.entries(data.languages).forEach(([code, name]) => {
                const option = document.createElement('option');
                option.value = code;
                option.textContent = name;
                languageSelect.appendChild(option);
            });
        })
        .catch(err => console.error('Failed to load languages:', err));

    translateBtn.addEventListener('click', async function() {
        const targetLanguage = languageSelect.value;
        if (!targetLanguage) {
            translationMessage.textContent = 'Veuillez sélectionner une langue cible';
            translationAlert.className = 'alert alert-warning';
            translationAlert.style.display = 'block';
            return;
        }

        const textToTranslate = originalContent.value;

        if (!textToTranslate.trim()) {
            translationMessage.textContent = 'Le contenu est vide';
            translationAlert.className = 'alert alert-warning';
            translationAlert.style.display = 'block';
            return;
        }

        translateBtn.disabled = true;
        translateBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Traduction en cours...';

        try {
            const response = await fetch('{{ path("app_translation_translate") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    text: textToTranslate,
                    targetLanguage: targetLanguage,
                    sourceLanguage: 'auto'
                })
            });

            const result = await response.json();

            if (response.ok && result.translated) {
                translationResult.innerHTML = result.translated;
                translatedContent.style.display = 'block';
                translationMessage.textContent = 'Traduction réussie!';
                translationAlert.className = 'alert alert-success';
                translationAlert.style.display = 'block';
            } else {
                translationMessage.textContent = 'Échec de la traduction: ' + (result.error || 'Erreur inconnue');
                translationAlert.className = 'alert alert-danger';
                translationAlert.style.display = 'block';
            }
        } catch (error) {
            translationMessage.textContent = 'Erreur de connexion: ' + error.message;
            translationAlert.className = 'alert alert-danger';
            translationAlert.style.display = 'block';
        } finally {
            translateBtn.disabled = false;
            translateBtn.innerHTML = '<i class="bi bi-translate me-1"></i>Traduire';
        }

        setTimeout(() => {
            translationAlert.style.display = 'none';
        }, 5000);
    });
});
</script>
{% endblock %}
