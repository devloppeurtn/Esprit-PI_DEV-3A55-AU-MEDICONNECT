{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ cours.titre }} - MediConnect{% endblock %}

{% block stylesheets %}
    {% include 'savoir_medical/_modern_styles.html.twig' %}
    <script src="{{ asset('assets/js/tts-player.js') }}"></script>
    <style>
        .course-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 3rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 20px 20px;
            position: relative;
            overflow: hidden;
        }
        
        .course-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
        }
        
        .course-hero h1 {
            color: white;
            font-weight: 800;
            font-size: 2.25rem;
            margin-bottom: 1rem;
        }
        
        .course-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            backdrop-filter: blur(10px);
        }
        
        .content-card {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            margin-bottom: 2rem;
        }
        
        .content-card h3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .content-card h3 i {
            color: #667eea;
            font-size: 1.75rem;
        }
        
        .course-text {
            font-size: 1.05rem;
            line-height: 1.8;
            color: #2c3e50;
            white-space: pre-line;
        }
        
        .translation-controls {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }
        
        .translation-controls .btn-outline-primary {
            border: 2px solid #667eea;
            color: #667eea;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .translation-controls .btn-outline-primary:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }
        
        .translation-controls .btn-danger {
            animation: pulse 1.5s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        
        .translation-controls select {
            min-width: 180px;
            border-radius: 10px;
            border: 2px solid #e9ecef;
            padding: 0.5rem 1rem;
        }
        
        .translation-controls select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .translation-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 10px rgba(102, 126, 234, 0.15);
        }
        
        .translation-card .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1rem 1.5rem;
            font-weight: 600;
        }
        
        .translation-card .card-body {
            background: #f8f9fa;
            padding: 1.5rem;
        }
        
        .question-card-compact {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            margin-bottom: 1rem;
            border-left: 4px solid #667eea;
            transition: all 0.3s ease;
        }
        
        .question-card-compact:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transform: translateX(5px);
        }
        
        .question-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-weight: 700;
            font-size: 0.9rem;
        }
        
        .info-sidebar {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            position: sticky;
            top: 120px;
        }
        
        .info-sidebar h5 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #e9ecef;
        }
        
        .info-item {
            margin-bottom: 1.5rem;
        }
        
        .info-label {
            font-size: 0.8rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
            display: block;
        }
        
        .info-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #2c3e50;
        }
        
        .badge-custom {
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
        }
        
        .badge-purple {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .badge-gold {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }
        
        .btn-start-quiz {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            border: none;
            color: white;
            padding: 1rem 2rem;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }
        
        .btn-start-quiz:hover {
            background: linear-gradient(135deg, #0f8a7f 0%, #32d96d 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(17, 153, 142, 0.3);
            color: white;
        }
        
        .btn-manage-quiz {
            background: white;
            border: 2px solid #667eea;
            color: #667eea;
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-manage-quiz:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        
        .validated-badge {
            background: linear-gradient(135deg, #e7f1ff 0%, #d4e7ff 100%);
            border-left: 4px solid #667eea;
            border-radius: 10px;
            padding: 1rem 1.25rem;
        }
        
        .empty-state-quiz {
            text-align: center;
            padding: 3rem 2rem;
            background: #f8f9fa;
            border-radius: 15px;
            border: 2px dashed #dee2e6;
        }
        
        .empty-state-quiz i {
            font-size: 4rem;
            color: #dee2e6;
            margin-bottom: 1rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="course-hero">
    <div class="container">
        <a href="{{ path('app_savoir_medical_categorie', {id: cours.categorieSante.id}) }}" class="btn btn-light btn-sm mb-3">
            <i class="bi bi-arrow-left me-1"></i>Retour à la catégorie
        </a>
        <h1>{{ cours.titre }}</h1>
        <div class="d-flex gap-2 flex-wrap">
            <span class="course-badge">
                <i class="bi bi-folder"></i>
                {{ cours.categorieSante.nom }}
            </span>
            <span class="course-badge">
                <i class="bi bi-trophy"></i>
                {{ cours.scorePourBadge }} points pour badge
            </span>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row">
        <div class="col-lg-8">
            {# Course Content #}
            <div class="content-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <h3 class="mb-0">
                            <i class="bi bi-file-text"></i>
                            Contenu du cours
                        </h3>
                        {% set widget_id = 'course-content-' ~ cours.id %}
                        <button class="btn btn-sm btn-outline-primary" id="tts-btn-{{ widget_id }}" title="Écouter le contenu du cours">
                            <i class="bi bi-volume-up-fill me-1"></i>
                            Écouter
                        </button>
                    </div>
                    <div class="translation-controls">
                        <select class="form-select form-select-sm" id="translation-language-select-{{ widget_id }}" style="width: auto;">
                            <option value="" disabled selected>Traduire</option>
                        </select>
                        <button class="btn btn-sm btn-primary" id="translate-btn-{{ widget_id }}">
                            <i class="bi bi-translate"></i>
                        </button>
                    </div>
                </div>
                
                <div class="alert alert-info py-2 px-3" id="translation-alert-{{ widget_id }}" style="display: none; font-size: 0.9rem;">
                    <i class="bi bi-info-circle me-2"></i>
                    <span id="translation-message-{{ widget_id }}"></span>
                </div>
                
                <div class="course-text mb-4" id="translation-content-{{ widget_id }}">
                    {{ cours.contenu|nl2br }}
                </div>
                
                <div class="mt-4" id="translated-content-{{ widget_id }}" style="display: none;">
                    <div class="card translation-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-translate me-2"></i>Traduction</span>
                            <button class="btn btn-sm btn-light" onclick="(function() {
                                document.getElementById('translated-content-{{ widget_id }}').style.display='none';
                                // Reset TTS to read original content
                                if (typeof currentTranslatedText !== 'undefined') {
                                    currentTranslatedText = null;
                                    currentTargetLanguage = 'fr';
                                }
                            })()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div class="card-body">
                            <div id="translation-result-{{ widget_id }}" class="course-text"></div>
                        </div>
                    </div>
                </div>
                
                {% if cours.medecinValidateur %}
                    <div class="validated-badge mt-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-primary" style="font-size: 1.5rem;"></i>
                            <div>
                                <strong class="d-block">Validé par un professionnel</strong>
                                <small class="text-muted">Dr. {{ cours.medecinValidateur.nomComplet }}</small>
                            </div>
                        </div>
                    </div>
                {% endif %}
                
                <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const widgetId = '{{ widget_id }}';
                    const languageSelect = document.getElementById('translation-language-select-' + widgetId);
                    const translateBtn = document.getElementById('translate-btn-' + widgetId);
                    const ttsBtn = document.getElementById('tts-btn-' + widgetId);
                    const translatedContent = document.getElementById('translated-content-' + widgetId);
                    const translationResult = document.getElementById('translation-result-' + widgetId);
                    const translationAlert = document.getElementById('translation-alert-' + widgetId);
                    const translationMessage = document.getElementById('translation-message-' + widgetId);

                    // TTS functionality - reads translated content if available, otherwise original
                    let currentTranslatedText = null;
                    let currentTargetLanguage = 'fr';
                    
                    if (ttsBtn && window.ttsPlayer) {
                        ttsBtn.addEventListener('click', function() {
                            // Check if there's translated content visible
                            const translatedContentDiv = document.getElementById('translated-content-' + widgetId);
                            const translationResultDiv = document.getElementById('translation-result-' + widgetId);
                            
                            let textToRead = '';
                            let language = 'fr';
                            
                            // If translation is visible and has content, read the translated text
                            if (translatedContentDiv && translatedContentDiv.style.display !== 'none' && currentTranslatedText) {
                                textToRead = currentTranslatedText;
                                language = currentTargetLanguage;
                            } else {
                                // Otherwise read the original content
                                const contentElement = document.getElementById('translation-content-' + widgetId);
                                textToRead = contentElement.innerText || contentElement.textContent;
                                language = 'fr';
                            }
                            
                            window.ttsPlayer.play(textToRead.trim(), language, 'female', ttsBtn);
                        });
                    }

                    // Load supported languages
                    fetch('{{ path("app_translation_languages") }}')
                        .then(r => r.json())
                        .then(data => {
                            languageSelect.innerHTML = '<option value="" disabled selected>Choisir la langue</option>';
                            Object.entries(data.languages).forEach(([code, name]) => {
                                const option = document.createElement('option');
                                option.value = code;
                                option.textContent = name;
                                languageSelect.appendChild(option);
                            });
                        })
                        .catch(err => console.error('Failed to load languages:', err));

                    translateBtn.addEventListener('click', async function() {
                        const targetLanguage = languageSelect.value;
                        if (!targetLanguage) {
                            showTranslationAlert('Veuillez sélectionner une langue', 'warning');
                            return;
                        }

                        const originalContent = document.getElementById('translation-content-' + widgetId);
                        if (!originalContent) {
                            showTranslationAlert('Aucun contenu à traduire', 'danger');
                            return;
                        }

                        const textToTranslate = originalContent.innerText || originalContent.textContent;

                        if (!textToTranslate.trim()) {
                            showTranslationAlert('Le contenu est vide', 'warning');
                            return;
                        }

                        translateBtn.disabled = true;
                        translateBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Traduction...';

                        try {
                            const response = await fetch('{{ path("app_translation_translate") }}', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    text: textToTranslate,
                                    targetLanguage: targetLanguage,
                                    sourceLanguage: 'auto'
                                })
                            });

                            const result = await response.json();

                            if (response.ok && result.translated) {
                                // Store the translated text and language for TTS
                                currentTranslatedText = result.translated;
                                currentTargetLanguage = targetLanguage;
                                
                                translationResult.innerHTML = result.translated.replace(/\n/g, '<br>');
                                translatedContent.style.display = 'block';
                                showTranslationAlert('Traduction réussie! Cliquez sur "Écouter" pour entendre la traduction.', 'success');
                                translatedContent.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                            } else {
                                showTranslationAlert('Échec de la traduction: ' + (result.error || 'Erreur inconnue'), 'danger');
                            }
                        } catch (error) {
                            showTranslationAlert('Erreur de connexion: ' + error.message, 'danger');
                        } finally {
                            translateBtn.disabled = false;
                            translateBtn.innerHTML = '<i class="bi bi-translate me-1"></i>Traduire';
                        }
                    });

                    function showTranslationAlert(message, type) {
                        translationMessage.textContent = message;
                        translationAlert.className = 'alert alert-' + type + ' py-2 px-3';
                        translationAlert.style.display = 'block';
                        translationAlert.style.fontSize = '0.9rem';
                        
                        setTimeout(() => {
                            translationAlert.style.display = 'none';
                        }, 5000);
                    }
                });
                </script>
            </div>
            
            {# Quiz Section #}
            <div class="content-card">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <h3 class="mb-0">
                        <i class="bi bi-question-circle"></i>
                        Quiz ({{ questions|length }} questions)
                    </h3>
                    {% if is_granted('ROLE_MEDECIN') or is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_quiz_gerer', {coursId: cours.id}) }}" class="btn btn-manage-quiz">
                            <i class="bi bi-gear me-2"></i>Gérer le quiz
                        </a>
                    {% endif %}
                </div>
                
                {% if questions is empty %}
                    <div class="empty-state-quiz">
                        <i class="bi bi-inbox"></i>
                        <h5 class="text-muted">Aucune question disponible</h5>
                        <p class="text-muted mb-0">Les questions seront ajoutées prochainement</p>
                    </div>
                {% else %}
                    <p class="text-muted mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Testez vos connaissances avec ces questions validées par des médecins.
                    </p>
                    
                    {% for question in questions %}
                        <div class="question-card-compact">
                            <div class="d-flex align-items-start gap-3 mb-2">
                                <span class="question-number">{{ loop.index }}</span>
                                <div class="flex-grow-1">
                                    <p class="mb-2 fw-semibold">{{ question.enonce }}</p>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge {{ question.statut.value == 'VALIDE_MEDECIN' ? 'bg-success' : 'bg-warning text-dark' }} badge-custom">
                                            {% if question.statut.value == 'VALIDE_MEDECIN' %}
                                                <i class="bi bi-check-circle me-1"></i>Validée
                                            {% else %}
                                                <i class="bi bi-clock me-1"></i>{{ question.statut.label }}
                                            {% endif %}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    
                    {% set questionsValidees = questions|filter(q => q.statut.value == 'VALIDE_MEDECIN') %}
                    {% if is_granted('ROLE_PATIENT') and questionsValidees|length > 0 %}
                        <div class="d-grid gap-2 mt-4">
                            <a href="{{ path('app_quiz_prendre', {coursId: cours.id}) }}" class="btn btn-start-quiz">
                                <i class="bi bi-play-circle-fill me-2"></i>
                                Commencer le quiz ({{ questionsValidees|length }} questions)
                            </a>
                        </div>
                    {% elseif is_granted('ROLE_PATIENT') and questionsValidees|length == 0 %}
                        <div class="alert alert-warning mt-4">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Quiz non disponible</strong><br>
                            <small>Le quiz sera disponible une fois que des questions auront été validées par un médecin.</small>
                        </div>
                    {% endif %}
                    
                    {% if is_granted('ROLE_MEDECIN') or is_granted('ROLE_ADMIN') %}
                        <div class="d-grid gap-2 mt-3">
                            <a href="{{ path('app_quiz_gerer', {coursId: cours.id}) }}" class="btn btn-outline-primary">
                                <i class="bi bi-gear me-2"></i>
                                Gérer le quiz
                            </a>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
        
        {# Sidebar #}
        <div class="col-lg-4">
            <div class="info-sidebar">
                <h5><i class="bi bi-info-circle me-2"></i>Informations</h5>
                
                <div class="info-item">
                    <span class="info-label">Catégorie</span>
                    <div class="info-value">{{ cours.categorieSante.nom }}</div>
                </div>
                
                <div class="info-item">
                    <span class="info-label">Type</span>
                    <span class="badge badge-purple">{{ cours.categorieSante.type }}</span>
                </div>
                
                <div class="info-item">
                    <span class="info-label">Nombre de questions</span>
                    <div class="info-value">{{ questions|length }}</div>
                </div>
                
                <div class="info-item">
                    <span class="info-label">Score pour badge</span>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-trophy-fill text-warning" style="font-size: 1.5rem;"></i>
                        <span class="info-value">{{ cours.scorePourBadge }} points</span>
                    </div>
                </div>
                
                <div class="info-item">
                    <span class="info-label">Date de création</span>
                    <div class="info-value">{{ cours.dateCreation|date('d/m/Y') }}</div>
                </div>
                
                {% if progression %}
                    <hr class="my-4">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-graph-up me-2"></i>Ma progression
                    </h6>
                    
                    <div class="info-item">
                        <span class="info-label">Score maximum</span>
                        <div class="info-value text-primary">{{ progression.scoreMax }}</div>
                    </div>
                    
                    <div class="info-item">
                        <span class="info-label">Tentatives</span>
                        <div class="info-value">{{ progression.nbTentatives }}</div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
