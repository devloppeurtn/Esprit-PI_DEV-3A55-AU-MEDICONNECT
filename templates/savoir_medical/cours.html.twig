{% extends 'base.html.twig' %}

{% block title %}{{ cours.titre }} - MediConnect{% endblock %}

{% block stylesheets %}
    <style>
        .cours-header {
            background: linear-gradient(135deg, #175cdd 0%, #1a4db5 100%);
            color: white;
            padding: 3rem 0;
            margin-bottom: 2rem;
        }
        
        .cours-content {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
        }
        
        .question-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            margin-bottom: 1rem;
            border-left: 4px solid #175cdd;
        }
    </style>
{% endblock %}

{% block body %}
<div class="cours-header">
    <div class="container">
        <a href="{{ path('app_savoir_medical_categorie', {id: cours.categorieSante.id}) }}" class="btn btn-light btn-sm mb-3">
            <i class="bi bi-arrow-left me-1"></i>Retour à la catégorie
        </a>
        <h1 class="display-5 mb-2">{{ cours.titre }}</h1>
        <p class="mb-0">
            <span class="badge bg-light text-dark">{{ cours.categorieSante.nom }}</span>
            <span class="badge bg-light text-dark ms-2">
                <i class="bi bi-trophy me-1"></i>{{ cours.scorePourBadge }} points pour badge
            </span>
        </p>
    </div>
</div>

<div class="container mb-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="cours-content">
                <h3 class="mb-4">Contenu du cours</h3>
                <div class="course-text">
                    {{ cours.contenu|nl2br }}
                </div>
                
                {% if cours.medecinValidateur %}
                    <div class="alert alert-info mt-4">
                        <i class="bi bi-shield-check me-2"></i>
                        <strong>Validé par un professionnel :</strong> Dr. {{ cours.medecinValidateur.nomComplet }}
                    </div>
                {% endif %}
            </div>
            
            <div class="cours-content">
                <h3 class="mb-4">
                    <i class="bi bi-question-circle me-2"></i>
                    Quiz ({{ questions|length }} questions)
                </h3>
                
                {% if questions is empty %}
                    <div class="text-center py-4">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #e9ecef;"></i>
                        <p class="text-muted mt-3">Aucune question disponible pour le moment</p>
                    </div>
                {% else %}
                    <p class="text-muted mb-4">
                        Testez vos connaissances avec ces questions. Les réponses sont validées par des médecins.
                    </p>
                    
                    {% for question in questions %}
                        <div class="question-card">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h6 class="fw-bold mb-0">Question {{ loop.index }}</h6>
                                <span class="badge {{ question.statut.value == 'VALIDE_MEDECIN' ? 'bg-success' : 'bg-warning' }}">
                                    {{ question.statut.label }}
                                </span>
                            </div>
                            <p class="mb-3">{{ question.enonce }}</p>
                            
                            <div class="alert alert-secondary mb-0">
                                <small>
                                    <i class="bi bi-info-circle me-1"></i>
                                    Cette question fait partie du quiz interactif. Commencez le quiz pour y répondre !
                                </small>
                            </div>
                        </div>
                    {% endfor %}
                    
                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-primary btn-lg" disabled>
                            <i class="bi bi-play-circle me-2"></i>
                            Commencer le quiz (Bientôt disponible)
                        </button>
                    </div>
                {% endif %}
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 120px;">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">Informations</h5>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Catégorie</small>
                        <strong>{{ cours.categorieSante.nom }}</strong>
                    </div>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Type</small>
                        <span class="badge bg-primary">{{ cours.categorieSante.type }}</span>
                    </div>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Nombre de questions</small>
                        <strong>{{ questions|length }}</strong>
                    </div>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Score pour badge</small>
                        <strong class="text-warning">
                            <i class="bi bi-trophy me-1"></i>{{ cours.scorePourBadge }} points
                        </strong>
                    </div>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Date de création</small>
                        <strong>{{ cours.dateCreation|date('d/m/Y') }}</strong>
                    </div>
                    
                    {% if progression %}
                        <hr class="my-4">
                        <h6 class="fw-bold mb-3">Ma progression</h6>
                        
                        <div class="mb-2">
                            <small class="text-muted">Score max</small>
                            <div class="fw-bold text-primary">{{ progression.scoreMax }}</div>
                        </div>
                        
                        <div class="mb-2">
                            <small class="text-muted">Tentatives</small>
                            <div class="fw-bold">{{ progression.nbTentatives }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
