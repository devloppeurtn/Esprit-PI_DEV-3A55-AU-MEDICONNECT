{% extends 'admin/base_admin.html.twig' %}

{% block title %}Générer Quiz avec IA - {{ cours.titre }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-magic" style="font-size: 4rem; color: #175cdd;"></i>
                        <h2 class="mt-3">Génération de Quiz par IA</h2>
                        <p class="text-muted">Pour le cours : <strong>{{ cours.titre }}</strong></p>
                    </div>
                    
                    <div class="alert alert-info">
                        <h5 class="alert-heading">
                            <i class="bi bi-info-circle me-2"></i>
                            Intégration IA Requise
                        </h5>
                        <p class="mb-0">
                            Cette fonctionnalité nécessite l'intégration d'un service d'IA médical spécialisé 
                            (comme OpenAI GPT-4 avec des prompts médicaux ou un service dédié à la santé).
                        </p>
                    </div>
                    
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">Comment ça fonctionne :</h6>
                            <ol class="mb-0">
                                <li class="mb-2">L'IA analyse le contenu du cours</li>
                                <li class="mb-2">Elle génère des questions pertinentes avec plusieurs choix</li>
                                <li class="mb-2">Vous pouvez réviser, modifier ou supprimer les questions</li>
                                <li class="mb-2">Une fois validées, les questions sont disponibles pour les patients</li>
                            </ol>
                        </div>
                    </div>
                    
                    <div class="card border-warning bg-warning bg-opacity-10 mb-4">
                        <div class="card-body">
                            <h6 class="fw-bold text-warning mb-3">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Configuration Nécessaire
                            </h6>
                            <p class="mb-2">Pour activer cette fonctionnalité, vous devez :</p>
                            <ul class="mb-0">
                                <li>Configurer une clé API pour un service d'IA</li>
                                <li>Implémenter le service de génération de questions</li>
                                <li>Tester et valider les questions générées</li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2 justify-content-between">
                        <a href="{{ path('app_savoir_medical_cours', {id: cours.id}) }}" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left me-2"></i>Retour
                        </a>
                        <a href="{{ path('app_quiz_ajouter_manuel', {coursId: cours.id}) }}" class="btn btn-primary btn-lg">
                            <i class="bi bi-pencil me-2"></i>Ajouter manuellement
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
