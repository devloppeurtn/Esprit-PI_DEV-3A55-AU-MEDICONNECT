{% extends 'admin/base_admin.html.twig' %}

{% block title %}Quiz - {{ cours.titre }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <script src="{{ asset('assets/js/tts-player.js') }}"></script>
    <style>
        .quiz-container {
            max-width: 900px;
            margin: 0 auto;
        }
        
        .question-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
        }
        
        .option-card {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            margin-bottom: 0.75rem;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .option-card:hover {
            border-color: #175cdd;
            background: #f8f9fa;
        }
        
        .option-card.selected {
            border-color: #175cdd;
            background: #e7f1ff;
        }
        
        .option-card.correct {
            border-color: #28a745;
            background: #d4edda;
            position: relative;
            padding-left: 3rem;
        }
        
        .option-card.correct::before {
            content: '●';
            color: #28a745;
            font-size: 32px;
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            line-height: 1;
        }
        
        .option-card.incorrect {
            border-color: #dc3545;
            background: #f8d7da;
            position: relative;
            padding-left: 3rem;
        }
        
        .option-card.incorrect::before {
            content: '●';
            color: #dc3545;
            font-size: 32px;
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            line-height: 1;
        }
        
        .progress-bar-custom {
            height: 30px;
            font-size: 16px;
            font-weight: bold;
        }
        
        .score-display {
            background: #f8f9fa;
            color: #175cdd;
            padding: 1.5rem;
            border-radius: 15px;
            text-align: center;
            border: 2px solid #175cdd;
        }
        
        .btn-outline-primary {
            border: 2px solid #175cdd;
            color: #175cdd;
            transition: all 0.3s ease;
        }
        
        .btn-outline-primary:hover {
            background: #175cdd;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(23, 92, 221, 0.3);
        }
        
        .btn-danger {
            animation: pulse-red 1.5s infinite;
        }
        
        @keyframes pulse-red {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container my-5 quiz-container">
    {# Debug info - remove after fixing #}
    {% if debug_total is defined %}
        <div class="alert alert-info">
            <strong>Debug:</strong> Total questions: {{ debug_total }}, Validated: {{ debug_validated }}
        </div>
    {% endif %}
    
    {% if questions is empty %}
        <div class="card border-0 shadow">
            <div class="card-body p-5 text-center">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #e9ecef;"></i>
                <h4 class="mt-4">Aucune question disponible</h4>
                <p class="text-muted mb-4">Ce quiz n'a pas encore de questions validées.</p>
                <a href="{{ path('app_savoir_medical_categorie', {id: cours.categorieSante.id}) }}" class="btn btn-primary">
                    <i class="bi bi-arrow-left me-2"></i>Retour à la catégorie
                </a>
            </div>
        </div>
    {% else %}
        <div class="card border-0 shadow-lg mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="mb-1">{{ cours.titre }}</h2>
                        <p class="text-muted mb-0">{{ cours.categorieSante.nom }}</p>
                    </div>
                    <div class="score-display">
                        <div class="h1 mb-0" id="currentScore">0</div>
                        <small>Points</small>
                    </div>
                </div>
                
                <div class="progress mb-3" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
                         role="progressbar" 
                         id="progressBar"
                         style="width: 0%"
                         aria-valuenow="0" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                        <span id="progressText">0 / {{ questions|length }}</span>
                    </div>
                </div>
            </div>
        </div>

        <form id="quizForm" method="post" action="{{ path('app_quiz_soumettre', {coursId: cours.id}) }}">
            <input type="hidden" name="reponses" id="reponsesInput">
            
            {% for question in questions %}
                <div class="question-card" id="question-{{ loop.index }}" style="{{ loop.index > 1 ? 'display: none;' : '' }}">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Question {{ loop.index }} / {{ questions|length }}</h5>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="tts-question-btn-q{{ question.id }}" title="Écouter la question et les réponses">
                                <i class="bi bi-volume-up-fill"></i>
                            </button>
                            <select class="form-select form-select-sm" style="width: auto; min-width: 120px;" id="translation-language-select-q{{ question.id }}">
                                <option value="" disabled selected>Traduire</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-primary" id="translate-btn-q{{ question.id }}">
                                <i class="bi bi-translate"></i>
                            </button>
                            <span class="badge bg-primary">{{ 10 }} pts</span>
                        </div>
                    </div>
                    
                    <div class="alert alert-info py-2" id="translation-alert-q{{ question.id }}" style="display: none;">
                        <i class="bi bi-info-circle me-2"></i>
                        <span id="translation-message-q{{ question.id }}"></span>
                    </div>
                    
                    <p class="mb-3" id="question-text-{{ question.id }}">{{ question.enonce }}</p>
                    
                    <div id="translated-question-{{ question.id }}" class="alert alert-primary" style="display: none;">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong><i class="bi bi-translate me-2"></i>Traduction:</strong>
                                <p class="mb-0 mt-2" id="translated-question-text-{{ question.id }}"></p>
                            </div>
                            <button type="button" class="btn-close" onclick="document.getElementById('translated-question-{{ question.id }}').style.display='none'"></button>
                        </div>
                    </div>
                    
                    <div class="options-container" id="options-container-{{ question.id }}" data-question-id="{{ question.id }}" data-correct-answer="{{ question.reponseCorrecte|trim }}">
                        {% for option in question.optionsReponsesArray %}
                            <div class="option-card" data-option="{{ option|trim }}" data-option-index="{{ loop.index0 }}">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="{{ option|trim }}" id="q{{ question.id }}_opt{{ loop.index }}">
                                    <label class="form-check-label w-100" for="q{{ question.id }}_opt{{ loop.index }}">
                                        <strong class="option-letter">{{ ['A', 'B', 'C', 'D'][loop.index0] }}.</strong> 
                                        <span class="option-text" data-original="{{ option|trim }}">{{ option }}</span>
                                        <span class="option-translation" style="display: none; color: #0066cc; font-style: italic;"></span>
                                    </label>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                    <div class="explanation-box alert alert-info mt-4" id="explanation-box-{{ question.id }}" style="display: none;">
                        <h6 class="fw-bold"><i class="bi bi-lightbulb me-2"></i>Explication</h6>
                        <p class="mb-0" id="explanation-text-{{ question.id }}">{{ question.explication }}</p>
                        <div id="translated-explanation-{{ question.id }}" class="mt-2 pt-2 border-top" style="display: none;">
                            <small class="text-primary"><strong><i class="bi bi-translate me-1"></i>Traduction:</strong></small>
                            <p class="mb-0 mt-1" id="translated-explanation-text-{{ question.id }}" style="color: #0066cc; font-style: italic;"></p>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between mt-4">
                        {% if loop.index > 1 %}
                            <button type="button" class="btn btn-outline-secondary" onclick="previousQuestion({{ loop.index }})">
                                <i class="bi bi-arrow-left me-2"></i>Précédent
                            </button>
                        {% else %}
                            <a href="{{ path('app_savoir_medical_categorie', {id: cours.categorieSante.id}) }}" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Quitter
                            </a>
                        {% endif %}
                        
                        {% if loop.last %}
                            <button type="button" class="btn btn-success btn-lg" onclick="submitQuiz()" id="submitBtn" disabled>
                                <i class="bi bi-check-circle me-2"></i>Terminer le quiz
                            </button>
                        {% else %}
                            <button type="button" class="btn btn-primary" onclick="nextQuestion({{ loop.index }})" id="nextBtn-{{ loop.index }}" disabled>
                                Suivant <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </form>
    {% endif %}
</div>

<script>
let currentScore = 0;
let answeredQuestions = 0;
let totalQuestions = {{ questions|length }};
let userAnswers = {};

document.querySelectorAll('.option-card').forEach(card => {
    card.addEventListener('click', function() {
        const radio = this.querySelector('input[type="radio"]');
        const container = this.closest('.options-container');
        const questionId = container.dataset.questionId;
        
        // Get correct answer (this is the LETTER: A, B, C, or D)
        const correctAnswerLetter = container.dataset.correctAnswer.trim().toUpperCase();
        
        // Get the selected option's letter (A, B, C, D)
        const selectedOptionIndex = parseInt(this.dataset.optionIndex);
        const selectedLetter = ['A', 'B', 'C', 'D'][selectedOptionIndex];
        
        const questionCard = this.closest('.question-card');
        const questionNumber = questionCard.id.split('-')[1];
        
        // Prevent multiple clicks
        if (container.dataset.answered === 'true') {
            return;
        }
        container.dataset.answered = 'true';
        
        // Remove previous selections
        container.querySelectorAll('.option-card').forEach(opt => {
            opt.classList.remove('selected', 'correct', 'incorrect');
        });
        
        // Mark as selected
        radio.checked = true;
        
        // Check if answer is correct by comparing LETTERS
        const isCorrect = selectedLetter === correctAnswerLetter;
        
        console.log('=== Answer Check ===');
        console.log('Selected Letter:', selectedLetter);
        console.log('Correct Letter:', correctAnswerLetter);
        console.log('Is Correct:', isCorrect);
        
        setTimeout(() => {
            if (isCorrect) {
                // Mark selected answer as correct (green circle)
                this.classList.add('correct');
                currentScore += 10;
                updateScore();
                console.log('✓ Correct answer!');
            } else {
                // Mark selected answer as incorrect (red circle)
                this.classList.add('incorrect');
                console.log('✗ Incorrect answer!');
                
                // Find and highlight the correct answer by letter
                container.querySelectorAll('.option-card').forEach(opt => {
                    const optIndex = parseInt(opt.dataset.optionIndex);
                    const optLetter = ['A', 'B', 'C', 'D'][optIndex];
                    if (optLetter === correctAnswerLetter) {
                        opt.classList.add('correct');
                        console.log('✓ Highlighted correct answer:', optLetter);
                    }
                });
            }
            
            // Show explanation
            const explanationBox = questionCard.querySelector('.explanation-box');
            if (explanationBox) {
                explanationBox.style.display = 'block';
            }
            
            // Disable all options
            container.querySelectorAll('.option-card').forEach(opt => {
                opt.style.pointerEvents = 'none';
            });
            
            // Store answer
            userAnswers[questionId] = {
                selected: selectedLetter,
                correct: isCorrect,
                points: isCorrect ? 10 : 0
            };
            
            // Update progress
            answeredQuestions++;
            updateProgress();
            
            // Enable next/submit button
            const nextBtn = document.getElementById('nextBtn-' + questionNumber);
            const submitBtn = document.getElementById('submitBtn');
            if (nextBtn) {
                nextBtn.disabled = false;
                console.log('✓ Enabled next button');
            }
            if (submitBtn) {
                submitBtn.disabled = false;
                console.log('✓ Enabled submit button');
            }
            
        }, 300);
    });
});

function updateScore() {
    document.getElementById('currentScore').textContent = currentScore;
}

function updateProgress() {
    const percentage = (answeredQuestions / totalQuestions) * 100;
    const progressBar = document.getElementById('progressBar');
    const progressText = document.getElementById('progressText');
    
    progressBar.style.width = percentage + '%';
    progressBar.setAttribute('aria-valuenow', percentage);
    progressText.textContent = answeredQuestions + ' / ' + totalQuestions;
}

function nextQuestion(current) {
    document.getElementById('question-' + current).style.display = 'none';
    document.getElementById('question-' + (current + 1)).style.display = 'block';
    window.scrollTo(0, 0);
}

function previousQuestion(current) {
    document.getElementById('question-' + current).style.display = 'none';
    document.getElementById('question-' + (current - 1)).style.display = 'block';
    window.scrollTo(0, 0);
}

function submitQuiz() {
    document.getElementById('reponsesInput').value = JSON.stringify(userAnswers);
    document.getElementById('quizForm').submit();
}

function showNotification(message, type) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'check-circle' : 'x-circle';
    
    const notification = document.createElement('div');
    notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
    notification.style.zIndex = '9999';
    notification.innerHTML = `
        <i class="bi bi-${icon} me-2"></i>${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.remove();
    }, 3000);
}

// Translation functionality for quiz questions and answers
document.addEventListener('DOMContentLoaded', function() {
    const questions = document.querySelectorAll('.question-card');
    
    questions.forEach(function(questionCard) {
        const optionsContainer = questionCard.querySelector('.options-container');
        if (!optionsContainer) return;
        
        const questionId = optionsContainer.dataset.questionId;
        const languageSelect = document.getElementById('translation-language-select-q' + questionId);
        const translateBtn = document.getElementById('translate-btn-q' + questionId);
        const ttsQuestionBtn = document.getElementById('tts-question-btn-q' + questionId);
        const translationAlert = document.getElementById('translation-alert-q' + questionId);
        const translationMessage = document.getElementById('translation-message-q' + questionId);

        // TTS for question text and all options
        if (ttsQuestionBtn && window.ttsPlayer) {
            ttsQuestionBtn.addEventListener('click', function() {
                const questionTextElement = document.getElementById('question-text-' + questionId);
                if (!questionTextElement) {
                    console.error('Question text element not found');
                    return;
                }
                
                const questionText = questionTextElement.textContent;
                const optionCards = optionsContainer.querySelectorAll('.option-card');
                
                // Build full text: question + all options
                let fullText = questionText + '. Les réponses possibles sont: ';
                
                optionCards.forEach((card, index) => {
                    const optionTextElement = card.querySelector('.option-text');
                    if (optionTextElement) {
                        const optionText = optionTextElement.textContent;
                        const letter = ['A', 'B', 'C', 'D'][index];
                        fullText += letter + '. ' + optionText + '. ';
                    }
                });
                
                window.ttsPlayer.play(fullText.trim(), 'fr-FR', 'female', ttsQuestionBtn);
            });
        }

        // Load supported languages
        fetch('{{ path("app_translation_languages") }}')
            .then(r => r.json())
            .then(data => {
                languageSelect.innerHTML = '<option value="" disabled selected>Traduire</option>';
                Object.entries(data.languages).forEach(([code, name]) => {
                    const option = document.createElement('option');
                    option.value = code;
                    option.textContent = name;
                    languageSelect.appendChild(option);
                });
            })
            .catch(err => console.error('Failed to load languages:', err));

        translateBtn.addEventListener('click', async function() {
            const targetLanguage = languageSelect.value;
            if (!targetLanguage) {
                showAlert('Veuillez sélectionner une langue', 'warning');
                return;
            }

            translateBtn.disabled = true;
            translateBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            try {
                // Translate question
                const questionText = document.getElementById('question-text-' + questionId).textContent;
                const questionResponse = await fetch('{{ path("app_translation_translate") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        text: questionText,
                        targetLanguage: targetLanguage,
                        sourceLanguage: 'auto'
                    })
                });

                const questionResult = await questionResponse.json();

                if (questionResponse.ok && questionResult.translated) {
                    document.getElementById('translated-question-text-' + questionId).textContent = questionResult.translated;
                    document.getElementById('translated-question-' + questionId).style.display = 'block';
                }

                // Translate all answer options
                const optionsContainer = document.getElementById('options-container-' + questionId);
                const optionCards = optionsContainer.querySelectorAll('.option-card');
                
                for (const optionCard of optionCards) {
                    const optionTextSpan = optionCard.querySelector('.option-text');
                    const optionTranslationSpan = optionCard.querySelector('.option-translation');
                    const originalText = optionTextSpan.dataset.original;

                    const optionResponse = await fetch('{{ path("app_translation_translate") }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            text: originalText,
                            targetLanguage: targetLanguage,
                            sourceLanguage: 'auto'
                        })
                    });

                    const optionResult = await optionResponse.json();

                    if (optionResponse.ok && optionResult.translated) {
                        optionTranslationSpan.textContent = ' → ' + optionResult.translated;
                        optionTranslationSpan.style.display = 'inline';
                    }
                }

                // Translate explanation if it exists
                const explanationText = document.getElementById('explanation-text-' + questionId);
                if (explanationText && explanationText.textContent.trim()) {
                    const explanationResponse = await fetch('{{ path("app_translation_translate") }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            text: explanationText.textContent,
                            targetLanguage: targetLanguage,
                            sourceLanguage: 'auto'
                        })
                    });

                    const explanationResult = await explanationResponse.json();

                    if (explanationResponse.ok && explanationResult.translated) {
                        document.getElementById('translated-explanation-text-' + questionId).textContent = explanationResult.translated;
                        document.getElementById('translated-explanation-' + questionId).style.display = 'block';
                    }
                }

                showAlert('Traduction réussie!', 'success');
            } catch (error) {
                showAlert('Erreur de traduction: ' + error.message, 'danger');
            } finally {
                translateBtn.disabled = false;
                translateBtn.innerHTML = '<i class="bi bi-translate"></i>';
            }
        });

        function showAlert(message, type) {
            translationMessage.textContent = message;
            translationAlert.className = 'alert alert-' + type;
            translationAlert.style.display = 'block';
            
            setTimeout(() => {
                translationAlert.style.display = 'none';
            }, 4000);
        }
    });
});
</script>
{% endblock %}
