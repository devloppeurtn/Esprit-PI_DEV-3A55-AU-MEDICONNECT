{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouvelle' }} Catégorie - MediConnect{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <style>
        .form-header {
            background: linear-gradient(135deg, #175cdd 0%, #1a4db5 100%);
            color: white;
            padding: 3rem 0;
            margin-bottom: 2rem;
        }
        
        .form-container {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #333;
        }
        
        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #dee2e6;
            padding: 0.75rem 1rem;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #175cdd;
            box-shadow: 0 0 0 0.2rem rgba(23, 92, 221, 0.25);
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #175cdd 0%, #1a4db5 100%);
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-weight: 600;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(23, 92, 221, 0.3);
        }
    </style>
{% endblock %}

{% block body %}
<div class="form-header">
    <div class="container">
        <a href="{{ path('app_savoir_medical_index') }}" class="btn btn-light btn-sm mb-3">
            <i class="bi bi-arrow-left me-1"></i>Retour aux catégories
        </a>
        <h1 class="display-5 mb-2">
            <i class="bi bi-{{ isEdit ? 'pencil-square' : 'plus-circle' }} me-2"></i>
            {{ isEdit ? 'Modifier la catégorie' : 'Nouvelle catégorie' }}
        </h1>
        <p class="mb-0">{{ isEdit ? 'Modifiez les informations de la catégorie' : 'Créez une nouvelle catégorie de santé' }}</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-container">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>{{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>{{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                {{ form_start(form) }}
                
                <div class="mb-4">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom) }}
                    {{ form_errors(form.nom) }}
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Le nom de la catégorie (ex: Cardiologie, Pédiatrie, Anatomie...)
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type) }}
                    {{ form_errors(form.type) }}
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Culture Générale: connaissances générales en santé. Spécialité Médicale: domaines médicaux spécialisés.
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Description détaillée de la catégorie (optionnel)
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="{{ path('app_savoir_medical_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Annuler
                    </a>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-{{ isEdit ? 'check-circle' : 'plus-circle' }} me-2"></i>
                        {{ isEdit ? 'Enregistrer les modifications' : 'Créer la catégorie' }}
                    </button>
                </div>

                {{ form_end(form) }}

                {% if isEdit and is_granted('ROLE_ADMIN') %}
                    <hr class="my-4">
                    <div class="border-danger border rounded p-3">
                        <h6 class="text-danger mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>Zone de danger
                        </h6>
                        <p class="text-muted small mb-3">
                            La suppression de cette catégorie supprimera également tous les cours et progressions associés. Cette action est irréversible.
                        </p>
                        <form method="post" action="{{ path('app_savoir_medical_supprimer_categorie', {id: categorie.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ? Cette action est irréversible.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2"></i>Supprimer la catégorie
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
