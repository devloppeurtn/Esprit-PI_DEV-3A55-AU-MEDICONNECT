{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouvelle' }} Cat�gorie - MediConnect{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <style>
        .form-header {
            background: transparent;
            color: #333;
            padding: 3rem 0;
            margin-bottom: 2rem;
        }
        
        .form-container {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #333;
        }
        
        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #dee2e6;
            padding: 0.75rem 1rem;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #175cdd;
            box-shadow: 0 0 0 0.2rem rgba(23, 92, 221, 0.25);
        }
        
        .btn-primary {
            background: #175cdd;
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-weight: 600;
        }
        
        .btn-primary:hover {
            background: #1a4db5;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(23, 92, 221, 0.3);
        }
        
        .invalid-feedback {
            display: block;
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }
        
        .is-invalid {
            border-color: #dc3545 !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
            padding-right: calc(1.5em + 0.75rem);
        }
        
        .form-error-message {
            background: #f8d7da;
            border: 1px solid #f5c2c7;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            color: #842029;
        }
    </style>
{% endblock %}

{% block body %}
<div class="form-header">
    <div class="container">
        <a href="{{ path('app_savoir_medical_index') }}" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left me-1"></i>Retour aux catégories
        </a>
        <h1 class="display-5 mb-2">
            <i class="bi bi-{{ isEdit ? 'pencil-square' : 'plus-circle' }} me-2"></i>
            {{ isEdit ? 'Modifier la catégorie' : 'Nouvelle catégorie' }}
        </h1>
        <p class="mb-0">{{ isEdit ? 'Modifiez les informations de la catégorie' : 'Créez une nouvelle catégorie de santé' }}</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-container">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>{{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>{{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
                
                {# Custom validation error message #}
                <div id="formErrorMessage" class="form-error-message" style="display: none;">
                    <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Erreur de validation</strong>
                    <ul id="errorList" class="mb-0 mt-2"></ul>
                </div>

                {{ form_start(form, {'attr': {'id': 'categoryForm', 'novalidate': 'novalidate'}}) }}
                
                <div class="mb-4">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom) }}
                    {{ form_errors(form.nom) }}
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Le nom de la catégorie (ex: Cardiologie, Pédiatrie, Anatomie...)
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type) }}
                    {{ form_errors(form.type) }}
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Culture Générale: connaissances générales en santé. Spécialité Médicale: domaines médicaux spécialisés.
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Description détaillée de la catégorie (optionnel)
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="{{ path('app_savoir_medical_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Annuler
                    </a>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-{{ isEdit ? 'check-circle' : 'plus-circle' }} me-2"></i>
                        {{ isEdit ? 'Enregistrer les modifications' : 'Cr�er la cat�gorie' }}
                    </button>
                </div>

                {{ form_end(form) }}

                {% if isEdit and is_granted('ROLE_ADMIN') %}
                    <hr class="my-4">
                    <div class="border-danger border rounded p-3">
                        <h6 class="text-danger mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>Zone de danger
                        </h6>
                        <p class="text-muted small mb-3">
                            La suppression de cette catégorie supprimera également tous les cours et progressions associés. Cette action est irréversible.
                        </p>
                        <form method="post" action="{{ path('app_savoir_medical_supprimer_categorie', {id: categorie.id}) }}" onsubmit="return confirm('�tes-vous s�r de vouloir supprimer cette cat�gorie ? Cette action est irr�versible.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2"></i>Supprimer la catégorie
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('categoryForm');
    const nomInput = document.querySelector('#categorie_sante_form_nom');
    const typeSelect = document.querySelector('#categorie_sante_form_type');
    const errorMessage = document.getElementById('formErrorMessage');
    const errorList = document.getElementById('errorList');
    
    // Real-time validation on input
    if (nomInput) {
        nomInput.addEventListener('input', function() {
            validateField(nomInput);
        });
        
        nomInput.addEventListener('blur', function() {
            validateField(nomInput);
        });
    }
    
    if (typeSelect) {
        typeSelect.addEventListener('change', function() {
            validateField(typeSelect);
        });
    }
    
    // Form submission validation
    form.addEventListener('submit', function(e) {
        let isValid = true;
        const errors = [];
        
        // Clear previous errors
        errorMessage.style.display = 'none';
        errorList.innerHTML = '';
        document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
        document.querySelectorAll('.invalid-feedback').forEach(el => el.remove());
        
        // Validate name
        if (!nomInput.value.trim()) {
            isValid = false;
            errors.push('Le nom de la catégorie est obligatoire');
            markFieldInvalid(nomInput, 'Le nom de la catégorie est obligatoire');
        } else if (nomInput.value.trim().length < 3) {
            isValid = false;
            errors.push('Le nom doit contenir au moins 3 caractères');
            markFieldInvalid(nomInput, 'Le nom doit contenir au moins 3 caractères');
        }
        
        // Validate type
        if (!typeSelect.value) {
            isValid = false;
            errors.push('Le type de catégorie est obligatoire');
            markFieldInvalid(typeSelect, 'Le type de catégorie est obligatoire');
        }
        
        // Show errors if validation failed
        if (!isValid) {
            e.preventDefault();
            
            // Show error message box
            errorMessage.style.display = 'block';
            errors.forEach(error => {
                const li = document.createElement('li');
                li.textContent = error;
                errorList.appendChild(li);
            });
            
            // Scroll to error message
            errorMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Focus on first invalid field
            const firstInvalid = form.querySelector('.is-invalid');
            if (firstInvalid) {
                firstInvalid.focus();
            }
        }
    });
    
    function validateField(field) {
        // Remove previous error
        field.classList.remove('is-invalid');
        const existingError = field.parentElement.querySelector('.invalid-feedback');
        if (existingError) {
            existingError.remove();
        }
        
        // Validate based on field
        if (field === nomInput) {
            if (!field.value.trim()) {
                markFieldInvalid(field, 'Le nom de la catégorie est obligatoire');
                return false;
            } else if (field.value.trim().length < 3) {
                markFieldInvalid(field, 'Le nom doit contenir au moins 3 caractères');
                return false;
            }
        } else if (field === typeSelect) {
            if (!field.value) {
                markFieldInvalid(field, 'Le type de catégorie est obligatoire');
                return false;
            }
        }
        
        return true;
    }
    
    function markFieldInvalid(field, message) {
        field.classList.add('is-invalid');
        
        const errorDiv = document.createElement('div');
        errorDiv.className = 'invalid-feedback';
        errorDiv.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>' + message;
        
        field.parentElement.appendChild(errorDiv);
    }
});
</script>
{% endblock %}
{% endblock %}
