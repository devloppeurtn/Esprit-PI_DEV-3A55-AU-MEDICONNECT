{% extends 'base.html.twig' %}

{% block title %}Savoir Médical - MediConnect{% endblock %}

{% block stylesheets %}
    <style>
        .hero-section {
            background: linear-gradient(135deg, #175cdd 0%, #1a4db5 100%);
            color: white;
            padding: 4rem 0;
            margin-bottom: 3rem;
        }
        
        .category-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: all 0.3s;
            height: 100%;
            overflow: hidden;
        }
        
        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }
        
        .category-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 2rem;
            position: relative;
        }
        
        .category-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin-bottom: 1rem;
            background: white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        
        .progress-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: white;
            border-radius: 10px;
            padding: 0.5rem 1rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        .stats-bar {
            background: white;
            border-radius: 10px;
            padding: 1rem;
            margin-top: 1rem;
            display: flex;
            justify-content: space-around;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #175cdd;
        }
        
        .stat-label {
            font-size: 0.8rem;
            color: #6c757d;
        }
    </style>
{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-3 fw-bold mb-3">📚 Savoir Médical & Intelligence Partagée</h1>
                <p class="lead mb-4">Développez vos connaissances médicales à travers des cours interactifs et des quiz validés par des professionnels</p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('app_progression_utilisateur') }}" class="btn btn-light btn-lg">
                        <i class="bi bi-graph-up me-2"></i>Voir ma progression
                    </a>
                    {% if is_granted('ROLE_MEDECIN') %}
                        <a href="{{ path('app_savoir_medical_nouvelle_categorie') }}" class="btn btn-outline-light btn-lg">
                            <i class="bi bi-plus-circle me-2"></i>Nouvelle catégorie
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <i class="bi bi-mortarboard-fill" style="font-size: 8rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    {% if categories is empty %}
        <div class="text-center py-5">
            <i class="bi bi-folder-x" style="font-size: 5rem; color: #e9ecef;"></i>
            <h3 class="mt-4 text-muted">Aucune catégorie disponible</h3>
            <p class="text-muted">Les catégories seront bientôt ajoutées par les administrateurs</p>
        </div>
    {% else %}
        <div class="row g-4">
            {% for categorie in categories %}
                {% set progression = progressionsParCategorie[categorie.id.toRfc4122()] ?? null %}
                
                <div class="col-lg-6">
                    <div class="card category-card">
                        <div class="category-header">
                            {% if progression %}
                                <div class="progress-badge">
                                    {% if progression.estComplete %}
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>Complété
                                        </span>
                                    {% elseif progression.scoreMax > 0 %}
                                        <span class="badge bg-warning">
                                            <i class="bi bi-clock-history me-1"></i>En cours
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-circle me-1"></i>Nouveau
                                        </span>
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="progress-badge">
                                    <span class="badge bg-info">
                                        <i class="bi bi-star me-1"></i>Commencer
                                    </span>
                                </div>
                            {% endif %}
                            
                            <div class="category-icon" style="color: {{ random(['#175cdd', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#20c997']) }}">
                                {% if categorie.type == 'Culture Générale' %}
                                    <i class="bi bi-globe"></i>
                                {% else %}
                                    <i class="bi bi-heart-pulse"></i>
                                {% endif %}
                            </div>
                            
                            <h4 class="fw-bold mb-2">{{ categorie.nom }}</h4>
                            <span class="badge bg-primary">{{ categorie.type }}</span>
                        </div>
                        
                        <div class="card-body">
                            <p class="text-muted">{{ categorie.description }}</p>
                            
                            {% if progression %}
                                <div class="stats-bar">
                                    <div class="stat-item">
                                        <div class="stat-value">{{ progression.scoreMax }}</div>
                                        <div class="stat-label">Score Max</div>
                                    </div>
                                    <div class="stat-item">
                                        <div class="stat-value">{{ progression.nbTentatives }}</div>
                                        <div class="stat-label">Tentatives</div>
                                    </div>
                                    {% if progression.badgeNom %}
                                        <div class="stat-item">
                                            <div class="stat-value">🏆</div>
                                            <div class="stat-label">{{ progression.badgeNom }}</div>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                            
                            <div class="d-grid gap-2 mt-3">
                                <a href="{{ path('app_savoir_medical_categorie', {id: categorie.id}) }}" class="btn btn-primary">
                                    <i class="bi bi-book me-2"></i>Explorer les cours
                                </a>
                                {% if is_granted('ROLE_MEDECIN') %}
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('app_savoir_medical_modifier_categorie', {id: categorie.id}) }}" class="btn btn-outline-secondary btn-sm flex-fill">
                                            <i class="bi bi-pencil me-1"></i>Modifier
                                        </a>
                                        <form method="post" action="{{ path('app_savoir_medical_supprimer_categorie', {id: categorie.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ? Cette action est irréversible.')" class="flex-fill">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                <i class="bi bi-trash me-1"></i>Supprimer
                                            </button>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
