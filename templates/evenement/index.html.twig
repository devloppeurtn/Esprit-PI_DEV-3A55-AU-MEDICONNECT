{% extends 'base.html.twig' %}

{% block title %}Événements - MediConnect{% endblock %}

{% block body %}
<div class="container mt-5">
<style>
.weather-pill {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 12px;
  border-radius: 18px;
  background: linear-gradient(135deg, #5e6ad2 0%, #7b4aa8 100%);
  color: #fff;
  font-size: 0.9rem;
  box-shadow: 0 10px 22px rgba(54, 64, 118, 0.28);
}
.weather-pill .weather-icon {
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  font-size: 0.95rem;
}
.weather-pill .weather-text {
  display: inline-flex;
  flex-direction: column;
  line-height: 1.1;
}
.weather-pill .weather-temp { font-weight: 700; font-size: 0.95rem; }
.weather-pill .weather-cond { text-transform: lowercase; opacity: 0.85; font-size: 0.75rem; }
</style>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-2">Événements à venir</h1>
            <p class="text-muted">Découvrez les prochains événements et inscrivez-vous</p>
        </div>
        <div>
            {% if is_granted('ROLE_ORGANISATEUR') %}
                <a href="{{ path('app_evenement_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Créer un événement
                </a>
            {% endif %}
        </div>
    </div>

    {% if aiRecommendations is defined and aiRecommendations|length > 0 %}
        <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #6b7bd6 0%, #7a4aa5 100%); color: #fff;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="rounded-circle bg-white text-dark d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Recommandations IA Personnalisees</div>
                        <small class="text-white-50">Basees sur votre dossier medical</small>
                    </div>
                    <span class="badge bg-warning text-dark ms-auto">Mode Basique</span>
                </div>
                <div class="row g-3">
                    {% for rec in aiRecommendations %}
                        {% set ev = rec.event %}
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body text-dark">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="fw-semibold">{{ ev.title }}</div>
                                        <span class="badge bg-warning text-dark">Score: {{ rec.score }}</span>
                                    </div>
                                    {% if ev.eventDate %}
                                        <div class="small text-muted mt-1"><i class="bi bi-calendar-event me-1"></i>{{ ev.eventDate|date('d/m/Y') }}</div>
                                    {% endif %}
                                    <div class="small text-muted mt-2">{{ rec.reason }}</div>
                                    <div class="mt-3">
                                        <a href="{{ path('app_evenement_show', {id: ev.id}) }}" class="btn btn-sm btn-outline-primary w-100">
                                            <i class="bi bi-eye me-1"></i>Voir les details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="small text-white-50 mt-3">
                    Ces recommandations sont generees automatiquement en analysant votre profil medical.
                </div>
            </div>
        </div>
    {% endif %}

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
    <div class="col-md-7">
        <label class="form-label mb-1">Recherche</label>
        <input type="text" name="q" class="form-control" placeholder="Nom ou description de l'evenement..." value="{{ search|default('') }}">
    </div>
    <div class="col-md-3">
        <label class="form-label mb-1">Periode</label>
        <select name="periode" class="form-select">
            <option value="tous" {% if periode|default('tous') == 'tous' %}selected{% endif %}>Tous</option>
            <option value="avenir" {% if periode|default('tous') == 'avenir' %}selected{% endif %}>A venir</option>
            <option value="passes" {% if periode|default('tous') == 'passes' %}selected{% endif %}>Passes</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-primary w-100" type="submit">
            <i class="bi bi-search me-1"></i>Filtrer
        </button>
    </div>
</form>
        </div>
    </div>

    {% if mesEvenements is defined and mesEvenements|length > 0 %}
        <div class="mb-5">
            <h4 class="mb-3"><i class="bi bi-calendar-check me-2"></i>Mes événements</h4>
            <div class="row g-3">
                {% for item in mesEvenements %}
                    <div class="col-12">
                        <div class="card shadow-sm border-start border-4 {{ item.statut.value == 'VALIDE' ? 'border-success' : (item.statut.value == 'EN_ATTENTE' ? 'border-warning' : 'border-danger') }}">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div>
                                        <h5 class="card-title mb-1">{{ item.title }}</h5>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge {{ item.statut.value == 'VALIDE' ? 'bg-success' : (item.statut.value == 'EN_ATTENTE' ? 'bg-warning text-dark' : 'bg-danger') }}">
                                                {% if item.statut.value == 'EN_ATTENTE' %}En attente de validation{% elseif item.statut.value == 'VALIDE' %}Publié{% else %}Refusé{% endif %}
                                            </span>
                                            {% if item.typeEvenement %}<span class="badge bg-primary">{{ item.typeEvenement.label() }}</span>{% endif %}
                                            {% if item.eventDate %}<span class="badge bg-info">{{ item.eventDate|date('d/m/Y') }}</span>{% endif %}
                                            {% if item.location %}<span class="badge bg-light text-dark border">{{ item.location }}</span>{% endif %}
                                        </div>
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_evenement_show', {id: item.id}) }}" class="btn btn-outline-primary"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('app_evenement_edit', {id: item.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                        <form method="POST" action="{{ path('app_evenement_delete', {id: item.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cet événement ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        <hr class="my-4">
        <h4 class="mb-3">Événements publiés</h4>
    {% endif %}

    <div id="items-list">
        {% for item in items %}
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-3">{{ item.title }}</h5>

                            <div class="d-flex flex-wrap gap-2 mb-2">
                                {% if item.typeEvenement %}<span class="badge bg-primary">{{ item.typeEvenement.label() }}</span>{% endif %}
                                {% if item.eventDate %}
                                    <span class="badge bg-info" style="font-size: 0.95rem;"><i class="bi bi-calendar-event me-1"></i>{{ item.eventDate|date('d-m-Y') }}</span>
                                {% endif %}
                                {% if item.location %}
                                    <span class="badge bg-light text-dark border" style="font-size: 0.95rem;"><i class="bi bi-geo-alt me-1"></i>{{ item.location }}</span>
                                {% endif %}
                                {% if item.location and item.eventDate %}
                                    <div class="event-weather weather-pill" data-location="{{ item.location|e('html_attr') }}" data-date="{{ item.eventDate|date('Y-m-d') }}">
                                        <span class="weather-icon"><i class="bi bi-cloud"></i></span>
                                        <span class="weather-text">
                                            <span class="weather-temp">--�C</span>
                                            <span class="weather-cond">Chargement...</span>
                                        </span>
                                    </div>
                                {% endif %}
                                {% if item.attachmentPath %}
                                    <a class="badge bg-secondary text-decoration-none" href="{{ asset(item.attachmentPath) }}" target="_blank" rel="noopener"><i class="bi bi-paperclip me-1"></i>{{ item.attachmentOriginalName ?: 'Document' }}</a>
                                {% endif %}
                            </div>

                            {% if item.content %}
                                <p class="card-text text-muted">{{ (item.content|length > 150) ? item.content|slice(0, 150) ~ '...' : item.content }}</p>
                            {% endif %}

                            <small class="text-muted"><i class="bi bi-clock"></i> Créé le {{ item.createdAt|date('d/m/Y à H:i') }}</small>
                        </div>

                        <div class="col-md-4 d-flex flex-column justify-content-center">
                            <a href="{{ path('app_evenement_show', {id: item.id}) }}" class="btn btn-success btn-lg mb-2"><i class="bi bi-check-circle me-1"></i> Participer</a>

                            <div class="btn-group btn-group-sm" role="group">
                                <a href="{{ path('app_evenement_show', {id: item.id}) }}" class="btn btn-outline-primary"><i class="bi bi-eye"></i> Détails</a>
                                {% if (is_granted('ROLE_ORGANISATEUR') or is_granted('ROLE_SECRETAIRE')) and item.organisateur and item.organisateur.id == app.user.id %}
                                    <a href="{{ path('app_evenement_edit', {id: item.id}) }}" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Modifier</a>
                                    <form method="POST" action="{{ path('app_evenement_delete', {id: item.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');"><i class="bi bi-trash"></i> Supprimer</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Aucun événement publié pour le moment.</strong>
                {% if is_granted('ROLE_ORGANISATEUR') %}
                    <a href="{{ path('app_evenement_new') }}" class="alert-link">Créez un nouvel événement</a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>

<script>
(function () {
    const nodes = document.querySelectorAll('.event-weather');
    if (!nodes.length) return;

    const codeToText = {
        0: 'ciel degage', 1: 'plutot degage', 2: 'partiellement nuageux', 3: 'nuageux',
        45: 'brouillard', 51: 'bruine legere', 53: 'bruine moderee', 55: 'bruine forte',
        61: 'pluie legere', 63: 'pluie moderee', 65: 'pluie forte', 80: 'averses', 95: 'orage'
    };

    const loadWeather = async (el) => {
        const location = el.dataset.location;
        const date = el.dataset.date;
        const tempNode = el.querySelector('.weather-temp');
        const condNode = el.querySelector('.weather-cond');
        try {
            const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(location)}&count=1&language=fr&format=json`);
            const geo = await geoRes.json();
            if (!geo.results || !geo.results.length) throw new Error('geo');

            const { latitude, longitude } = geo.results[0];
            const meteoRes = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&daily=weathercode,temperature_2m_max,temperature_2m_min&timezone=auto&start_date=${date}&end_date=${date}`);
            const meteo = await meteoRes.json();
            const d = meteo.daily;
            if (!d || !d.weathercode || !d.weathercode.length) throw new Error('meteo');

            const code = d.weathercode[0];
            const tMin = Math.round(d.temperature_2m_min[0]);
            const tMax = Math.round(d.temperature_2m_max[0]);
            const tAvg = Math.round((tMin + tMax) / 2);
            if (tempNode) tempNode.textContent = `${tAvg}�C`;
            if (condNode) condNode.textContent = codeToText[code] || 'conditions variables';
        } catch (e) {
            if (tempNode) tempNode.textContent = '--';
            if (condNode) condNode.textContent = 'indisponible';
        }
    };

    nodes.forEach(loadWeather);
})();
</script>
{% endblock %}










