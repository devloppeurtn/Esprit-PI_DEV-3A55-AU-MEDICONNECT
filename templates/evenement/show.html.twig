                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        {% if totalFeedbacks > 0 %}
                            <h2 class="display-4 mb-2" style="color: #667eea;">
                                {{ averageRating|number_format(1, '.', '') }}
                                <small class="text-muted">/5</small>
                            </h2>
                            <div class="mb-2">
                                {% for i in 1..5 %}
                                    {% if i <= averageRating %}
                                        <i class="bi bi-star-fill text-warning" style="font-size: 1.5rem;"></i>
                                    {% else %}
                                        <i class="bi bi-star text-muted" style="font-size: 1.5rem;"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <p class="text-muted mb-0">
                                Basé sur <strong>{{ totalFeedbacks }}</strong> avis
                            </p>
                        {% else %}
                            <i class="bi bi-chat-left-text text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3 mb-0">Aucun feedback pour le moment</p>
                        {% endif %}
                    </div>
                    
                    <div class="d-grid gap-2">
                        {% if totalFeedbacks > 0 %}
                            <a href="{{ path('app_evenement_feedbacks', {id: item.id}) }}" class="btn btn-outline-primary">
                                <i class="bi bi-eye me-2"></i>
                                Voir tous les feedbacks ({{ totalFeedbacks }})
                            </a>
                        {% endif %}
                        
                        {% if item.eventDate and item.eventDate < date() %}
