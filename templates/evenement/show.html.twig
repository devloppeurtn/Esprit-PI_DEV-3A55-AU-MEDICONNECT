                        {% else %}
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                Vous pourrez laisser un feedback après l'événement
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

