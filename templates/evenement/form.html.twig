{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouvel' }} événement{% endblock %}

{% block body %}
<div class="container mt-4">
    <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary mb-3">← Retour</a>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.typeEvenement) }}
                {{ form_widget(form.typeEvenement) }}
                {{ form_errors(form.typeEvenement) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.content) }}
                {{ form_widget(form.content) }}
                {{ form_errors(form.content) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.location) }}
                {{ form_widget(form.location) }}
                {{ form_errors(form.location) }}
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.eventDate) }}
                    {{ form_widget(form.eventDate) }}
                    {{ form_errors(form.eventDate) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.eventTime) }}
                    {{ form_widget(form.eventTime) }}
                    {{ form_errors(form.eventTime) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.maxParticipants) }}
                {{ form_widget(form.maxParticipants) }}
                {{ form_errors(form.maxParticipants) }}
                <div class="form-text">Laissez vide pour illimite.</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.attachmentFile) }}
                {{ form_widget(form.attachmentFile) }}
                {{ form_errors(form.attachmentFile) }}
                {% if item.attachmentPath %}
                    <div class="form-text mt-1">
                        Document actuel:
                        <a href="{{ asset(item.attachmentPath) }}" target="_blank" rel="noopener">{{ item.attachmentOriginalName ?: 'Voir le document' }}</a>
                    </div>
                {% endif %}
            </div>

            <div class="form-check mb-3">
                {{ form_widget(form.isActive) }}
                {{ form_label(form.isActive) }}
            </div>

            <div class="d-flex justify-content-between">
                <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary">Annuler</a>
                <button class="btn btn-primary" type="submit">{{ isEdit ? 'Enregistrer' : 'Créer' }}</button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
