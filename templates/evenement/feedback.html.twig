{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Laisser' }} un feedback - {{ evenement.title }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h4 class="mb-0">
                        <i class="bi bi-star-fill me-2"></i>
                        {{ isEdit ? 'Modifier votre feedback' : 'Laisser un feedback' }}
                    </h4>
                </div>
                
                <div class="card-body p-4">
                    <!-- Informations sur l'événement -->
                    <div class="alert alert-info border-0 mb-4" style="background-color: #e3f2fd;">
                        <h5 class="mb-2">
                            <i class="bi bi-calendar-event me-2"></i>
                            {{ evenement.title }}
                        </h5>
                        {% if evenement.eventDate %}
                            <p class="mb-0 text-muted">
                                <i class="bi bi-clock me-1"></i>
                                {{ evenement.eventDate|date('d/m/Y') }}
                            </p>
                        {% endif %}
                    </div>

                    <!-- Informations participant -->
                    <div class="mb-4">
                        <p class="text-muted mb-1">
                            <i class="bi bi-person-circle me-2"></i>
                            Participant : <strong>{{ participant.firstName }} {{ participant.lastName }}</strong>
                        </p>
                        <p class="text-muted mb-0">
                            <i class="bi bi-envelope me-2"></i>
                            {{ participant.email }}
                        </p>
                    </div>

                    <hr class="my-4">

                    <!-- Formulaire de feedback -->
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-4">
                        {{ form_label(form.rating, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.rating) }}
                        {{ form_errors(form.rating) }}
                        <div class="form-text">
                            <i class="bi bi-info-circle me-1"></i>
                            Évaluez votre expérience de 1 à 5 étoiles
                        </div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.comment, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.comment) }}
                        {{ form_errors(form.comment) }}
                        <div class="form-text">
                            <i class="bi bi-info-circle me-1"></i>
                            {{ form.comment.vars.help }}
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">
                        <a href="{{ path('app_evenement_show', {id: evenement.id}) }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Retour
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-send me-2"></i>
                            {{ isEdit ? 'Mettre à jour' : 'Envoyer mon feedback' }}
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            <!-- Conseils -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="bi bi-lightbulb text-warning me-2"></i>
                        Conseils pour un bon feedback
                    </h6>
                    <ul class="mb-0 small">
                        <li>Soyez honnête et constructif</li>
                        <li>Mentionnez ce qui vous a plu et ce qui pourrait être amélioré</li>
                        <li>Votre avis aide à améliorer les futurs événements</li>
                        <li>Restez respectueux dans vos commentaires</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.form-select-lg {
    font-size: 1.1rem;
    padding: 0.75rem 1rem;
}

.card {
    border-radius: 15px;
    overflow: hidden;
}

.card-header {
    border-bottom: none;
    padding: 1.5rem;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    transition: transform 0.2s;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
}
</style>
{% endblock %}
