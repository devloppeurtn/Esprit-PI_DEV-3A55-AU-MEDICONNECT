{% extends 'base.html.twig' %}

{% block title %}Feedbacks - {{ evenement.title }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <!-- En-tête -->
    <div class="mb-4">
        <a href="{{ path('app_evenement_show', {id: evenement.id}) }}" class="btn btn-outline-secondary mb-3">
            <i class="bi bi-arrow-left me-1"></i>
            Retour à l'événement
        </a>
        
        <h1 class="mb-2">
            <i class="bi bi-star-fill text-warning me-2"></i>
            Feedbacks des participants
        </h1>
        <p class="text-muted">{{ evenement.title }}</p>
    </div>

    <div class="row">
        <!-- Statistiques -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="display-4 mb-2" style="color: #667eea;">
                        {{ averageRating|number_format(1, '.', '') }}
                        <small class="text-muted">/5</small>
                    </h3>
                    <div class="mb-3">
                        {% for i in 1..5 %}
                            {% if i <= averageRating %}
                                <i class="bi bi-star-fill text-warning" style="font-size: 1.5rem;"></i>
                            {% else %}
                                <i class="bi bi-star text-muted" style="font-size: 1.5rem;"></i>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <p class="text-muted mb-0">
                        Basé sur <strong>{{ totalFeedbacks }}</strong> avis
                    </p>
                </div>
            </div>

            <!-- Distribution des notes -->
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-body">
                    <h6 class="mb-3">Distribution des notes</h6>
                    {% for rating in 5..1 %}
                        <div class="d-flex align-items-center mb-2">
                            <span class="me-2" style="min-width: 60px;">
                                {{ rating }} <i class="bi bi-star-fill text-warning"></i>
                            </span>
                            <div class="progress flex-grow-1" style="height: 20px;">
                                {% set percentage = totalFeedbacks > 0 ? (ratingDistribution[rating] / totalFeedbacks * 100) : 0 %}
                                <div class="progress-bar bg-warning" role="progressbar" 
                                     style="width: {{ percentage }}%"
                                     aria-valuenow="{{ percentage }}" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                </div>
                            </div>
                            <span class="ms-2 text-muted" style="min-width: 30px;">
                                {{ ratingDistribution[rating] }}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Liste des feedbacks -->
        <div class="col-md-8">
            {% if feedbacks|length > 0 %}
                {% for feedback in feedbacks %}
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1">
                                        <i class="bi bi-person-circle me-2"></i>
                                        {{ feedback.participantName }}
                                    </h6>
                                    <div class="mb-2">
                                        {% for i in 1..5 %}
                                            {% if i <= feedback.rating %}
                                                <i class="bi bi-star-fill text-warning"></i>
                                            {% else %}
                                                <i class="bi bi-star text-muted"></i>
                                            {% endif %}
                                        {% endfor %}
                                        <span class="badge bg-primary ms-2">{{ feedback.rating }}/5</span>
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>
                                    {{ feedback.createdAt|date('d/m/Y à H:i') }}
                                    {% if feedback.updatedAt %}
                                        <br>
                                        <span class="badge bg-secondary mt-1">Modifié</span>
                                    {% endif %}
                                </small>
                            </div>
                            
                            {% if feedback.comment %}
                                <div class="mt-3 p-3 bg-light rounded">
                                    <p class="mb-0" style="white-space: pre-wrap;">{{ feedback.comment }}</p>
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic mb-0">
                                    <i class="bi bi-chat-quote me-1"></i>
                                    Aucun commentaire laissé
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-chat-left-text text-muted" style="font-size: 4rem;"></i>
                        <h5 class="mt-3 mb-2">Aucun feedback pour le moment</h5>
                        <p class="text-muted">
                            Soyez le premier à partager votre expérience sur cet événement!
                        </p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.card {
    border-radius: 10px;
    transition: transform 0.2s;
}

.card:hover {
    transform: translateY(-2px);
}

.progress {
    border-radius: 10px;
}

.progress-bar {
    border-radius: 10px;
}

.bi-star-fill {
    color: #ffc107;
}
</style>
{% endblock %}
