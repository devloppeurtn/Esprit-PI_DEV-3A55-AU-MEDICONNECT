{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - MediConnect{% endblock %}

{% block body_class %}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/auth.css') }}" rel="stylesheet">
    <style>
        .form-control.is-invalid {
            border-color: #dc3545;
            padding-right: calc(1.5em + 0.75rem);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 3.6 .4.4.4-.4'/%3e%3cpath d='m6 6v2.8'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
        .form-control.is-invalid:focus {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }
    </style>
{% endblock %}

{% block body %}
<section class="vh-100 auth-section" style="background-color: #ffffff;">
  <div class="container py-5 h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col col-xl-10">
        <div class="card auth-card" style="border-radius: 1rem;">
          <div class="row g-0">
            <div class="col-md-6 col-lg-5 d-none d-md-block auth-image-col">
              <div class="auth-image-wrapper">
                <img src="{{ asset('assets/img/logomed.png') }}" alt="MediConnect" class="auth-background-logo" />
                <div class="auth-overlay-text">
                  <h2 class="text-white mb-3">Mot de passe oublié</h2>
                  <p class="text-white">Entrez votre email pour recevoir un lien de réinitialisation</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 col-lg-7 d-flex align-items-center">
              <div class="card-body p-4 p-lg-5 text-black">
                <div class="d-flex align-items-center mb-3 pb-1">
                  <img src="{{ asset('assets/img/logomed.png') }}" alt="Logo MediConnect" class="auth-form-logo me-3">
                  <span class="h1 fw-bold mb-0" style="color: #112344;">MediConnect</span>
                </div>

                <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px; color: #112344;">Réinitialiser votre mot de passe</h5>

                {% for message in app.flashes('error') %}
                  <div class="alert alert-danger mb-4">{{ message }}</div>
                {% endfor %}

                {% for message in app.flashes('success') %}
                  <div class="alert alert-success mb-4">{{ message }}</div>
                {% endfor %}

                <div id="forgotPasswordAlertContainer"></div>

                {{ form_start(form, {'attr': {'class': 'auth-form', 'id': 'forgotPasswordForm', 'novalidate': 'novalidate'}}) }}
                  {{ form_row(form.email) }}
                  <div class="pt-1 mb-4">
                    <button class="btn btn-primary btn-lg btn-block w-100" type="submit" id="forgotPasswordSubmitBtn" style="background-color: #175cdd;">
                      <span class="spinner-border spinner-border-sm d-none me-2" role="status" aria-hidden="true"></span>
                      Envoyer le lien
                    </button>
                  </div>
                {{ form_end(form) }}

                <p class="mb-0">
                  <a href="{{ path('app_login') }}" style="color: #175cdd;">Retour à la connexion</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('forgotPasswordForm');
    if (!form) return;
    
    const submitBtn = document.getElementById('forgotPasswordSubmitBtn');
    const alertContainer = document.getElementById('forgotPasswordAlertContainer');
    
    function showAlert(message, type = 'danger') {
        alertContainer.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
    }
    
    function clearAlert() {
        alertContainer.innerHTML = '';
    }
    
        function validateEmail(email) {
            const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return re.test(email);
        }
        
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            clearAlert();
            
            const emailInput = form.querySelector('[name*="email"]');
            const email = emailInput ? emailInput.value.trim() : '';
            
            // Validation email
            if (!email) {
                showAlert('L\'email est requis');
                if (emailInput) emailInput.classList.add('is-invalid');
                return;
            }
            if (email.length > 180) {
                showAlert('L\'email est trop long (maximum 180 caractères)');
                if (emailInput) emailInput.classList.add('is-invalid');
                return;
            }
            if (!validateEmail(email)) {
                showAlert('Format d\'email invalide');
                if (emailInput) emailInput.classList.add('is-invalid');
                return;
            }
            
            if (emailInput) emailInput.classList.remove('is-invalid');
        
        submitBtn.disabled = true;
        submitBtn.querySelector('.spinner-border').classList.remove('d-none');
        
        fetch('{{ path('app_api_forgot_password') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ email: email })
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                showAlert(result.message, 'success');
                setTimeout(() => {
                    window.location.href = result.redirect || '{{ path('app_login') }}';
                }, 3000);
            } else {
                showAlert(result.error || 'Une erreur est survenue');
                submitBtn.disabled = false;
                submitBtn.querySelector('.spinner-border').classList.add('d-none');
            }
        })
        .catch(error => {
            showAlert('Une erreur est survenue. Veuillez réessayer.');
            submitBtn.disabled = false;
            submitBtn.querySelector('.spinner-border').classList.add('d-none');
        });
    });
});
</script>
{% endblock %}
