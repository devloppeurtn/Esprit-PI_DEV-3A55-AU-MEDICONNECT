{% extends 'base_auth_standalone.html.twig' %}

{% block title %}Nouveau mot de passe - MediConnect{% endblock %}

{% block body %}
<section class="vh-100 auth-section" style="background-color: #ffffff;">
  <div class="container py-5 h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col col-xl-10">
        <div class="card auth-card" style="border-radius: 1rem;">
          <div class="row g-0">
            <div class="col-md-6 col-lg-5 d-none d-md-block auth-image-col">
              <div class="auth-image-wrapper">
                <img src="{{ asset('assets/img/logomed.png') }}" alt="MediConnect" class="auth-background-logo" onerror="this.style.display='none'"/>
                <div class="auth-overlay-text">
                  <h2 class="text-white mb-3">Nouveau mot de passe</h2>
                  <p class="text-white">Choisissez un mot de passe sécurisé</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 col-lg-7 d-flex align-items-center">
              <div class="card-body p-4 p-lg-5 text-black">
                <div class="d-flex align-items-center mb-3 pb-1">
                  <img src="{{ asset('assets/img/logomed.png') }}" alt="Logo MediConnect" class="auth-form-logo me-3" onerror="this.outerHTML='<span class=\'fs-1 text-primary me-3\'>M</span>'">
                  <span class="h1 fw-bold mb-0" style="color: #112344;">MediConnect</span>
                </div>

                <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px; color: #112344;">Définir un nouveau mot de passe</h5>

                {% for message in app.flashes('error') %}
                  <div class="alert alert-danger mb-4">{{ message }}</div>
                {% endfor %}

                {{ form_start(form, {'attr': {'class': 'auth-form', 'novalidate': 'novalidate'}}) }}
                  {{ form_row(form.password) }}
                  <div class="pt-1 mb-4">
                    <button class="btn btn-primary btn-lg btn-block w-100" type="submit" style="background-color: #175cdd;">Réinitialiser le mot de passe</button>
                  </div>
                {{ form_end(form) }}

                <p class="mb-0">
                  <a href="{{ path('app_login') }}" style="color: #175cdd;">Retour à la connexion</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
