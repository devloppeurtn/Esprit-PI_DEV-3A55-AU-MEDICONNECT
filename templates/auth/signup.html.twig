    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('signupForm');
        if (!form) {
            console.error('Formulaire signupForm non trouvé');
            return;
        }
        
        console.log('Formulaire trouvé:', form);
        
        const submitBtn = document.getElementById('signupSubmitBtn');
        if (!submitBtn) {
            console.error('Bouton signupSubmitBtn non trouvé');
            return;
        }
        
        const alertContainer = document.getElementById('signupAlertContainer');
        if (!alertContainer) {
            console.warn('Conteneur d\'alerte signupAlertContainer non trouvé');
        }
        
        function showAlert(message, type = 'danger') {
            // Ne plus afficher dans le conteneur d'alerte, seulement sous les champs
            // Cette fonction est gardée pour compatibilité mais ne fait rien
            console.log('Message d\'erreur:', message);
        }
        
        function showSuccessMessage(message) {
            if (alertContainer) {
                alertContainer.innerHTML = `
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="display: block !important; position: relative; z-index: 1000;">
                        <i class="bi bi-check-circle-fill me-2"></i>${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                alertContainer.style.display = 'block';
                alertContainer.style.visibility = 'visible';
                // Scroll vers le message de succès
                setTimeout(() => {
                    alertContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            } else {
                console.error('Impossible d\'afficher le message de succès: conteneur non trouvé');
            }
        }
        
        function clearAlert() {
            alertContainer.innerHTML = '';
            // Réinitialiser tous les champs d'erreur
            document.querySelectorAll('.invalid-feedback').forEach(el => {
                el.style.display = 'none';
                el.textContent = '';
            });
            document.querySelectorAll('.is-invalid').forEach(el => {
                el.classList.remove('is-invalid');
            });
        }
        
        function validateEmail(email) {
            const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return re.test(email);
        }
        
        function validateForm(data, role) {
            console.log('Validation du formulaire avec données:', {
                nomComplet: data.nomComplet || '',
                email: data.email || '',
                telephone: data.telephone || '',
                password: data.password ? '***' : '',
                confirmPassword: data.confirmPassword ? '***' : '',
                specialite: data.specialite || '',
                role: role
            });
            
            // Validation nom complet
            const nomComplet = (data.nomComplet || '').trim();
            if (!nomComplet) {
                console.log('Erreur: nom complet vide');
                return { valid: false, error: 'Le nom complet est requis', field: 'nomComplet' };
            }
            if (nomComplet.length < 2) {
                return { valid: false, error: 'Le nom complet doit contenir au moins 2 caractères', field: 'nomComplet' };
            }
            if (nomComplet.length > 255) {
                return { valid: false, error: 'Le nom complet ne doit pas dépasser 255 caractères', field: 'nomComplet' };
            }
            
            // Validation email
            const email = (data.email || '').trim();
            if (!email) {
                console.log('Erreur: email vide');
                return { valid: false, error: 'L\'email est requis', field: 'email' };
            }
            if (email.length > 180) {
                return { valid: false, error: 'L\'email est trop long (maximum 180 caractères)', field: 'email' };
            }
            if (!validateEmail(email)) {
                return { valid: false, error: 'Format d\'email invalide', field: 'email' };
            }
            
            // Validation téléphone (obligatoire pour tous)
            const telephone = (data.telephone || '').trim();
            if (!telephone) {
                console.log('Erreur: téléphone vide');
                return { valid: false, error: 'Le numéro de téléphone est requis', field: 'telephone' };
            }
            if (telephone.length > 20) {
                return { valid: false, error: 'Le numéro de téléphone est trop long (maximum 20 caractères)', field: 'telephone' };
            }
            
            // Validation spécialité (obligatoire pour médecins)
            if (role === 'MEDECIN') {
