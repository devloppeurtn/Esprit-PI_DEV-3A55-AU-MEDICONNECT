                    return { valid: false, error: 'La spécialité est requise pour les médecins', field: 'specialite' };
                }
                if (specialite.length > 255) {
                    return { valid: false, error: 'La spécialité est trop longue (maximum 255 caractères)', field: 'specialite' };
                }
            }
            
            // Validation mot de passe
            const password = data.password || '';
            if (!password) {
                console.log('Erreur: mot de passe vide');
                return { valid: false, error: 'Le mot de passe est requis', field: 'password' };
            }
            if (password.length < 6) {
                return { valid: false, error: 'Le mot de passe doit contenir au moins 6 caractères', field: 'password' };
            }
            if (password.length > 4096) {
                return { valid: false, error: 'Le mot de passe est trop long', field: 'password' };
            }
            
            // Validation confirmation mot de passe
            const confirmPassword = data.confirmPassword || '';
            if (!confirmPassword) {
                console.log('Erreur: confirmation mot de passe vide');
                return { valid: false, error: 'Veuillez confirmer votre mot de passe', field: 'confirmPassword' };
            }
            if (password !== confirmPassword) {
                return { valid: false, error: 'Les mots de passe ne correspondent pas', field: 'confirmPassword' };
            }
            
            console.log('Validation réussie');
            return { valid: true };
        }
        
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            console.log('Soumission du formulaire interceptée');
            
            clearAlert();
            
            // Utiliser FormData et convertir en objet en gérant les noms préfixés de Symfony
            const formData = new FormData(form);
            const data = {};
            
            // Convertir FormData en objet en extrayant le nom du champ (après le préfixe)
            for (let [key, value] of formData.entries()) {
                // Symfony génère des noms comme "signup[nomComplet]" ou "signup_nomComplet"
                // Extraire le nom du champ après le préfixe
                let fieldName = key;
                if (key.includes('[') && key.includes(']')) {
                    // Format: signup[nomComplet] -> nomComplet
                    const match = key.match(/\[([^\]]+)\]/);
                    if (match) {
                        fieldName = match[1];
                    }
                } else if (key.includes('_')) {
                    // Format: signup_nomComplet -> nomComplet
                    const parts = key.split('_');
                    fieldName = parts[parts.length - 1];
                }
                
                // Stocker la valeur avec le nom simplifié
                // Ne pas stocker les fichiers ici, ils seront ajoutés séparément
                if (value instanceof File) {
                    // Les fichiers seront gérés séparément
                    continue;
                }
                if (!data[fieldName] || data[fieldName] === '') {
                    data[fieldName] = value;
                }
            }
            
            // Debug: afficher tous les éléments du formulaire et FormData
            console.log('FormData entries:');
            for (let [key, value] of formData.entries()) {
                let displayValue = '';
                if (value) {
                    if (key.includes('password')) {
                        displayValue = '***';
                    } else if (value instanceof File) {
                        displayValue = `[File: ${value.name}, ${value.size} bytes]`;
                    } else if (typeof value === 'string') {
                        displayValue = value.substring(0, 30);
                    } else {
                        displayValue = String(value).substring(0, 30);
                    }
                }
                console.log(`  "${key}" = "${displayValue}"`);
            }
            
            console.log('Données extraites:', {
                nomComplet: data.nomComplet || '',
                nomCompletLength: (data.nomComplet || '').length,
                email: data.email || '',
                password: data.password ? '***' : ''
            });
            
            // Debug: vérifier que les valeurs sont bien récupérées
            console.log('Données du formulaire:', {
                nomComplet: data.nomComplet,
                nomCompletLength: (data.nomComplet || '').length,
                email: data.email,
                telephone: data.telephone,
                password: data.password ? '***' : ''
            });
            
            // Validation côté client
            const role = '{{ role ? role.value : 'PATIENT' }}';
            console.log('Début validation, rôle:', role);
            const validation = validateForm(data, role);
            console.log('Résultat validation:', validation);
            
            if (!validation.valid) {
                console.log('Validation échouée:', validation.error);
                
                // Fonction pour mettre en évidence le champ en erreur et afficher le message
                function highlightField(fieldName, errorMessage) {
                    console.log('Mise en évidence du champ:', fieldName);
                    const field = document.getElementById(fieldName) ||
                                 form.querySelector(`input[name*="${fieldName}"], textarea[name*="${fieldName}"], select[name*="${fieldName}"]`) ||
                                 Array.from(form.elements).find(el => el.name && el.name.includes(fieldName));
                    
                    if (field) {
                        console.log('Champ trouvé:', fieldName, field);
                        field.classList.add('is-invalid');
                        // Afficher le message d'erreur sous le champ
                        const errorDiv = document.getElementById(fieldName + '-error');
                        if (errorDiv) {
                            errorDiv.textContent = errorMessage;
                            errorDiv.style.display = 'block';
                            console.log('Message d\'erreur affiché sous le champ');
                        } else {
                            console.warn('Div d\'erreur non trouvée pour:', fieldName);
                        }
                        // Si on est dans l'étape 2, afficher l'étape 2
                        if (fieldName === 'telephone' || fieldName === 'specialite') {
                            const step2 = document.getElementById('step2');
                            if (step2) {
                                console.log('Affichage de l\'étape 2 pour le champ:', fieldName);
                                showStep(2);
                            }
                        }
                        // Scroll vers le champ
                        setTimeout(() => {
                            field.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            field.focus();
                        }, 100);
                        return true;
                    } else {
                        console.error('Champ non trouvé:', fieldName);
                        return false;
                    }
                }
                
                // Utiliser le champ spécifié dans la validation si disponible
                if (validation.field) {
                    highlightField(validation.field, validation.error);
                } else {
                    // Identifier et mettre en évidence le champ en erreur
                    let fieldHighlighted = false;
                    if (validation.error.includes('nom complet') || validation.error.includes('nom')) {
                        fieldHighlighted = highlightField('nomComplet', validation.error);
                    } else if (validation.error.includes('email')) {
                        fieldHighlighted = highlightField('email', validation.error);
                    } else if (validation.error.includes('téléphone') || validation.error.includes('telephone')) {
                        fieldHighlighted = highlightField('telephone', validation.error);
                    } else if (validation.error.includes('spécialité') || validation.error.includes('specialite')) {
                        fieldHighlighted = highlightField('specialite', validation.error);
                    } else if (validation.error.includes('mot de passe')) {
                        if (validation.error.includes('confirmer')) {
                            fieldHighlighted = highlightField('confirmPassword', validation.error);
                        } else {
                            fieldHighlighted = highlightField('password', validation.error);
                        }
                    }
                    
                    if (!fieldHighlighted) {
                        console.warn('Aucun champ spécifique trouvé, recherche du premier champ vide');
                        // Si aucun champ spécifique n'a été trouvé, essayer de trouver le premier champ vide
                        const requiredFields = ['nomComplet', 'email', 'telephone', 'password', 'confirmPassword'];
                        if (role === 'MEDECIN') {
                            requiredFields.push('specialite');
                        }
                        for (const fieldName of requiredFields) {
                            const field = document.getElementById(fieldName) || 
                                         form.querySelector(`input[name*="${fieldName}"], textarea[name*="${fieldName}"]`);
                            if (field && !field.value.trim()) {
                                highlightField(fieldName, validation.error);
                                break;
                            }
                        }
                    }
                }
                
                // Réactiver le bouton
                submitBtn.disabled = false;
                const spinner = submitBtn.querySelector('.spinner-border');
                if (spinner) spinner.classList.add('d-none');
                
                return;
            }
            
            // Désactiver le bouton et afficher le spinner
            submitBtn.disabled = true;
            const spinner = submitBtn.querySelector('.spinner-border');
            if (spinner) spinner.classList.remove('d-none');
            
            console.log('Préparation de l\'envoi AJAX...');
            
            // Préparer FormData pour l'envoi (nécessaire pour les fichiers)
            const submitFormData = new FormData();
            submitFormData.append('email', data.email.trim());
            submitFormData.append('nomComplet', data.nomComplet.trim());
            submitFormData.append('password', data.password);
            submitFormData.append('confirmPassword', data.confirmPassword);
            submitFormData.append('telephone', (data.telephone || '').trim());
            submitFormData.append('role', '{{ role ? role.value : 'PATIENT' }}');
            
            // Ajouter la photo si présente
            const photoInput = form.querySelector('input[type="file"][name*="photo"], input[type="file"][id="photo"]');
            if (photoInput && photoInput.files && photoInput.files[0]) {
                submitFormData.append('photo', photoInput.files[0]);
                console.log('Photo ajoutée:', photoInput.files[0].name);
            }
            
            // Ajouter les champs optionnels selon le rôle
            if (data.dateNaissance) submitFormData.append('dateNaissance', data.dateNaissance);
            if (data.adresse && data.adresse.trim()) submitFormData.append('adresse', data.adresse.trim());
            if (data.specialite && data.specialite.trim()) submitFormData.append('specialite', data.specialite.trim());
            if (data.adresseCabinet && data.adresseCabinet.trim()) submitFormData.append('adresseCabinet', data.adresseCabinet.trim());
            if (data.numeroLicence && data.numeroLicence.trim()) submitFormData.append('numeroLicence', data.numeroLicence.trim());
            
            console.log('Envoi de la requête AJAX vers:', '{{ path('app_api_signup') }}');
            
            // Envoyer via AJAX avec FormData (multipart/form-data)
            fetch('{{ path('app_api_signup') }}', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                    // Ne pas définir Content-Type pour FormData, le navigateur le fait automatiquement
                },
                body: submitFormData
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err));
                }
                return response.json();
            })
            .then(result => {
                console.log('Réponse serveur:', result);
                if (result.success) {
                    console.log('Inscription réussie, affichage du message de succès');
                    // Réactiver le bouton
                    submitBtn.disabled = false;
                    const spinner = submitBtn.querySelector('.spinner-border');
                    if (spinner) spinner.classList.add('d-none');
                    
                    // Afficher le message de succès
                    showSuccessMessage(result.message || 'Inscription réussie !');
                    
                    // Rediriger après 3 secondes
                    setTimeout(() => {
                        window.location.href = result.redirect || '{{ path('app_login') }}';
                    }, 3000);
                } else {
                    const errorMsg = result.error || 'Une erreur est survenue lors de l\'inscription';
                    // Fonction pour mettre en évidence les champs en erreur et afficher le message
                    function highlightErrorField(fieldName, message) {
                        const field = findField(fieldName);
                        if (field) {
                            field.classList.add('is-invalid');
                            const errorDiv = document.getElementById(fieldName + '-error');
                            if (errorDiv) {
                                errorDiv.textContent = message;
                                errorDiv.style.display = 'block';
                            }
                            // Si on est dans l'étape 2, afficher l'étape 2
                            if (fieldName === 'telephone' || fieldName === 'specialite') {
                                const step2 = document.getElementById('step2');
                                if (step2) {
                                    showStep(2);
                                }
                            }
                            // Scroll vers le champ
                            setTimeout(() => {
                                field.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                field.focus();
                            }, 100);
                        }
                    }
                    
                    // Identifier et mettre en évidence le champ en erreur
                    if (errorMsg.includes('nom complet') || errorMsg.includes('nom')) {
                        highlightErrorField('nomComplet', errorMsg);
                    } else if (errorMsg.includes('email')) {
                        highlightErrorField('email', errorMsg);
                    } else if (errorMsg.includes('téléphone') || errorMsg.includes('telephone')) {
                        highlightErrorField('telephone', errorMsg);
                    } else if (errorMsg.includes('spécialité') || errorMsg.includes('specialite')) {
                        highlightErrorField('specialite', errorMsg);
                    } else if (errorMsg.includes('mot de passe')) {
                        if (errorMsg.includes('confirmer')) {
                            highlightErrorField('confirmPassword', errorMsg);
                        } else {
                            highlightErrorField('password', errorMsg);
                        }
                    }
                    submitBtn.disabled = false;
                    if (spinner) spinner.classList.add('d-none');
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                const errorMessage = error.error || error.message || 'Une erreur est survenue lors de l\'inscription. Veuillez réessayer.';
                // Afficher l'erreur dans le premier champ trouvé ou dans le conteneur d'alerte comme fallback
                const nomCompletField = document.getElementById('nomComplet');
                if (nomCompletField) {
                    nomCompletField.classList.add('is-invalid');
                    const errorDiv = document.getElementById('nomComplet-error');
                    if (errorDiv) {
                        errorDiv.textContent = errorMessage;
                        errorDiv.style.display = 'block';
                    }
                } else if (alertContainer) {
                    // Fallback: afficher dans le conteneur d'alerte si aucun champ trouvé
                    alertContainer.innerHTML = `
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>${errorMessage}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    `;
                }
                submitBtn.disabled = false;
                if (spinner) spinner.classList.add('d-none');
            });
        });
        
        // Fonction helper pour trouver un champ
        function findField(fieldName, fieldType = 'input') {
            return form.querySelector(`${fieldType}[name*="${fieldName}"], ${fieldType}[id="${fieldName}"]`) ||
                   document.getElementById(fieldName) ||
                   Array.from(form.elements).find(el => el.name && el.name.includes(fieldName));
        }
        
        // Preview de photo avec design circulaire
        const photoInput = form.querySelector('input[type="file"][name*="photo"], input[type="file"][id="photo"]');
        const photoPreviewContainer = document.getElementById('photoPreviewContainer');
        const photoPlaceholder = document.getElementById('photoPlaceholder');
        const photoPreviewImg = document.getElementById('photoPreviewImg');
        const photoRemoveBtn = document.getElementById('photoRemoveBtn');
        
        if (photoInput && photoPreviewContainer && photoPlaceholder && photoPreviewImg) {
            // Hover effect
            photoPreviewContainer.addEventListener('mouseenter', function() {
                if (!photoPreviewImg.src) {
                    this.style.borderColor = '#0a58ca';
                    this.style.transform = 'scale(1.05)';
                }
            });
            
            photoPreviewContainer.addEventListener('mouseleave', function() {
                if (!photoPreviewImg.src) {
                    this.style.borderColor = '#0d6efd';
                    this.style.transform = 'scale(1)';
                }
            });
            
            // Le gestionnaire de changement de fichier sera dans le code de rognage ci-dessous
        }
        
        // Validation en temps réel - trouver les champs une seule fois
        const nomCompletInput = findField('nomComplet');
        const emailInput = findField('email');
        const telephoneInput = findField('telephone');
        const passwordInput = findField('password');
        const confirmPasswordInput = findField('confirmPassword');
        const specialiteInput = findField('specialite');
        
        // Debug: vérifier que les champs sont trouvés
        console.log('Champs trouvés pour validation:', {
            nomComplet: nomCompletInput ? '?' : '?',
            email: emailInput ? '?' : '?',
            telephone: telephoneInput ? '?' : '?',
            password: passwordInput ? '?' : '?',
            confirmPassword: confirmPasswordInput ? '?' : '?',
            specialite: specialiteInput ? '?' : '?'
        });
        
        if (nomCompletInput) {
            nomCompletInput.addEventListener('blur', function() {
                const value = this.value.trim();
                const errorDiv = document.getElementById('nomComplet-error');
                if (!value) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Le nom complet est requis';
                        errorDiv.style.display = 'block';
                    }
                } else if (value.length < 2) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Le nom complet doit contenir au moins 2 caractères';
                        errorDiv.style.display = 'block';
                    }
                } else {
                    this.classList.remove('is-invalid');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
            nomCompletInput.addEventListener('input', function() {
                if (this.classList.contains('is-invalid') && this.value.trim().length >= 2) {
                    this.classList.remove('is-invalid');
                    const errorDiv = document.getElementById('nomComplet-error');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
        }
        
        if (emailInput) {
            emailInput.addEventListener('blur', function() {
                const value = this.value.trim();
                const errorDiv = document.getElementById('email-error');
                if (!value) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'L\'email est requis';
                        errorDiv.style.display = 'block';
                    }
                } else if (!validateEmail(value)) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Format d\'email invalide';
                        errorDiv.style.display = 'block';
                    }
                } else {
                    this.classList.remove('is-invalid');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
            emailInput.addEventListener('input', function() {
                if (this.classList.contains('is-invalid') && validateEmail(this.value.trim())) {
                    this.classList.remove('is-invalid');
                    const errorDiv = document.getElementById('email-error');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
        }
        
        if (telephoneInput) {
            telephoneInput.addEventListener('blur', function() {
                const value = this.value.trim();
                const errorDiv = document.getElementById('telephone-error');
                if (!value) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Le numéro de téléphone est requis';
                        errorDiv.style.display = 'block';
                    }
                } else if (value.length > 20) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Le numéro de téléphone est trop long (maximum 20 caractères)';
                        errorDiv.style.display = 'block';
                    }
                } else {
                    this.classList.remove('is-invalid');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
            telephoneInput.addEventListener('input', function() {
                if (this.classList.contains('is-invalid') && this.value.trim() && this.value.trim().length <= 20) {
                    this.classList.remove('is-invalid');
                    const errorDiv = document.getElementById('telephone-error');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
        }
        
        if (specialiteInput) {
            specialiteInput.addEventListener('blur', function() {
                const value = this.value.trim();
                const errorDiv = document.getElementById('specialite-error');
                if (!value && role === 'MEDECIN') {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'La spécialité est requise pour les médecins';
                        errorDiv.style.display = 'block';
                    }
                } else {
                    this.classList.remove('is-invalid');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
            specialiteInput.addEventListener('input', function() {
                if (this.classList.contains('is-invalid') && this.value.trim()) {
                    this.classList.remove('is-invalid');
                    const errorDiv = document.getElementById('specialite-error');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
        }
        
        if (passwordInput) {
            passwordInput.addEventListener('blur', function() {
                const value = this.value;
                const errorDiv = document.getElementById('password-error');
                if (!value) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Le mot de passe est requis';
                        errorDiv.style.display = 'block';
                    }
                } else if (value.length < 6) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Le mot de passe doit contenir au moins 6 caractères';
                        errorDiv.style.display = 'block';
                    }
                } else {
                    this.classList.remove('is-invalid');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
            passwordInput.addEventListener('input', function() {
                if (this.classList.contains('is-invalid') && this.value.length >= 6) {
                    this.classList.remove('is-invalid');
                    const errorDiv = document.getElementById('password-error');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
                if (confirmPasswordInput && confirmPasswordInput.value) {
                    const confirmErrorDiv = document.getElementById('confirmPassword-error');
                    if (this.value === confirmPasswordInput.value) {
                        confirmPasswordInput.classList.remove('is-invalid');
                        if (confirmErrorDiv) confirmErrorDiv.style.display = 'none';
                    } else {
                        confirmPasswordInput.classList.add('is-invalid');
                        if (confirmErrorDiv) {
                            confirmErrorDiv.textContent = 'Les mots de passe ne correspondent pas';
                            confirmErrorDiv.style.display = 'block';
                        }
                    }
                }
            });
        }
        
        if (confirmPasswordInput && passwordInput) {
            confirmPasswordInput.addEventListener('blur', function() {
                const errorDiv = document.getElementById('confirmPassword-error');
                if (!this.value) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Veuillez confirmer votre mot de passe';
                        errorDiv.style.display = 'block';
                    }
                } else if (this.value !== passwordInput.value) {
                    this.classList.add('is-invalid');
                    if (errorDiv) {
                        errorDiv.textContent = 'Les mots de passe ne correspondent pas';
                        errorDiv.style.display = 'block';
                    }
                } else {
                    this.classList.remove('is-invalid');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
            confirmPasswordInput.addEventListener('input', function() {
                if (this.classList.contains('is-invalid') && this.value === passwordInput.value) {
                    this.classList.remove('is-invalid');
                    const errorDiv = document.getElementById('confirmPassword-error');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });
        }
    });
    </script>
    
