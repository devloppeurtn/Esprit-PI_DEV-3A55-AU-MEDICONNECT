{% extends 'base.html.twig' %}

{% block title %}Connexion - MediConnect{% endblock %}

{% block body_class %}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/auth.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<section class="vh-100 auth-section" style="background-color: #ffffff;">
  <div class="container py-5 h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col col-xl-10">
        <div class="card auth-card" style="border-radius: 1rem;">
          <div class="row g-0">
            <div class="col-md-6 col-lg-5 d-none d-md-block auth-image-col">
              <div class="auth-image-wrapper">
                <img src="{{ asset('assets/img/logomed.png') }}"
                  alt="MediConnect" class="auth-background-logo" />
                <div class="auth-overlay-text">
                  <h2 class="text-white mb-3">Bienvenue</h2>
                  <p class="text-white">Connectez-vous pour accéder à votre espace MediConnect</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 col-lg-7 d-flex align-items-center">
              <div class="card-body p-4 p-lg-5 text-black">

                <form method="post" action="{{ path('app_login') }}">
                  <div class="d-flex align-items-center mb-3 pb-1">
                    <img src="{{ asset('assets/img/logomed.png') }}" alt="Logo MediConnect" class="auth-form-logo me-3">
                    <span class="h1 fw-bold mb-0" style="color: #112344;">MediConnect</span>
                  </div>

                  <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px; color: #112344;">Connectez-vous à votre compte</h5>

                  {% for message in app.flashes('success') %}
                    <div class="alert alert-success mb-4">
                      {{ message }}
                    </div>
                  {% endfor %}

                  {% set error_flashes = app.flashes('error') %}
                  {% for message in error_flashes %}
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                      <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
                      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                  {% endfor %}

                  {% if error and error_flashes|length == 0 %}
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                      <i class="bi bi-exclamation-triangle-fill me-2"></i>
                      {# Comptes suspendus/bannis : vérifier en premier pour éviter "Email ou mot de passe incorrect" #}
                      {% if error.message is defined and (error.message starts with 'Votre compte' or error.message starts with 'Compte suspendu' or error.message starts with 'Compte banni') %}
                        {{ error.message }}
                      {% elseif error.messageKey == 'Invalid credentials.' %}
                        Email ou mot de passe incorrect.
                      {% elseif error.messageKey == 'User account is disabled.' %}
                        Votre compte est désactivé.
                      {% elseif error.messageKey == 'User account is locked.' %}
                        Votre compte est verrouillé.
                      {% elseif error.messageKey == 'User account has expired.' %}
                        Votre compte a expiré.
                      {% else %}
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                      {% endif %}
                      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                  {% endif %}

                  <div class="mb-4">
                    <label class="form-label" for="form2Example17">Adresse email</label>
                    <input type="email" id="form2Example17" name="_username" value="{{ last_username }}" class="form-control form-control-lg" placeholder="exemple@email.com" required autofocus />
                  </div>

                  <div class="mb-4">
                    <label class="form-label" for="form2Example27">Mot de passe</label>
                    <input type="password" id="form2Example27" name="_password" class="form-control form-control-lg" placeholder="Entrez votre mot de passe" required />
                  </div>

                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                  <div class="pt-1 mb-4">
                    <button class="btn btn-primary btn-lg btn-block w-100" type="submit" style="background-color: #175cdd;">Se connecter</button>
                  </div>

                  <a class="small text-muted" href="#!">Mot de passe oublié ?</a>
                  <p class="mb-5 pb-lg-2" style="color: #393f81;">Vous n'avez pas de compte ? <a href="{{ path('app_signup') }}"
                      style="color: #175cdd;">S'inscrire ici</a></p>
                  <div class="d-flex gap-3">
                    <a href="#!" class="small text-muted">Conditions d'utilisation</a>
                    <a href="#!" class="small text-muted">Politique de confidentialité</a>
                  </div>
                </form>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
