{% extends 'admin/base_admin.html.twig' %}

{% block title %}Mon dossier médical - MediConnect{% endblock %}

{% block admin_content %}
<div class="patient-dossier">
    <h1 class="h3 mb-4"><i class="bi bi-folder2-open me-2"></i>Mon dossier médical</h1>

    <h5 class="mb-3">Médicaments que je prends actuellement</h5>
    {% if dossier and dossier.medicamentsActuels|length > 0 %}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                {% for m in dossier.medicamentsActuels %}
                <div class="list-group-item d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-1">{{ m.medicament }}</h6>
                        {% if m.methodeUtilisation %}<p class="mb-0 text-muted small">{{ m.methodeUtilisation }}</p>{% endif %}
                    </div>
                    <form method="post" action="{{ path('app_patient_medicament_supprimer', {id: m.id}) }}" class="ms-2" onsubmit="return confirm('Retirer ce m�dicament de votre liste ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer_medicament_' ~ m.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                    </form>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% else %}
    <p class="text-muted mb-4">Aucun médicament. Vous pouvez en ajouter depuis le détail d'une consultation (bouton &laquo; Je prends ce médicament &raquo;).</p>
    {% endif %}

    <h5 class="mb-3 mt-4">Mes consultations</h5>
    {% if consultations|length > 0 %}
    <div class="row g-4">
        {% for c in consultations %}
        <div class="col-lg-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 consultation-card">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="consult-avatar">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">{{ c.medecin.nomComplet }}</h6>
                            <small class="text-muted">{{ c.medecin.specialite|default('Médecin généraliste') }}</small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <i class="bi bi-calendar3 text-primary me-2"></i>
                        <span>{{ c.date|date('d/m/Y H:i') }}</span>
                    </div>
                    {% if c.diagnostic %}
                    <p class="text-muted small mb-3">{{ c.diagnostic|length > 80 ? c.diagnostic|slice(0, 80) ~ '...' : c.diagnostic }}</p>
                    {% endif %}
                    <div class="d-flex gap-2 small text-muted mb-3">
                        {% if c.ordonnances|length > 0 %}<span><i class="bi bi-capsule me-1"></i>{{ c.ordonnances|length }} médicament(s)</span>{% endif %}
                        {% if c.rapportsMedicaux|length > 0 %}<span><i class="bi bi-file-medical me-1"></i>{{ c.rapportsMedicaux|length }} rapport(s)</span>{% endif %}
                    </div>
                    <a href="{{ path('app_patient_consultation_voir', {id: c.id}) }}" class="btn btn-sm btn-primary">
                        <i class="bi bi-eye me-1"></i>Voir le détail
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-clipboard-pulse display-4 text-muted opacity-50 d-block mb-3"></i>
            <p class="text-muted mb-0">Aucune consultation pour le moment.</p>
        </div>
    </div>
    {% endif %}

    <h5 class="mb-3 mt-4">Ajouter un document</h5>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
            {{ form_row(form.fichier) }}
            {{ form_row(form.typeDocument) }}
            {{ form_row(form.description) }}
            <button type="submit" class="btn btn-primary">Ajouter</button>
            {{ form_end(form) }}
        </div>
    </div>


    <h5 class="mb-3 mt-4">Scanner un document manuscrit (OCR)</h5>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            {% if not ocrConfigured|default(false) %}
                <div class="alert alert-warning mb-0">
                    OCR.Space non configure sur le serveur.
                    Ajoutez <code>OCR_SPACE_API_KEY</code> dans <code>.env.local</code> (ou laissez la cle demo activee).
                    puis redemarrez le serveur Symfony.
                </div>
            {% else %}
            <form method="post" action="{{ path('app_patient_document_scanner') }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('scan_document') }}">

                <div class="mb-3">
                    <label for="scan_image" class="form-label">Image a scanner</label>
                    <input
                        id="scan_image"
                        name="scan_image"
                        type="file"
                        class="form-control"
                        accept="image/jpeg,image/png,image/gif,image/webp,image/bmp,image/tiff"
                        required
                    >
                    <div class="form-text">Formats supportes: JPG, PNG, GIF, WEBP, BMP, TIFF (max 10 Mo).</div>
                </div>

                <div class="mb-3">
                    <label for="scan_type" class="form-label">Type de document</label>
                    <select id="scan_type" name="scan_type" class="form-select">
                        <option value="analyse">Analyse</option>
                        <option value="radio">Radio / Imagerie</option>
                        <option value="certificat">Certificat medical</option>
                        <option value="autre">Autre</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="scan_description" class="form-label">Description (optionnel)</label>
                    <textarea id="scan_description" name="scan_description" rows="2" class="form-control"></textarea>
                </div>

                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-upc-scan me-1"></i>Scanner (OCR)
                </button>
            </form>
            {% endif %}
        </div>
    </div>
    <h5 class="mb-3 mt-4">Mes documents</h5>
    {% if dossier and dossier.documents|length > 0 %}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Nom</th><th>Type</th><th>Date</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        {% for doc in dossier.documents %}
                        <tr>
                            <td>{{ doc.nomFichier }}</td>
                            <td>{{ doc.typeDocument|default('—') }}</td>
                            <td>{{ doc.dateAjout|date('d/m/Y') }}</td>
                            <td>
                                <a href="{{ path('app_patient_document_voir', {id: doc.id}) }}" target="_blank" class="btn btn-sm btn-outline-primary">Voir</a>
                                {% if doc.ajouteParPatient %}
                                <form method="post" action="{{ path('app_patient_document_supprimer', {id: doc.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce document ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_document_' ~ doc.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% else %}
    <p class="text-muted mb-4">Aucun document.</p>
    {% endif %}
</div>
<style>
.consultation-card { transition: transform 0.2s, box-shadow 0.2s; }
.consultation-card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,.1) !important; }
.consult-avatar { width: 48px; height: 48px; border-radius: 50%; background: rgba(13, 110, 253, 0.15); color: #0d6efd; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
</style>
{% endblock %}




