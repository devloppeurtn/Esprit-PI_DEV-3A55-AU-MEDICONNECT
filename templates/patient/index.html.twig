{% extends 'admin/base_admin.html.twig' %}

{% block title %}Mon espace - MediConnect{% endblock %}

{% block admin_content %}
<div class="patient-espace">
    <h1 class="h3 mb-4">Bienvenue {{ patient.nomComplet }}</h1>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_patient_dossier') }}" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-folder2-open fs-1 text-primary mb-2"></i>
                    <h5 class="mb-0">Mon dossier médical</h5>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_patient_medecins') }}" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-heart-pulse-fill fs-1 text-primary mb-2"></i>
                    <h5 class="mb-0">Nos médecins</h5>
                    <p class="text-muted small mb-0 mt-1">Consulter et prendre RDV</p>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_patient_rendez_vous') }}" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-calendar-event-fill fs-1 text-primary mb-2"></i>
                    <h5 class="mb-0">Mes rendez-vous</h5>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('app_patient_dossier') }}" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-file-earmark-medical-fill fs-1 text-primary mb-2"></i>
                    <h5 class="mb-0">Mes documents</h5>
                </div>
            </a>
        </div>
    </div>

    {% if rdvs|length > 0 %}
    <h5 class="mb-3">Rendez-vous récents</h5>
    <div class="row g-4">
        {% for r in rdvs|slice(0, 6) %}
        <div class="col-lg-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 rdv-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rdv-avatar rdv-avatar-medecin">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">{{ r.medecin.nomComplet }}</h6>
                                <small class="text-muted">{{ r.medecin.specialite|default('Médecin généraliste') }}</small>
                            </div>
                        </div>
                        {% if r.statut.value == 'EN_ATTENTE' %}<span class="badge bg-warning text-dark">En attente</span>
                        {% elseif r.statut.value == 'CONFIRME' %}<span class="badge bg-success">Confirmé</span>
                        {% elseif r.statut.value == 'ANNULE' %}<span class="badge bg-danger">Annulé</span>
                        {% else %}<span class="badge bg-secondary">Terminé</span>{% endif %}
                    </div>
                    <div class="mb-3">
                        <i class="bi bi-calendar3 text-primary me-2"></i>
                        <span>{{ r.dateDebut|date('d/m/Y') }}</span>
                        <i class="bi bi-clock ms-3 text-primary me-2"></i>
                        <span>{{ r.dateDebut|date('H:i') }}</span>
                    </div>
                    <a href="{{ path('app_user_profile_view', {id: r.medecin.id}) }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-person me-1"></i>Voir le profil du médecin
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    <div class="mt-3">
        <a href="{{ path('app_patient_rendez_vous') }}" class="btn btn-outline-primary btn-sm">Voir tous les rendez-vous</a>
    </div>
    {% endif %}
</div>
<style>
.rdv-card { transition: transform 0.2s, box-shadow 0.2s; }
.rdv-card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,.1) !important; }
.rdv-avatar { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rdv-avatar-medecin { background: rgba(13, 110, 253, 0.15); color: #0d6efd; }
</style>
{% endblock %}
