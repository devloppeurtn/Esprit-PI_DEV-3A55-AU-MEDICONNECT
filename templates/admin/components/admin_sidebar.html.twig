{# Sidebar admin - design professionnel premium #}
<aside class="admin-sidebar" id="admin-sidebar">
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <div class="sidebar-logo-wrap">
                <img src="{{ asset('assets/img/logomed.png') }}" alt="MediConnect" class="sidebar-logo">
            </div>
            <span class="sidebar-title">MediConnect</span>
        </div>
        <div class="sidebar-actions">
            <button type="button" class="sidebar-toggle-btn" id="sidebar-toggle-btn" aria-label="Réduire le menu" title="Réduire le menu">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>
    </div>

    <div class="sidebar-search">
        <div class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" class="form-control search-input" id="sidebar-search" placeholder="Rechercher..." aria-label="Rechercher dans le menu">
        </div>
    </div>

    <div class="sidebar-content">
        <nav class="sidebar-nav">
            <div class="sidebar-section">
                <span class="sidebar-section-title">Principal</span>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}" href="{{ path('app_admin_dashboard') }}" title="Tableau de bord">
                            <span class="nav-icon-wrap"><i class="bi bi-speedometer2"></i></span>
                            <span class="nav-text">Tableau de bord</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'app_notifications' ? 'active' : '' }}" href="{{ path('app_notifications_index') }}" title="Mes notifications">
                            <span class="nav-icon-wrap">
                                <i class="bi bi-bell"></i>
                                {% set unreadCount = app.user ? notification_service.compterNotificationsNonLues(app.user) : 0 %}
                                {% if unreadCount > 0 %}
                                    <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle" style="font-size: 0.65rem;">
                                        {{ unreadCount > 9 ? '9+' : unreadCount }}
                                    </span>
                                {% endif %}
                            </span>
                            <span class="nav-text">Notifications</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_admin_categories_en_attente' ? 'active' : '' }}" href="{{ path('app_admin_categories_en_attente') }}" title="Catégories en attente">
                            <span class="nav-icon-wrap"><i class="bi bi-clock-history"></i></span>
                            <span class="nav-text">Catégories en attente</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'app_savoir_medical' ? 'active' : '' }}" href="{{ path('app_savoir_medical_index') }}" title="Savoir Médical">
                            <span class="nav-icon-wrap"><i class="bi bi-book"></i></span>
                            <span class="nav-text">Savoir Médical</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_admin_users' ? 'active' : '' }}" href="{{ path('app_admin_users') }}" title="Utilisateurs">
                            <span class="nav-icon-wrap"><i class="bi bi-people"></i></span>
                            <span class="nav-text">Utilisateurs</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'admin_products' ? 'active' : '' }}" href="{{ path('admin_products') }}" title="Produits">
                            <span class="nav-icon-wrap"><i class="bi bi-box-seam"></i></span>
                            <span class="nav-text">Produits</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') starts with 'admin_categories' ? 'active' : '' }}" href="{{ path('admin_categories') }}" title="Catégories">
                            <span class="nav-icon-wrap"><i class="bi bi-tags"></i></span>
                            <span class="nav-text">Catégories</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.get('_route') == 'app_admin_delivery_dashboard' ? 'active' : '' }}" href="{{ path('app_admin_delivery_dashboard') }}" title="Livraison SLA">
                            <span class="nav-icon-wrap"><i class="bi bi-truck"></i></span>
                            <span class="nav-text">Livraison SLA</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-section">
                <span class="sidebar-section-title">Compte</span>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link nav-link-external" href="{{ path('app_home') }}" title="Voir le site">
                            <span class="nav-icon-wrap"><i class="bi bi-box-arrow-up-right"></i></span>
                            <span class="nav-text">Voir le site</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <div class="sidebar-footer">
        <div class="sidebar-version">v1.0</div>
        <div class="sidebar-collapsed-hint" title="Cliquez pour agrandir">
            <i class="bi bi-layout-sidebar-inset"></i>
        </div>
    </div>
</aside>

<button type="button" class="sidebar-open-btn" id="sidebar-open-btn" aria-label="Ouvrir le menu" title="Ouvrir le menu">
    <i class="bi bi-list"></i>
</button>

<div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

