    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('admin-sidebar');
            const toggleBtn = document.getElementById('sidebar-toggle-btn');
            const openBtn = document.getElementById('sidebar-open-btn');
            const backdrop = document.getElementById('sidebar-backdrop');
            const navToggle = document.querySelector('[data-admin-sidebar-toggle]');
            const STORAGE_KEY = 'mediconnect_admin_sidebar';

            function getState() {
                try {
                    return localStorage.getItem(STORAGE_KEY) || 'expanded';
                } catch (e) { return 'expanded'; }
            }
            function setState(state) {
                try { localStorage.setItem(STORAGE_KEY, state); } catch (e) {}
            }

            function openSidebar() {
                sidebar.classList.remove('collapsed');
                if (backdrop) backdrop.classList.remove('show');
                setState('expanded');
            }

            // Toggle réduire/agrandir (desktop)
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', function() {
                    sidebar.classList.toggle('collapsed');
                    sidebar.classList.remove('show');
                    if (backdrop) backdrop.classList.remove('show');
                    const isCollapsed = sidebar.classList.contains('collapsed');
                    toggleBtn.setAttribute('aria-label', isCollapsed ? 'Agrandir le menu' : 'Réduire le menu');
                    toggleBtn.setAttribute('title', isCollapsed ? 'Agrandir le menu' : 'Réduire le menu');
                    setState(isCollapsed ? 'collapsed' : 'expanded');
                });
            }

            // Ouvrir sidebar (bouton flottant quand fermé)
            if (openBtn && sidebar) {
                openBtn.addEventListener('click', function() {
                    if (window.innerWidth < 992) {
                        sidebar.classList.add('show');
                        if (backdrop) backdrop.classList.add('show');
                    } else {
                        openSidebar();
                    }
                });
            }

            // Clic sur zone repliée pour agrandir
            const collapsedHint = document.querySelector('.sidebar-collapsed-hint');
            if (collapsedHint && sidebar) {
                collapsedHint.addEventListener('click', function() {
                    sidebar.classList.remove('collapsed');
                    setState('expanded');
                });
            }

            // Navbar hamburger (mobile)
            if (navToggle && sidebar) {
                navToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('show');
                    if (backdrop) backdrop.classList.toggle('show');
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                });
            }

            // Restaurer l'état au chargement
            const saved = getState();
            if (saved === 'collapsed' && window.innerWidth >= 992) {
                sidebar.classList.add('collapsed');
            }
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
