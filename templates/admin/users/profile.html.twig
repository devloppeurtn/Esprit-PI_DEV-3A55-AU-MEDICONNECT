{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const userId = {{ user.id }};
    const loadingDiv = document.getElementById('profileLoading');
    const contentDiv = document.getElementById('profileContent');
    
    // Charger les données du profil via AJAX
    fetch('{{ path('app_admin_user_profile_data', {id: user.id}) }}', {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success && data.user) {
            // Remplir les données dans le template
            // Les données sont déjà présentes dans le template Twig, on cache juste le loader
            loadingDiv.style.display = 'none';
            contentDiv.style.display = 'block';
        } else {
            loadingDiv.innerHTML = `
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    ${data.error || 'Erreur lors du chargement du profil'}
                </div>
                <a href="{{ path('app_admin_users') }}" class="btn btn-primary mt-3">
                    <i class="bi bi-arrow-left me-1"></i>Retour aux utilisateurs
                </a>
            `;
        }
    })
    .catch(error => {
        loadingDiv.innerHTML = `
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Erreur de connexion. Affichage des données en cache...
            </div>
        `;
        // Afficher quand même le contenu si disponible
        setTimeout(() => {
            loadingDiv.style.display = 'none';
            contentDiv.style.display = 'block';
        }, 1000);
    });
});
</script>
{% endblock %}
