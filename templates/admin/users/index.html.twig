        },

        bulkAction(action) {
            if (this.selectedUsers.length === 0) return;
            const act = action === 'activate' ? 'activate' : 'deactivate';
            fetch('{{ path('app_admin_users_bulk_update') }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ ids: this.selectedUsers, action: act })
            }).then(r => r.json()).then(d => { if (d.success) { this.selectedUsers = []; location.reload(); } else alert(d.error); });
        },

        bulkDelete() {
            if (this.selectedUsers.length === 0 || !confirm('Delete ' + this.selectedUsers.length + ' user(s)?')) return;
            Promise.all(this.selectedUsers.map(id => fetch('{{ path('app_admin_users_delete', {id: '__ID__'}) }}'.replace('__ID__', id), { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })))
                .then(() => location.reload());
        },

        updateGrowthChart() {
            const g = this.growthPeriod === '7d' ? this.growth7d : (this.growthPeriod === '90d' ? this.growth90d : this.growth30d);
            if (this.growthChart && g) {
                this.growthChart.data.labels = g.labels;
                this.growthChart.data.datasets[0].data = g.data;
                this.growthChart.update();
            }
        },

        initCharts() {
            const g = this.growth7d;
            const gc = document.getElementById('userGrowthChart');
            if (gc && typeof Chart !== 'undefined' && g && g.labels && g.labels.length > 0) {
                this.growthChart = new Chart(gc, {
                    type: 'bar',
                    data: { labels: g.labels, datasets: [{ label: 'New Users', data: g.data, backgroundColor: 'rgba(99,102,241,0.8)', borderRadius: 4 }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { beginAtZero: true, min: 0 } } }
                });
            } else if (gc && typeof Chart !== 'undefined') {
                const labels = this.growth7d?.labels || ['J1','J2','J3','J4','J5','J6','J7'];
                const data = this.growth7d?.data || [0,0,0,0,0,0,0];
                this.growthChart = new Chart(gc, {
                    type: 'bar',
                    data: { labels, datasets: [{ label: 'New Users', data, backgroundColor: 'rgba(99,102,241,0.8)', borderRadius: 4 }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { beginAtZero: true, min: 0 } } }
                });
            }
            const rc = document.getElementById('roleDistributionChart');
            if (rc && typeof Chart !== 'undefined') {
                const rd = this.roleCounts || {};
                const labels = ['Patients', 'Médecins', 'Secrétaires', 'Admins', 'Participations'];
                const dataArr = [rd.PATIENT||0, rd.MEDECIN||0, rd.SECRETAIRE||0, rd.ADMIN||0, rd.PARTICIPATION||0];
                const total = dataArr.reduce((a,b)=>a+b,0);
                if (total === 0) {
                    dataArr[0] = 1;
                    labels[0] = 'Aucun utilisateur';
                }
                this.roleChart = new Chart(rc, {
                    type: 'doughnut',
                    data: {
                        labels,
                        datasets: [{ data: dataArr, backgroundColor: ['#10b981','#06b6d4','#f59e0b','#ef4444','#64748b'], borderWidth: 0 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '70%', plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 12 } } } }
                });
            }
            const ac = document.getElementById('activeUserChart');
            if (ac && typeof Chart !== 'undefined') {
                const pct = this.stats.activePercentage || 0;
                this.activeChart = new Chart(ac, {
                    type: 'line',
                    data: { labels: [''], datasets: [{ data: [pct, pct, pct, pct, pct, pct, pct], borderColor: '#10b981', borderWidth: 2, fill: false, tension: 0.4 }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { display: false, min: 0, max: 100 } } }
                });
            }
        }
    }));
});
</script>
