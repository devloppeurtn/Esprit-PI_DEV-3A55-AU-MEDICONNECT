        viewUser(user) { window.location.href = '{{ path('app_admin_user_profile', {id: '__ID__'}) }}'.replace('__ID__', user.id); },

        deleteUser(user) {
            if (!confirm('Delete ' + user.nomComplet + '?')) return;
            fetch('{{ path('app_admin_users_delete', {id: '__ID__'}) }}'.replace('__ID__', user.id), { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
