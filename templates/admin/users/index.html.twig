<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('userTable', (initialUsers, initialStats, roleCountsData, growth7d, growth30d, growth90d, departmentStatsData, recentActivitiesData, systemAlertsData, avatarUrlParam) => ({
        users: initialUsers || [],
        filteredUsers: [],
        selectedUsers: [],
        currentPage: 1,
        itemsPerPage: 10,
        searchQuery: '',
        statutFilter: '',
        roleFilter: '',
        sortField: 'nomComplet',
        sortDirection: 'asc',
        stats: initialStats || { total: 0, actifs: 0, newThisMonth: 0, activePercentage: 0 },
        roleCounts: roleCountsData || {},
        departmentStats: departmentStatsData || [],
        recentActivities: recentActivitiesData || [],
        systemAlerts: systemAlertsData || [],
        avatarUrl: avatarUrlParam || '',
        growth7d: growth7d || { labels: [], data: [] },
        growth30d: growth30d || { labels: [], data: [] },
        growth90d: growth90d || { labels: [], data: [] },
        growthPeriod: '7d',
        growthChart: null,
        roleChart: null,
        activeChart: null,

        init() {
            this.filterUsers();
            this.users.forEach(u => u.avatar = this.avatarUrl);
            this.$nextTick(() => {
                setTimeout(() => this.initCharts(), 100);
            });
        },

        filterUsers() {
            this.filteredUsers = this.users.filter(u => {
                const q = (this.searchQuery || '').toLowerCase();
                const match = !q || (u.nomComplet || '').toLowerCase().includes(q) || (u.email || '').toLowerCase().includes(q);
                return match && (!this.statutFilter || u.statut === this.statutFilter) && (!this.roleFilter || u.role === this.roleFilter);
            });
            this.sortUsers();
            this.currentPage = 1;
        },

        sortBy(field) {
            if (this.sortField === field) this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
            else { this.sortField = field; this.sortDirection = 'asc'; }
            this.sortUsers();
        },

        sortUsers() {
            this.filteredUsers.sort((a, b) => {
                let va = a[this.sortField] || '', vb = b[this.sortField] || '';
                if (typeof va === 'string') { va = va.toLowerCase(); vb = (vb || '').toLowerCase(); }
                return this.sortDirection === 'asc' ? (va > vb ? 1 : -1) : (va < vb ? 1 : -1);
            });
        },

        get paginatedUsers() {
            const start = (this.currentPage - 1) * this.itemsPerPage;
            return this.filteredUsers.slice(start, start + this.itemsPerPage);
        },

        get totalPages() { return Math.max(1, Math.ceil(this.filteredUsers.length / this.itemsPerPage)); },

        get visiblePages() {
            const t = this.totalPages;
            if (t <= 5) return Array.from({ length: t }, (_, i) => i + 1);
            const p = this.currentPage;
            let pages = [];
            if (p > 2) pages.push(1, '…'); else pages.push(1);
            for (let i = Math.max(1, p - 1); i <= Math.min(t, p + 1); i++) if (!pages.includes(i)) pages.push(i);
            if (p < t - 1) pages.push('…', t); else if (t > 1) pages.push(t);
            return pages.filter((v, i, a) => a.indexOf(v) === i);
        },

        goToPage(p) { if (p >= 1 && p <= this.totalPages) this.currentPage = p; },

        toggleAll(checked) { this.selectedUsers = checked ? this.paginatedUsers.map(u => u.id) : []; },

        toggleUser(id) {
            if (this.selectedUsers.includes(id)) this.selectedUsers = this.selectedUsers.filter(x => x !== id);
            else this.selectedUsers = [...this.selectedUsers, id];
        },

        editUser(user) {
            document.getElementById('userModalLabel').textContent = 'Edit User';
            document.getElementById('userId').value = user.id;
            document.querySelector('[name="nomComplet"]').value = user.nomComplet;
            document.querySelector('[name="email"]').value = user.email;
            document.querySelector('[name="role"]').value = user.role || 'PATIENT';
            document.querySelector('[name="statut"]').value = user.statut || 'ACTIF';
            document.querySelector('[name="password"]').value = '';
