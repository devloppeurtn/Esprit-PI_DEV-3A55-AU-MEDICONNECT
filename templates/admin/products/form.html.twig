{% extends 'admin/base_admin.html.twig' %}
{% set title = product.id ? 'Editer produit' : 'Nouveau produit' %}
{% block admin_content %}
{% set currentIsUrl = product.image and (product.image starts with('http://') or product.image starts with('https://')) %}
<form method="post" enctype="multipart/form-data" class="card shadow-sm">
    <div class="card-body">
        <p class="text-muted small mb-3"><span class="text-danger">*</span> = obligatoire (mandatory)</p>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Nom</label>
                <input type="text" name="nom" class="form-control" required value="{{ product.nom }}">
            </div>
            <div class="col-md-3">
                <label class="form-label">Prix (TND) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" min="0" name="prix" class="form-control" required value="{{ product.prix }}">
            </div>
            <div class="col-md-3">
                <label class="form-label">Stock <span class="text-danger">*</span></label>
                <input type="number" min="0" name="stock" class="form-control" required value="{{ product.stock }}">
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Cat&eacute;gorie <span class="text-danger">*</span></label>
            <select name="categorie" class="form-select" required>
                <option value="">-- Choisir --</option>
                {% for c in categories %}
                    <option value="{{ c.id }}" {% if product.categorie and product.categorie.id == c.id %}selected{% endif %}>{{ c.nom }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Image (2 choix)</label>

            <div class="form-check">
                <input class="form-check-input" type="radio" name="image_source" id="image_source_url" value="url" {{ currentIsUrl or not product.image ? 'checked' : '' }}>
                <label class="form-check-label" for="image_source_url">URL</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="image_source" id="image_source_upload" value="upload" {{ product.image and not currentIsUrl ? 'checked' : '' }}>
                <label class="form-check-label" for="image_source_upload">Upload depuis le laptop</label>
            </div>

            <div id="image_url_group" class="mb-2">
                <label class="form-label">URL de l'image</label>
                <input type="url" name="image_url" class="form-control"
                       value="{{ currentIsUrl ? product.image : '' }}"
                       placeholder="https://...">
            </div>

            <div id="image_upload_group" class="mb-2">
                <label class="form-label">Fichier image</label>
                <input type="file" name="image_file" class="form-control" accept="image/*">
                {% if product.image and not currentIsUrl %}
                    <small class="text-muted">Image actuelle: {{ product.image }}</small>
                {% endif %}
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" rows="4" class="form-control">{{ product.description }}</textarea>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a href="{{ path('admin_products') }}" class="btn btn-outline-secondary">Annuler</a>
        <button class="btn btn-primary">Enregistrer</button>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const urlRadio = document.getElementById('image_source_url');
    const uploadRadio = document.getElementById('image_source_upload');
    const urlGroup = document.getElementById('image_url_group');
    const uploadGroup = document.getElementById('image_upload_group');

    function toggleImageInputs() {
        const isUrl = urlRadio.checked;
        urlGroup.style.display = isUrl ? 'block' : 'none';
        uploadGroup.style.display = isUrl ? 'none' : 'block';
    }

    urlRadio.addEventListener('change', toggleImageInputs);
    uploadRadio.addEventListener('change', toggleImageInputs);
    toggleImageInputs();
});
</script>
{% endblock %}
