{% extends 'admin/base_admin.html.twig' %}
{% block title %}Produits - Administration{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-box-seam me-2"></i>Produits</h1>
    <a href="{{ path('app_admin_products_new') }}" class="btn btn-primary btn-sm">Nouveau produit</a>
</div>
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label mb-1">Recherche</label>
                <input type="text" name="q" class="form-control form-control-sm" placeholder="Nom ou description..."
                       value="{{ search|default('') }}">
            </div>
            <div class="col-md-4">
                <label class="form-label mb-1">Catégorie</label>
                <select name="categorie" class="form-select form-select-sm">
                    <option value="">Toutes les catégories</option>
                    {% for c in categories %}
                        <option value="{{ c.id }}" {% if activeCategoryId is defined and activeCategoryId is not null and activeCategoryId == c.id %}selected{% endif %}>
                            {{ c.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary btn-sm flex-grow-1" type="submit">
                    <i class="bi bi-search me-1"></i>Filtrer
                </button>
                <a href="{{ path('app_admin_products') }}" class="btn btn-outline-secondary btn-sm">
                    Réinitialiser
                </a>
            </div>
        </form>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>#</th><th>Nom</th><th>Catégorie</th><th>Prix</th><th>Stock</th><th></th>
        </tr>
        </thead>
        <tbody>
        {% for p in products %}
            <tr>
                <td>{{ p.id }}</td>
                <td>{{ p.nom }}</td>
                <td>{{ p.categorie ? p.categorie.nom : '—' }}</td>
                <td>{{ p.prix|number_format(2, ',', ' ') }} TND</td>
                <td>{{ p.stock }}</td>
                <td class="text-end">
                    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_admin_products_edit', {id: p.id}) }}">Éditer</a>
                    <form action="{{ path('app_admin_products_delete', {id: p.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer ce produit ?');">
                        <button class="btn btn-outline-danger btn-sm">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-center text-muted">Aucun produit</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
