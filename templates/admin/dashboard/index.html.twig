{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de bord - Admin MediConnect{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Tableau de bord</h1>
        <p class="text-muted mb-0">Bienvenue, {{ app.user.nomComplet }} — <small class="text-muted"><i class="bi bi-broadcast"></i> Mise à jour instantanée (push temps réel)</small></p>
    </div>
</div>

<div class="row g-3 g-lg-4 mb-4">
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <div class="card admin-stats-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="admin-stats-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-0 text-muted">Total utilisateurs</h6>
                        <h3 class="mb-0" data-stat="totalUsers">{{ totalUsers }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <div class="card admin-stats-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="admin-stats-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-person-check"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-0 text-muted">Patients</h6>
                        <h3 class="mb-0" data-stat="countPatients">{{ countPatients|default(0) }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <div class="card admin-stats-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="admin-stats-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-heart-pulse"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-0 text-muted">Médecins</h6>
                        <h3 class="mb-0" data-stat="countMedecins">{{ countMedecins|default(0) }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <div class="card admin-stats-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="admin-stats-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-person-badge"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-0 text-muted">Secrétaires</h6>
                        <h3 class="mb-0" data-stat="countSecretaires">{{ countSecretaires|default(0) }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <div class="card admin-stats-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="admin-stats-icon bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-0 text-muted">Administrateurs</h6>
                        <h3 class="mb-0" data-stat="countAdmins">{{ countAdmins|default(0) }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <div class="card admin-stats-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="admin-stats-icon bg-secondary bg-opacity-10 text-secondary">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-0 text-muted">Participations</h6>
                        <h3 class="mb-0" data-stat="countParticipations">{{ countParticipations|default(0) }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <div class="card admin-stats-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="admin-stats-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-calendar-plus"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="mb-0 text-muted">Organisateurs</h6>
                        <h3 class="mb-0">{{ countOrganisateurs|default(0) }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4 col-xl-3">
        <a href="{{ path('app_admin_evenements') }}" class="text-decoration-none">
            <div class="card admin-stats-card border-0 shadow-sm border border-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="admin-stats-icon bg-warning bg-opacity-25 text-warning">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="mb-0 text-muted">Événements en attente</h6>
                            <h3 class="mb-0 text-warning">{{ pendingEvenements|default([])|length }}</h3>
                            <small class="text-muted">Cliquer pour valider</small>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="card-title mb-0">Vue d'ensemble des inscriptions</h5>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-primary" data-overview-period="7d">7j</button>
                    <button type="button" class="btn btn-outline-primary" data-overview-period="30d">30j</button>
                    <button type="button" class="btn btn-outline-primary" data-overview-period="90d">90j</button>
                    <button type="button" class="btn btn-outline-primary active" data-overview-period="1y">1 an</button>
                </div>
            </div>
            <div class="card-body">
                <div style="height: 260px;">
                    <canvas id="overviewChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-0">Activité récente</h5>
            </div>
            <div class="card-body">
                <div class="activity-feed">
                    <div class="activity-item d-flex align-items-start gap-3 mb-3">
                        <div class="flex-shrink-0 rounded-circle bg-primary bg-opacity-10 text-primary p-2"><i class="bi bi-person-plus"></i></div>
                        <div>
                            <p class="mb-0 small">Nouveaux utilisateurs</p>
                            <small class="text-muted">Inscriptions en temps réel</small>
                        </div>
                    </div>
                    <div class="activity-item d-flex align-items-start gap-3 mb-3">
                        <div class="flex-shrink-0 rounded-circle bg-success bg-opacity-10 text-success p-2"><i class="bi bi-graph-up"></i></div>
                        <div>
                            <p class="mb-0 small">Statistiques</p>
                            <small class="text-muted">Rafraîchies toutes les 15 s</small>
                        </div>
                    </div>
                    <div class="activity-item d-flex align-items-start gap-3">
                        <div class="flex-shrink-0 rounded-circle bg-info bg-opacity-10 text-info p-2"><i class="bi bi-people"></i></div>
                        <div>
                            <p class="mb-0 small">Gestion utilisateurs</p>
                            <small class="text-muted">Tableau de bord complet</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="card-title mb-0">Croissance utilisateurs</h5>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-primary active" data-chart-period="7d">7 jours</button>
                    <button type="button" class="btn btn-outline-primary" data-chart-period="30d">30 jours</button>
                </div>
            </div>
            <div class="card-body">
                <div style="height: 220px;">
                    <canvas id="userGrowthChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-0">Répartition des utilisateurs</h5>
            </div>
            <div class="card-body">
                <div style="height: 220px;">
                    <canvas id="userDistributionChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-0">Actions rapides</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <a href="{{ path('app_admin_users') }}" class="btn btn-outline-primary w-100 py-3">
                            <i class="bi bi-people me-2"></i>Gérer les utilisateurs
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary w-100 py-3">
                            <i class="bi bi-house me-2"></i>Voir le site
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="card-title mb-0">Informations</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-0">
                    Utilisez le menu latéral pour naviguer dans les différentes sections de l'administration MediConnect.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script type="application/json" id="mercure-dashboard-url">{{ mercure('https://mediconnect.local/admin/dashboard')|json_encode|raw }}</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const STATS_URL = '{{ path('app_admin_stats') }}';
    const CHARTS_BASE_URL = '{{ path('app_admin_charts') }}';
    const REFRESH_INTERVAL = 60000; // Fallback 60s si Mercure déconnecté
    const MERCURE_URL = (() => { try { return JSON.parse(document.getElementById('mercure-dashboard-url')?.textContent || '""'); } catch(e) { return null; } })();

    let userGrowthChart = null;
    let userDistributionChart = null;
    let overviewChart = null;
    let growthPeriod = '7d';
    let overviewPeriod = '1y';

    function updateStats() {
        fetch(STATS_URL, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(data => {
            Object.keys(data).forEach(key => {
                const el = document.querySelector('[data-stat="' + key + '"]');
                if (el && el.textContent !== String(data[key])) {
                    el.textContent = data[key];
                    el.classList.add('stat-updated');
                    setTimeout(() => el.classList.remove('stat-updated'), 500);
                }
            });
        })
        .catch(() => {});
    }

    function updateCharts(data) {
        // Graphique barres - Croissance
        if (userGrowthChart) {
            userGrowthChart.data.labels = data.userGrowth.labels;
            userGrowthChart.data.datasets[0].data = data.userGrowth.data;
            userGrowthChart.update('none');
        } else {
            const growthCtx = document.getElementById('userGrowthChart');
            if (growthCtx) {
                userGrowthChart = new Chart(growthCtx, {
                    type: 'bar',
                    data: {
                        labels: data.userGrowth.labels,
                        datasets: [{
                            label: 'Nouveaux utilisateurs',
                            data: data.userGrowth.data,
                            backgroundColor: 'rgba(23, 92, 221, 0.8)',
                            borderColor: 'rgb(23, 92, 221)',
                            borderWidth: 1,
                            borderRadius: 6,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.08)' } }
                        }
                    }
                });
            }
        }

        // Graphique courbes - Vue d'ensemble
        if (data.overview) {
            if (overviewChart) {
                overviewChart.data.labels = data.overview.labels;
                overviewChart.data.datasets[0].data = data.overview.patients;
                overviewChart.data.datasets[1].data = data.overview.medecins;
                overviewChart.update('none');
            } else {
                const ctx = document.getElementById('overviewChart');
                if (ctx) {
                    overviewChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.overview.labels,
                            datasets: [
                                {
                                    label: 'Patients',
                                    data: data.overview.patients,
                                    borderColor: 'rgb(124, 58, 237)',
                                    backgroundColor: 'rgba(124, 58, 237, 0.1)',
                                    tension: 0.3,
                                    fill: true
                                },
                                {
                                    label: 'Médecins',
                                    data: data.overview.medecins,
                                    borderColor: 'rgb(34, 197, 94)',
                                    backgroundColor: 'rgba(34, 197, 94, 0.1)',
                                    tension: 0.3,
                                    fill: true
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'top', labels: { usePointStyle: true } }
                            },
                            scales: {
                                x: { grid: { display: false } },
                                y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' } }
                            }
                        }
                    });
                }
            }
        }

        // Graphique donut - Répartition
        if (userDistributionChart) {
            userDistributionChart.data.datasets[0].data = data.distribution.data;
            userDistributionChart.update('none');
        } else {
            const distCtx = document.getElementById('userDistributionChart');
            if (distCtx) {
                userDistributionChart = new Chart(distCtx, {
                    type: 'doughnut',
                    data: {
                        labels: data.distribution.labels,
                        datasets: [{
                            data: data.distribution.data,
                            backgroundColor: [
                                'rgba(16, 185, 129, 0.8)',
                                'rgba(6, 182, 212, 0.8)',
                                'rgba(245, 158, 11, 0.8)',
                                'rgba(239, 68, 68, 0.8)',
                                'rgba(100, 116, 139, 0.8)'
                            ],
                            borderWidth: 0,
                            cutout: '60%'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true } }
                        }
                    }
                });
            }
        }
    }

    function fetchAndUpdateCharts() {
        const url = CHARTS_BASE_URL + '?period=' + growthPeriod + '&overviewPeriod=' + overviewPeriod;
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(updateCharts)
        .catch(() => {});
    }

    document.querySelectorAll('[data-chart-period]').forEach(btn => {
        btn.addEventListener('click', function() {
            growthPeriod = this.dataset.chartPeriod;
            document.querySelectorAll('[data-chart-period]').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            fetchAndUpdateCharts();
        });
    });

    document.querySelectorAll('[data-overview-period]').forEach(btn => {
        btn.addEventListener('click', function() {
            overviewPeriod = this.dataset.overviewPeriod;
            document.querySelectorAll('[data-overview-period]').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            fetchAndUpdateCharts();
        });
    });

    function refreshAll() {
        updateStats();
        fetchAndUpdateCharts();
    }

    // Abonnement Mercure : mise à jour instantanée dès qu'un utilisateur change
    let mercureEventSource = null;
    if (MERCURE_URL) {
        try {
            mercureEventSource = new EventSource(MERCURE_URL);
            mercureEventSource.onmessage = function(event) {
                try {
                    const data = JSON.parse(event.data);
                    if (data && data.refresh) {
                        refreshAll();
                    }
                } catch (e) {}
            };
            mercureEventSource.onerror = function() {
                // Reconnexion automatique gérée par EventSource
            };
        } catch (e) {}
    }

    refreshAll();
    setInterval(refreshAll, REFRESH_INTERVAL);
});
</script>
{% endblock %}
