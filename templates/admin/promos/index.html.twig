{% extends 'admin/base_admin.html.twig' %}
{% set title = 'Codes promo' %}
{% block admin_content %}
<div class="d-flex justify-content-end mb-3">
    <a href="{{ path('admin_promos_new') }}" class="btn btn-primary btn-sm">Nouveau code</a>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>#</th><th>Code</th><th>Réduction</th><th>Dates</th><th>Actif</th><th></th></tr></thead>
        <tbody>
        {% for p in promos %}
            <tr>
                <td>{{ p.id }}</td>
                <td>{{ p.code }}</td>
                <td>{{ p.rate }}%</td>
                <td>
                    {% if p.startAt %}{{ p.startAt|date('d/m/Y') }}{% endif %}
                    {% if p.endAt %}→ {{ p.endAt|date('d/m/Y') }}{% endif %}
                </td>
                <td>{{ p.active ? 'Oui' : 'Non' }}</td>
                <td class="text-end">
                    <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_promos_edit', {id:p.id}) }}">Éditer</a>
                    <form action="{{ path('admin_promos_delete', {id:p.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer ce code promo ?');">
                        <button class="btn btn-outline-danger btn-sm">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-center text-muted">Aucun code promo</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
