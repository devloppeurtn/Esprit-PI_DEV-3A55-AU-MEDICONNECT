{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ promo.id ? 'Éditer code promo' : 'Nouveau code promo' }} - Administration{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">{{ promo.id ? 'Éditer le code promo' : 'Nouveau code promo' }}</h1>
    <a href="{{ path('app_admin_promos') }}" class="btn btn-outline-secondary">Retour</a>
</div>
<form method="post" class="card shadow-sm">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Code</label>
                <input type="text" name="code" class="form-control" required value="{{ promo.code }}">
            </div>
            <div class="col-md-4">
                <label class="form-label">Réduction (%)</label>
                <input type="number" step="0.01" min="0" max="100" name="rate" class="form-control" required value="{{ promo.rate }}">
            </div>
            <div class="col-md-4 form-check mt-4">
                <input class="form-check-input" type="checkbox" value="1" id="active" name="active" {% if promo.active %}checked{% endif %}>
                <label class="form-check-label" for="active">Actif</label>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Début (optionnel)</label>
                <input type="date" name="startAt" class="form-control" value="{{ promo.startAt ? promo.startAt|date('Y-m-d') : '' }}">
            </div>
            <div class="col-md-6">
                <label class="form-label">Fin (optionnel)</label>
                <input type="date" name="endAt" class="form-control" value="{{ promo.endAt ? promo.endAt|date('Y-m-d') : '' }}">
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Limite d'utilisation (optionnel)</label>
            <input type="number" min="1" name="usageLimit" class="form-control" value="{{ promo.usageLimit|default('') }}">
            <small class="text-muted">Laissez vide pour illimité.</small>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a href="{{ path('app_admin_promos') }}" class="btn btn-outline-secondary">Annuler</a>
        <button class="btn btn-primary">Enregistrer</button>
    </div>
</form>
{% endblock %}
