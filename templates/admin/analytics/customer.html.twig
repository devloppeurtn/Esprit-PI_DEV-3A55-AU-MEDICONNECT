{% extends 'admin/base_admin.html.twig' %}

{% block title %}Analytics Clients - Admin MediConnect{% endblock %}

{% block admin_content %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Order History & Customer Analytics</h1>
        <p class="text-muted mb-0">Suivi des achats, frÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©quence, catÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©gories prÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©fÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©rÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©es et valeur moyenne.</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-8">
                <label for="customer" class="form-label">Choisir un client</label>
                <select id="customer" name="customer" class="form-select" required>
                    {% for c in customers %}
                        <option value="{{ c.id }}" {{ selectedCustomerId == c.id ? 'selected' : '' }}>
                            {{ c.nomComplet ?: c.email }} ({{ c.email }})
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-lg-4">
                <button type="submit" class="btn btn-primary w-100">Afficher analytics</button>
            </div>
        </form>
    </div>
</div>

{% if selectedCustomer and analytics %}
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Montant total dÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©pensÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©</div>
                    <div class="h4 mb-0">{{ analytics.totalSpent|default(0)|number_format(2, ',', ' ') }} TND</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Nombre de commandes</div>
                    <div class="h4 mb-0">{{ analytics.orderCount|default(0) }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Valeur moyenne commande</div>
                    <div class="h4 mb-0">{{ analytics.averageOrderValue|default(0)|number_format(2, ',', ' ') }} TND</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Client rÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©current</div>
                    <div class="h4 mb-0">
                        {% if analytics.isRepeatCustomer %}
                            <span class="badge bg-success">Oui</span>
                        {% else %}
                            <span class="badge bg-secondary">Non</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if ordersChart %}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom">
            <h5 class="card-title mb-0">Evolution des depenses</h5>
        </div>
        <div class="card-body">
            <div style="height: 280px;">
                {{ render_chart(ordersChart) }}
            </div>
        </div>
    </div>
    {% endif %}

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">FrÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©quence des commandes</div>
                    {% if analytics.orderFrequency is same as(-1) %}
                        <div class="h5 mb-0">N/A (moins de 2 commandes)</div>
                    {% else %}
                        <div class="h5 mb-0">Tous les {{ analytics.orderFrequency }} jours</div>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Segment client</div>
                    <div class="h5 mb-0">{{ analytics.customerSegment|default('Regular') }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Tendance dÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©penses</div>
                    <div class="h5 mb-0">{{ analytics.spendingTrend|default('stable') }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom">
                    <h5 class="card-title mb-0">CatÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©gories prÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©fÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©rÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©es</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                            <tr>
                                <th>CatÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©gorie</th>
                                <th>Achats</th>
                                <th>QtÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© totale</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for item in analytics.preferredCategories|default([]) %}
                                <tr>
                                    <td>{{ item.categoryName }}</td>
                                    <td>{{ item.purchaseCount }}</td>
                                    <td>{{ item.totalQuantity }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="3" class="text-muted text-center">Aucune donnÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©e</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom">
                    <h5 class="card-title mb-0">Produits les plus achetÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©s</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                            <tr>
                                <th>Produit</th>
                                <th>QtÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© totale</th>
                                <th>Nb commandes</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for item in analytics.mostPurchasedProducts|default([]) %}
                                <tr>
                                    <td>{{ item.nom }}</td>
                                    <td>{{ item.totalQuantity }}</td>
                                    <td>{{ item.orderCount }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="3" class="text-muted text-center">Aucune donnÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©e</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <h5 class="card-title mb-0">Montant dÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©pensÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© dans le temps</h5>
        </div>
        <div class="card-body">
            {% if ordersChart %}
                <div style="height: 280px;">
                    {{ render_chart(ordersChart) }}
                </div>
            {% else %}
                <div class="text-muted">Aucune donnÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©e pour afficher le graphique.</div>
            {% endif %}
        </div>
        <div class="card-body p-0 border-top">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Mois</th>
                        <th>Nb commandes</th>
                        <th>Revenu mensuel</th>
                        <th>Valeur moyenne</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in analytics.ordersOverTime|default([]) %}
                        <tr>
                            <td>{{ row.month }}</td>
                            <td>{{ row.orderCount }}</td>
                            <td>{{ row.monthlyRevenue|default(0)|number_format(2, ',', ' ') }} TND</td>
                            <td>{{ row.avgOrderValue|default(0)|number_format(2, ',', ' ') }} TND</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-muted text-center">Aucune donnÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©e</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
